#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "World" (
    kind = "Assembly"
)
{
    def Camera "RenderCam"
    {
        uniform token[] xformOpOrder = ["xformOp:lookAt"]
