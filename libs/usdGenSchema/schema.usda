#usda 1.0
#
# usdGen codeless schema domain — M1 (plan/02-schema.md §1–§2, §7.1).
#
# Source of truth. Regenerate the checked-in plugin resources after any edit:
#   bin/gen_schema.sh
# and review the diff (02-schema.md §7.1).
#
# M1 declares the FULL v1–v3 prim-type namespace so C1 freezes the whole
# vocabulary once (02 §1, §8.1): a declared-but-unimplemented type publishes
# nothing and raises one TF_WARN per prim at runtime (§8.2). Property names,
# types, defaults, allowedTokens and uniformity are normative from
# 02-schema.md §2 (ADR §9 R7); contract C1 is docs/freezes/C1.md.
#
# Default notes (recorded in C1.md §7 "adopted defaults"): where §2.8
# (Deformers) or the v2/v3 rows name a property without a default, the value
# authored here is adopted and recorded; it is not a registry default.
(
    subLayers = [
        @usd/schema.usda@,
        @usdGeom/schema.usda@
    ]
)

over "GLOBAL" (
    customData = {
        string libraryName = "usdGenSchema"
        string libraryPath = "usdGenSchema"
        string libraryPrefix = "UsdGen"
        bool skipCodeGeneration = true
    }
)
{
}

# ---------------------------------------------------------------------------
# Containers (02-schema.md §2.2, §2.3, §2.4)
# ---------------------------------------------------------------------------

# UsdGenGroom — session root; artist-facing globals only (02 §2.2). One per
# character/asset; the registry keys a session by (stage | usdGen:sessionId,
# groom root) (S15, ADR §4.5). No machine tuning here (02 §0.9).
class UsdGenGroom "UsdGenGroom" (
    inherits = </Imageable>
    customData = {
        string className = "Groom"
    }
)
{
    custom uniform token usdGen:execution:backend = "cuda" (
        doc = """Execution backend for every description under this groom. "cuda" is the only accepted token; an absent or unreadable opinion fails closed rather than silently selecting the CPU reference engine. Expression evaluation: groom (once per operator)."""
        allowedTokens = ["cuda"]
    )
    uniform string usdGen:sessionId = "" (
        doc = """Optional session-registry key. A non-empty id lets several renderers share one cooked session for this groom; empty keeps the session stage-local. Expression evaluation: groom (once per operator)."""
    )
}

# UsdGenDescription — one operator chain, one bound surface set, one material,
# one published Hydra prim set (02 §2.3). Derives from UsdGeomBoundable so a
# compute-extent function can be registered (02 §1, §7.2).
class UsdGenDescription "UsdGenDescription" (
    inherits = </Boundable>
    customData = {
        string className = "Description"
        bool implementsComputeExtent = true
    }
)
{
    rel usdGen:surface (
        doc = """The Mesh or GeomSubset this description grows from (ADR R15). Every operator in the chain uses this one target set; there is no per-operator override. Only the first target is bound. Expression evaluation: groom (once per operator)."""
    )
    rel usdGen:guides (
        doc = """Guide sets available to this description. Reserved for guide-driven generators; the M1 kernels do not consume it. Expression evaluation: groom (once per operator)."""
    )
    uniform int usdGen:tileTarget = 64 (
        doc = """Target number of chunks per published tile. Clamped to [32, 256]; an edit re-allocates the tile set without recompiling the graph. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    uniform token usdGen:curve:basis = "bspline" (
        doc = """Basis token copied onto every published BasisCurves prim: "bspline" or "catmullRom". Publication only; no kernel evaluates the basis. Expression evaluation: groom (once per operator)."""
        allowedTokens = ["bspline", "catmullRom"]
    )
    float usdGen:width:default = 0.01 (
        doc = """Fallback strand width in scene units used wherever no upstream width plane exists. Must be finite and >= 0. One value per description. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    rel usdGen:preview:source (
        doc = """Viewport-only value preview: the strands are coloured by what this targets instead of the look, and bind a flat preview material. A target may be a UsdGenExpression prim, a UsdGenPtexMap prim, or an operator attribute such as </Groom/Fur/Ops/clump.usdGen:clump:amount> (the values that operator was evaluated with, or its authored value when nothing is connected). Only the first target is used; no target shows the look. The SeExpr editor authors this in the session layer. CPU lane only. Expression evaluation: groom (once per operator)."""
    )
    uniform token usdGen:preview:colorMap = "heat" (
        doc = """How a previewed value becomes a colour: "heat" (black through purple and orange to pale yellow), "viridis", "gray", "ids" (one distinct colour per distinct value; the range is ignored) or "rgb" (the first three components, each through the range). A vector previewed through a one-dimensional map uses its length. Expression evaluation: groom (once per operator)."""
        allowedTokens = ["heat", "viridis", "gray", "ids", "rgb"]
    )
    uniform float2 usdGen:preview:range = (0, 1) (
        doc = """The previewed values that map to the two ends of the colour map; values outside are clamped. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    uniform token usdGen:preview:evaluation = "primitive" (
        doc = """Where a previewed UsdGenExpression prim is evaluated over the published strands: once per strand ("primitive"), once per CV ("point") or once for the whole groom ("groom"). An operator attribute keeps the domain of its own binding, and a map is read once per strand root. Expression evaluation: groom (once per operator)."""
        allowedTokens = ["groom", "primitive", "point"]
    )
    uniform token usdGen:preview:shading = "lit" (
        doc = """"lit" darkens strands that turn away from the camera so the groom keeps its shape; "flat" shows the mapped colour exactly, for reading values off the screen. Expression evaluation: groom (once per operator)."""
        allowedTokens = ["lit", "flat"]
    )
}

# UsdGenGuideSet — a named guide set; namespace children are BasisCurves under
# contract C3 (02 §2.4).
class UsdGenGuideSet "UsdGenGuideSet" (
    inherits = </Imageable>
    customData = {
        string className = "GuideSet"
    }
)
{
}

# ---------------------------------------------------------------------------
# Operator base and abstract groups (02-schema.md §1, §2.5)
# ---------------------------------------------------------------------------

# UsdGenOperator (abstract) — every chain node. Operators are ordered by the
# composed hierarchy under a Description's Ops scope (reverse sibling
# post-order, bottom sibling first); there is no authored input edge.
# Generators declare no mask: they have no upstream curves to leave
# untouched.  UsdGenStyler and UsdGenDeformer declare usdGen:mask.
class "UsdGenOperator" (
    inherits = </Typed>
    customData = {
        string className = "Operator"
    }
)
{
    bool usdGen:enabled = true (
        doc = """Mute for this operator. A disabled styler or deformer passes its upstream through unchanged; a disabled generator (Scatter, Grow, CurveSource) produces an empty curve set, so the description publishes no curves. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    uniform int usdGen:seed = 0 (
        doc = """Randomisation seed for this operator. Every per-curve draw is keyed by (seed, curveId, salt), so the same seed reproduces the same groom exactly. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
}

# UsdGenGenerator (abstract) — may change the curve or CV count.
class "UsdGenGenerator" (
    inherits = </UsdGenOperator>
    customData = {
        string className = "Generator"
    }
)
{
}

# UsdGenStyler (abstract) — topology-preserving, except UsdGenResample and
# UsdGenLength (02 §1, §2.5).
class "UsdGenStyler" (
    inherits = </UsdGenOperator>
    customData = {
        string className = "Styler"
    }
)
{
    float usdGen:mask = 1.0 (
        doc = """Per-operator effect weight in [0, 1]. 1 applies the operator fully, 0 leaves the upstream curves bit-for-bit untouched. Author a literal for a uniform weight, or connect this attribute to a UsdGenExpression (to the prim, or to its outputs:result) to drive it per curve. Expression evaluation: primitive (once per curve root); override the attribute's customData usdGen:evaluation to "point" for a per-CV weight (use $t for the root-to-tip parameter)."""
        customData = { dictionary usdGen = { string evaluation = "primitive" } }
    )
}

# UsdGenDeformer (abstract) — operators that follow the posed surface
# (02 §2.8).
class "UsdGenDeformer" (
    inherits = </UsdGenOperator>
    customData = {
        string className = "Deformer"
    }
)
{
    float usdGen:mask = 1.0 (
        doc = """Per-operator effect weight in [0, 1]. 1 applies the operator fully, 0 leaves the upstream curves bit-for-bit untouched. Author a literal for a uniform weight, or connect this attribute to a UsdGenExpression (to the prim, or to its outputs:result) to drive it per curve. Expression evaluation: primitive (once per curve root); override the attribute's customData usdGen:evaluation to "point" for a per-CV weight (use $t for the root-to-tip parameter)."""
        customData = { dictionary usdGen = { string evaluation = "primitive" } }
    )
}

# UsdGenExpression — codeless execution-time SeExpr parameter provider.
# The output type is authored per expression as a typed custom outputs:result
# property (see examples); no schema-level float assumption is imposed.
class UsdGenExpression "UsdGenExpression" (
    inherits = </Typed>
    customData = {
        string className = "Expression"
    }
)
{
    custom string usdGen:expr:source = "" (
        doc = """SeExpr program text evaluated at execution time. Its typed outputs:* attributes are the connection targets; the sandbox rejects assignments, string literals and unknown variables. Expression evaluation: groom (once per operator)."""
    )
}

# ---------------------------------------------------------------------------
# Generators (02-schema.md §2.6)
# ---------------------------------------------------------------------------

# UsdGenScatter — roots on the rest surface, stable ids (ADR §9 R12).
class UsdGenScatter "UsdGenScatter" (
    inherits = </UsdGenGenerator>
    customData = {
        string className = "Scatter"
    }
)
{
    float usdGen:density = 100.0 (
        doc = """Expected roots per unit of rest-surface area. Must be finite and >= 0; the per-face count is density * restArea * mask, rounded stochastically. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    bool usdGen:flip = false (
        doc = """Negates the tangent and binormal of every root frame, mirroring the handedness the downstream operators grow and twist along. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
}

# UsdGenGrow — roots to straight strands; sets the CV count.
class UsdGenGrow "UsdGenGrow" (
    inherits = </UsdGenGenerator>
    customData = {
        string className = "Grow"
    }
)
{
    int usdGen:segments = 8 (
        doc = """CVs per generated strand, in [2, 64]. This is the operator that fixes the CV topology of the chain. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    float usdGen:length = 1.0 (
        doc = """Base strand length in scene units. Must be finite and >= 0; the per-curve target is length * lengthRandom draw. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    float2 usdGen:lengthRandom = (1, 1) (
        doc = """Per-curve multiplier range (lo, hi) applied to usdGen:length. A reversed pair is swapped; both components must be finite and >= 0. Expression evaluation: primitive (once per curve root)."""
        customData = { dictionary usdGen = { string evaluation = "primitive" } }
    )
    uniform token usdGen:direction = "surfaceNormal" (
        doc = """Growth direction mode: "surfaceNormal" uses the root frame normal, "vector" uses usdGen:directionVector verbatim. Expression evaluation: groom (once per operator)."""
        allowedTokens = ["surfaceNormal", "vector"]
    )
    vector3f usdGen:directionVector = (0, 1, 0) (
        doc = """Explicit growth direction in description space, used when usdGen:direction is "vector". Normalised before use; every component must be finite. Expression evaluation: primitive (once per curve root)."""
        customData = { dictionary usdGen = { string evaluation = "primitive" } }
    )
    float usdGen:lift = 0.0 (
        doc = """Rotation of the growth direction around the root binormal, in degrees, in [-90, 90]. Expression evaluation: primitive (once per curve root)."""
        customData = { dictionary usdGen = { string evaluation = "primitive" } }
    )
}

# UsdGenGuideInterpolate — strands shaped by a sparse guide curve set;
# emits guideIndex/guideWeight (uniform, elementSize 3, no usdGen: prefix; C2).
# CPU reference lane only.
class UsdGenGuideInterpolate "UsdGenGuideInterpolate" (
    inherits = </UsdGenGenerator>
    customData = {
        string className = "GuideInterpolate"
    }
)
{
    rel usdGen:guides (
        doc = """The guide curves: one BasisCurves prim whose curves are the sparse guides. Each input root grows a strand of usdGen:cvCount CVs by blending the root-local shapes of its nearest guides."""
    )
    int usdGen:cvCount = 8 (
        doc = """CVs per generated strand, in [2, 64]. Guides are resampled to this count by arc length. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    int usdGen:maxGuides = 3 (
        doc = """Most guides blended into one strand, in [1, 8]. The heaviest three are published per strand as guideIndex/guideWeight. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    float usdGen:influenceRadius = 4.0 (
        doc = """Search radius around a strand root, in rest scene units; a guide root farther away does not contribute. A strand with no guide in reach follows the nearest guide of its region. Must be finite and > 0. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    float usdGen:influenceDecay = 2.0 (
        doc = """Falloff exponent: a guide at distance d weighs (1 - d / influenceRadius)^influenceDecay before normalisation. 0 weighs every guide in reach equally. Must be finite and >= 0. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    float usdGen:maxGuideAngle = 90.0 (
        doc = """Largest angle, in degrees, between a strand's root normal and a guide's root normal for the guide to contribute, in [0, 180]. Keeps guides on one side of a thin surface off the other. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    uniform token usdGen:blendMethod = "linearBlend" (
        doc = """How guide shapes blend: "linearBlend" averages the guides' root-local CV offsets; "extrudeAndBlend" averages their segment directions and lengths and extrudes the strand from its root, which keeps the length when guides diverge. Expression evaluation: groom (once per operator)."""
        allowedTokens = ["linearBlend", "extrudeAndBlend"]
    )
    float usdGen:blendInSkinSpace = 1.0 (
        doc = """1 turns each guide's shape by the rotation that takes the guide's root normal onto the strand's before blending, so strands follow a curved surface; 0 copies the shapes unrotated; values between rotate partially. In [0, 1]. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    bool usdGen:useUniqueGuide = false (
        doc = """Each strand copies its single heaviest guide instead of blending several. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    float usdGen:randomizeGuide = 0.0 (
        doc = """Per strand, per guide random reduction of the guide weights, in [0, 1]; breaks up the blend and, with useUniqueGuide, varies which guide a strand copies. Keyed by (usdGen:seed, curve id, guide). Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    float usdGen:region = 0.0 (
        doc = """Region id per strand. A guide only shapes strands of its own region, and a guide's region is the value at its root (read from the strand rooted nearest it). Connect a UsdGenExpression to part the groom: a ptex("<map>") region map, or a voronoi over the guide roots such as geoSampler("guideCurves", "$index"). Values that differ by less than 1/1024 are the same region. Unconnected, every strand is in one region. Expression evaluation: primitive (once per curve root)."""
        customData = { dictionary usdGen = { string evaluation = "primitive" } }
    )
    float usdGen:regionCrossover = 0.0 (
        doc = """Weight scale for guides of another region, in [0, 1]. 0 keeps region borders hard (parting lines); larger values let neighbouring regions' guides soften the border. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
}

# UsdGenCurveSource — frozen, imported and simulated curves (02 §2.6, C3).
class UsdGenCurveSource "UsdGenCurveSource" (
    inherits = </UsdGenGenerator>
    customData = {
        string className = "CurveSource"
    }
)
{
    rel usdGen:curves (
        doc = """The authored BasisCurves prim this source reads (contract C3). Exactly one target is required; it is the only way curve data enters the engine. Expression evaluation: groom (once per operator)."""
    )
    bool usdGen:useRest = true (
        doc = """True reads the source as rest-space geometry and requires an authored rest snapshot; false accepts already-posed points. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    uniform token usdGen:idSource = "primvar" (
        doc = """Where stable curve ids come from: "primvar" uses the authored curveId primvar, "index" synthesizes them from the source ordering. Expression evaluation: groom (once per operator)."""
        allowedTokens = ["primvar", "index"]
    )
    uniform string usdGen:expectEpoch = "" (
        doc = """Expected frozen-curve epoch string. Empty disables the check; otherwise a mismatch is reported through usdGen:staleAction. Expression evaluation: groom (once per operator)."""
    )
    uniform token usdGen:staleAction = "warn" (
        doc = """What to do when the source epoch does not match usdGen:expectEpoch: "warn", "ignore", or "block" (a hard error). Expression evaluation: groom (once per operator)."""
        allowedTokens = ["warn", "ignore", "block"]
    )
    uniform int usdGen:resampleTo = 0 (
        doc = """Resample every source curve to this CV count. 0 keeps the authored topology; any other value must be >= 2. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    uniform token usdGen:rebind = "onError" (
        doc = """When to re-derive root bindings and frames from the bound surface: "never", "onError", or "always". Expression evaluation: groom (once per operator)."""
        allowedTokens = ["never", "onError", "always"]
    )
}

# ---------------------------------------------------------------------------
# Stylers, v1 (02-schema.md §2.7.1 — normative)
# ---------------------------------------------------------------------------

# UsdGenClump — pulls strands toward clump centre strands; emits
# clumpId_<level> (uniform int, no usdGen: prefix; C2). CPU reference lane
# only.
class UsdGenClump "UsdGenClump" (
    inherits = </UsdGenStyler>
    customData = {
        string className = "Clump"
    }
)
{
    float usdGen:clump:amount = 0.5 (
        doc = """Pull strength toward the clump centre strand, in [0, 1], scaled per CV by the profile ramp. Expression evaluation: primitive (once per curve root); override the attribute's customData usdGen:evaluation to "point" to vary it along the strand."""
        customData = { dictionary usdGen = { string evaluation = "primitive" } }
    )
    float2[] usdGen:clump:profile:knots = [(0, 0), (1, 1)] (
        doc = """(position, value) ramp knots with position in [0, 1] along the strand, multiplying usdGen:clump:amount: the default leaves roots free and pulls tips fully. Empty knots mean a flat 1. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    uniform token usdGen:clump:profile:interpolation = "catmullRom" (
        doc = """Interpolation of usdGen:clump:profile:knots. Expression evaluation: groom (once per operator)."""
        allowedTokens = ["linear", "catmullRom", "bspline", "constant"]
    )
    float usdGen:clump:map = 0.0 (
        doc = """Clump membership. Connect a UsdGenExpression to cluster strands by a map: strands whose values are equal (within 1/1024) form one clump, centred on the member rooted nearest the group's centroid. A ptex("<map>") read of a UsdGenPtexMap region map makes the map's cells the clumps; a geoSampler voronoi makes the sampled points the clump seeds. Unconnected, clump centres are scattered at usdGen:clump:density. Expression evaluation: primitive (once per curve root)."""
        customData = { dictionary usdGen = { string evaluation = "primitive" } }
    )
    float usdGen:clump:density = 4.0 (
        doc = """Clump centres per unit of rest-surface area when usdGen:clump:map is unconnected (and for every level after the first). Centres are picked among the strands with a minimum spacing, keyed by usdGen:seed. Must be finite and >= 0; at least one centre is always picked. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    float usdGen:clump:size = 1.0 (
        doc = """Reach of a clump in rest scene units: a strand rooted farther than this from its centre is not clumped. Must be finite and > 0. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    uniform int usdGen:clump:level = -1 (
        doc = """Index of the first clumpId_<n> plane this operator publishes. -1 numbers it by its position among the description's Clump operators. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    int usdGen:clump:levels = 1 (
        doc = """Clumping levels, in [1, 4]. Every level after the first splits each clump of the previous level into smaller clumps of density / sizeReduction^(2L), reach size * sizeReduction^L and strength amount * tightnessReduction^L, centred on strands as the previous level left them. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    float usdGen:clump:sizeReduction = 0.5 (
        doc = """Per-level scale of the clump size, in (0, 1]. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    float usdGen:clump:tightnessReduction = 0.8 (
        doc = """Per-level scale of the pull strength, in [0, 1]. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    uniform token usdGen:clump:method = "linearBlend" (
        doc = """Pull target: "linearBlend" pulls each CV toward the centre strand's CV at the same parameter, so tips converge; "extrudeAndBlend" pulls toward the centre strand's shape moved to the strand's own root, so strands align without converging. Expression evaluation: groom (once per operator)."""
        allowedTokens = ["linearBlend", "extrudeAndBlend"]
    )
    float usdGen:clump:stray:amount = 0.0 (
        doc = """Pull removed from a stray strand, in [0, 1], growing toward the tip as t^falloff. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    float usdGen:clump:stray:rate = 0.0 (
        doc = """Share of strands that stray, in [0, 1], picked by (usdGen:seed, curve id). Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    float usdGen:clump:stray:falloff = 1.0 (
        doc = """Exponent of the stray profile along the strand; must be finite and >= 0. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    float usdGen:preserveLength = 1.0 (
        doc = """1 restores every segment to its input length after the pull, root locked; 0 keeps the pulled lengths; values between blend. In [0, 1]. Expression evaluation: primitive (once per curve root)."""
        customData = { dictionary usdGen = { string evaluation = "primitive" } }
    )
}

# UsdGenNoise — frizz; correlated fBm in the root frame.
class UsdGenNoise "UsdGenNoise" (
    inherits = </UsdGenStyler>
    customData = {
        string className = "Noise"
    }
)
{
    float usdGen:noise:magnitude = 0.05 (
        doc = """Peak displacement of the frizz field in scene units, before the magnitude ramp and the mask envelope. Expression evaluation: point (once per CV)."""
        customData = { dictionary usdGen = { string evaluation = "point" } }
    )
    float2[] usdGen:noise:magnitude:knots = [(0, 0), (1, 1)] (
        doc = """Root-to-tip ramp on the displacement magnitude as (position, value) pairs with position in [0, 1]. Empty is a flat ramp of 1. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    uniform token usdGen:noise:magnitude:interpolation = "catmullRom" (
        doc = """Interpolation of usdGen:noise:magnitude:knots: "linear", "catmullRom", "bspline" or "constant". Expression evaluation: groom (once per operator)."""
        allowedTokens = ["linear", "catmullRom", "bspline", "constant"]
    )
    float usdGen:noise:frequency = 3.0 (
        doc = """Spatial frequency of the fBm field, in cycles per scene unit. Expression evaluation: point (once per CV)."""
        customData = { dictionary usdGen = { string evaluation = "point" } }
    )
    float usdGen:noise:correlation = 0.5 (
        doc = """How strongly neighbouring strands share one noise draw, clamped to [0, 1]. 0 is fully independent per curve. Expression evaluation: point (once per CV)."""
        customData = { dictionary usdGen = { string evaluation = "point" } }
    )
    int usdGen:noise:octaves = 1 (
        doc = """Number of fBm octaves, in [1, 6]. Expression evaluation: point (once per CV)."""
        customData = { dictionary usdGen = { string evaluation = "point" } }
    )
    float usdGen:noise:lacunarity = 2.0 (
        doc = """Frequency multiplier between successive fBm octaves; must be > 1. Expression evaluation: point (once per CV)."""
        customData = { dictionary usdGen = { string evaluation = "point" } }
    )
    float usdGen:noise:gain = 0.5 (
        doc = """Amplitude multiplier between successive fBm octaves, in [0, 1]. Expression evaluation: point (once per CV)."""
        customData = { dictionary usdGen = { string evaluation = "point" } }
    )
    bool usdGen:cumulative = false (
        doc = """True accumulates the displacement along the strand so the tip carries the sum; false displaces every CV independently. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    float usdGen:preserveLength = 1.0 (
        doc = """Arc-length restoration after displacement, in [0, 1]. Values at or above 0.999 restore every segment length exactly; lower values leave the strand stretched. Expression evaluation: primitive (once per curve root)."""
        customData = { dictionary usdGen = { string evaluation = "primitive" } }
    )
}

# UsdGenLength — the whole type is topology-bumping (static
# TopologyEffect() == MayChangeCurveCount; cull mode, 02 §0.4).
class UsdGenLength "UsdGenLength" (
    inherits = </UsdGenStyler>
    customData = {
        string className = "Length"
    }
)
{
    uniform token usdGen:length:mode = "scale" (
        doc = """How usdGen:length:value is interpreted: "set" is an absolute target length, "scale" a multiplier, "cull" removes strands below the threshold. Expression evaluation: groom (once per operator)."""
        allowedTokens = ["set", "scale", "cull"]
    )
    float usdGen:length:value = 1.0 (
        doc = """Target length in scene units ("set") or multiplier ("scale"). Must be >= 0. Expression evaluation: primitive (once per curve root)."""
        customData = { dictionary usdGen = { string evaluation = "primitive" } }
    )
    float2 usdGen:length:random = (1, 1) (
        doc = """Per-curve multiplier range (lo, hi) on the resolved length. A reversed pair is swapped; both components must be finite and >= 0. Expression evaluation: primitive (once per curve root)."""
        customData = { dictionary usdGen = { string evaluation = "primitive" } }
    )
    uniform token usdGen:length:method = "scale" (
        doc = """How CVs are redistributed: "scale" scales every segment, "cutExtend" keeps segment lengths and cuts or extends the tip. Expression evaluation: groom (once per operator)."""
        allowedTokens = ["scale", "cutExtend"]
    )
    uniform token usdGen:rebuild = "keepParam" (
        doc = """CV parameterisation after the length change: "keepParam" retains the authored parameter positions, "reparam" redistributes them evenly. Expression evaluation: groom (once per operator)."""
        allowedTokens = ["keepParam", "reparam"]
    )
    float usdGen:minRemainingLength = 0.0 (
        doc = """Strands shorter than this after the length change are zero-lengthened rather than left as slivers. Scene units, >= 0. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    float usdGen:cullThreshold = 0.0 (
        doc = """Strands whose resolved length is below this value are zero-lengthened. Scene units, >= 0. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
}

# UsdGenWidth — strand profile; usdGen:replace == true sets, false multiplies.
class UsdGenWidth "UsdGenWidth" (
    inherits = </UsdGenStyler>
    customData = {
        string className = "Width"
    }
)
{
    float usdGen:width = 0.01 (
        doc = """Base strand width in scene units before the ramp and the mask envelope. Must be >= 0. Expression evaluation: point (once per CV)."""
        customData = { dictionary usdGen = { string evaluation = "point" } }
    )
    float2[] usdGen:width:knots = [(0, 1), (1, 1)] (
        doc = """Root-to-tip width ramp as (position, multiplier) pairs with position in [0, 1]. Empty is a flat ramp of 1. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    uniform token usdGen:width:interpolation = "catmullRom" (
        doc = """Interpolation of usdGen:width:knots: "linear", "catmullRom", "bspline" or "constant". Expression evaluation: groom (once per operator)."""
        allowedTokens = ["linear", "catmullRom", "bspline", "constant"]
    )
    bool usdGen:replace = true (
        doc = """True sets the width plane from this operator's profile; false multiplies the incoming widths by it. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
}

