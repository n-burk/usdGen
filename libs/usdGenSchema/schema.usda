        doc = """Asset path of the texture this map samples. Expression evaluation: groom (once per operator)."""
    )
    token usdGen:map:uvSet = "st" (
        doc = """Name of the UV set used to sample the texture. Expression evaluation: groom (once per operator)."""
    )
    token usdGen:map:wrap = "clamp" (
        doc = """Out-of-range UV behaviour: "black", "clamp", "repeat" or "mirror". Expression evaluation: groom (once per operator)."""
        allowedTokens = ["clamp", "repeat", "mirror", "black"]
    )
    token usdGen:map:filter = "bilinear" (
        doc = """Texture filter: "nearest" or "bilinear". Expression evaluation: groom (once per operator)."""
        allowedTokens = ["nearest", "bilinear"]
    )
    token usdGen:map:colorSpace = "raw" (
        doc = """Colour space of the texture: "raw" or "sRGB". Expression evaluation: groom (once per operator)."""
        allowedTokens = ["auto", "raw", "sRGB"]
    )
}

