        doc = """Authored SculptLayer control "deltas". Declared for the frozen v1-v3 vocabulary; no kernel implements SculptLayer yet (02 §8.2), so this value is never read. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
