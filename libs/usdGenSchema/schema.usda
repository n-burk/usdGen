# ---------------------------------------------------------------------------
# Maps (02-schema.md §2.12). Not chain nodes: no usdGen:input, readPhase,
# space or enabled.
# ---------------------------------------------------------------------------

class "UsdGenMap" (
    inherits = </Typed>
    customData = {
        string className = "Map"
    }
)
{
    uniform token usdGen:map:domain = "root" (
        doc = """Where the map is sampled: "root" samples once per root, "cv" once per CV. Expression evaluation: groom (once per operator)."""
        allowedTokens = ["root", "cv"]
    )
    uniform token usdGen:map:channel = "r" (
        doc = """Which channel of the map supplies the scalar: "r", "g", "b" or "a". Expression evaluation: groom (once per operator)."""
        allowedTokens = ["r", "g", "b", "a", "rgb", "luminance"]
    )
    float usdGen:map:scale = 1.0 (
        doc = """Multiplier applied to the sampled value before usdGen:map:offset. Expression evaluation: primitive (once per curve root)."""
        customData = { dictionary usdGen = { string evaluation = "primitive" } }
    )
    float usdGen:map:offset = 0.0 (
        doc = """Constant added to the scaled sample. Expression evaluation: primitive (once per curve root)."""
        customData = { dictionary usdGen = { string evaluation = "primitive" } }
    )
    float2 usdGen:map:clamp = (0, 1) (
        doc = """Output interval the final sample is clamped to. Equal components disable the clamp. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    float usdGen:map:default = 0.0 (
        doc = """Value substituted wherever the map cannot be sampled. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
}

