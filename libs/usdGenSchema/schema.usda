# UsdGenDeform — curves follow the surface (02 §2.8).
class UsdGenDeform "UsdGenDeform" (
    inherits = </UsdGenDeformer>
    customData = {
        string className = "Deform"
    }
)
{
    rel usdGen:guides (
        doc = """Animated curves that drive the deformation on the CPU lane: one BasisCurves prim with UsdGenCurveAPI applied. Each driver CV is an RBF sample bound at its rest position (primvars:rest, else its Default-time position) and moved to its current position, and every incoming CV moves by the resulting smooth field, which passes through the driver CVs and reproduces any affine motion of them exactly. Animate the curves' points; the drivers must span 3D (not all in one plane). Unset, the RBF samples the bound surface instead, which runs on the CUDA lane only. Expression evaluation: groom (once per operator)."""
    )
    bool usdGen:lockRoots = true (
        doc = """True keeps every root where it arrives: the whole strand is shifted back by the field's displacement at its root, so the deformation only bends the strand above it. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    int usdGen:rbfSamples = 100 (
        doc = """Most RBF samples used: taken on the bound surface, or, with usdGen:guides, farthest-point sampled from the driver CVs. Higher values track the drivers more closely at a higher per-frame cost. At least 4. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
}

# UsdGenCollide (v3) — 02 §2.8; defaults for offset/pushAmount/iterations
# and the resolveType token set are adopted from 04-operators.md §4
# (recorded in C1.md §7).
class UsdGenCollide "UsdGenCollide" (
    inherits = </UsdGenDeformer>
    customData = {
        string className = "Collide"
    }
)
{
    rel usdGen:colliders (
        doc = """Collider meshes for the push-out solve, appended after the bound surface, which always collides too. Each of the iterations sweeps moves penetrating CVs out along the closest-point direction, keeping an offset gap and scaling the correction by pushAmount. Expression evaluation: groom (once per operator)."""
    )
    float usdGen:offset = 0.0 (
        doc = """Rest gap kept between CVs and collider surfaces after the push-out solve. Expression evaluation: primitive (once per curve root)."""
        customData = { dictionary usdGen = { string evaluation = "primitive" } }
    )
    float usdGen:pushAmount = 0.0 (
        doc = """Fraction of the push-out correction applied per sweep; 1 applies the full separation. Expression evaluation: primitive (once per curve root)."""
        customData = { dictionary usdGen = { string evaluation = "primitive" } }
    )
    int usdGen:iterations = 1 (
        doc = """Number of push-out sweeps over each strand. At least 1. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    uniform token usdGen:resolveType = "flexible" (
        doc = """How the push-out moves the strand: "flexible" corrects each CV independently, "stiff" hinges the strand about the last clean CV. Expression evaluation: groom (once per operator)."""
        allowedTokens = ["flexible", "stiff"]
    )
}

