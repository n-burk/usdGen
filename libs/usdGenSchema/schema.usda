    uniform token usdGen:sculpt:space = "rootFrame" (
        doc = """Authored SculptLayer control "space". Declared for the frozen v1-v3 vocabulary; no kernel implements SculptLayer yet (02 §8.2), so this value is never read. Expression evaluation: groom (once per operator)."""
        allowedTokens = ["rootFrame", "object"]
    )
    uint64[] usdGen:sculpt:curveIds = [] (
        doc = """Authored SculptLayer control "curveIds". Declared for the frozen v1-v3 vocabulary; no kernel implements SculptLayer yet (02 §8.2), so this value is never read. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
