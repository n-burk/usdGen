        doc = """Authored SculptLayer control "cvOffsets". Declared for the frozen v1-v3 vocabulary; no kernel implements SculptLayer yet (02 §8.2), so this value is never read. Expression evaluation: primitive (once per curve root)."""
        customData = { dictionary usdGen = { string evaluation = "primitive" } }
    )
