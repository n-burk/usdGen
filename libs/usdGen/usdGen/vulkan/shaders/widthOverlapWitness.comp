#version 450

// Test-only overlap probe. Vulkan port of libs/usdGen/usdGen/gpu/
// widthOverlapWitness.cu: one thread records simultaneous probes and waits
// for the expected arrivals. The CUDA kernel bounds its rendezvous with a
// clock64() deadline; GLSL compute has no portable device clock, so this
// module bounds it with a push-constant spin-iteration budget instead. The
// contract is unchanged: a bounded rendezvous, never an unbounded gate. A
// concurrent peer releases both probes promptly; a serial queue exhausts
// the budget and observes maxActive of one without deadlock.
layout(local_size_x = 1) in;
layout(set = 0, binding = 0, std430) coherent buffer Counters {
    uint values[];
} counters;
layout(push_constant) uniform Controls {
    uint expected;
    uint dwellIterations;
} controls;

void main() {
    if (gl_GlobalInvocationID.x != 0u) return;
    uint live = atomicAdd(counters.values[0], 1u) + 1u;
    atomicMax(counters.values[1], live);
    atomicAdd(counters.values[2], 1u);
    // Each iteration performs an atomic read with a visible side effect, so
    // the compiler must emit every poll; the loop cannot be hoisted into a
    // single load. Coherent atomics make a peer's arrival visible in
    // practice on one device, mirroring the CUDA probe's reliance on
    // device-scope atomic visibility across streams.
    for (uint i = 0u; i < controls.dwellIterations; ++i) {
        if (atomicAdd(counters.values[2], 0u) >= controls.expected) break;
    }
    atomicAdd(counters.values[0], 0xFFFFFFFFu);
}
