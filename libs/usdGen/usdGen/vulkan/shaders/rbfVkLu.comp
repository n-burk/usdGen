// rbfVkLu.comp — device replacement for the cuSOLVER Dgetrf call in
// CudaRbfBinding::Bind (rbf.cu:468): in-place Doolittle LU with partial
// pivoting of the row-major bordered matrix, plus the row permutation.
//
// Exactly one workgroup of 256 runs the column loop. Thread 0 performs
// the pivot search and row/perm swap serially (SolveRbf order in
// deformRbfHost.h); all threads then apply the trailing update to
// strided rows. barrier() between phases is both the control and the
// full-memory workgroup barrier, so no atomics are needed. info follows
// the LAPACK/cuSOLVER convention: 0 on success, otherwise the 1-based
// index of the first exactly-zero pivot (host maps info > 0 to
// RankDeficient, exactly as for cuSOLVER).
//
// ABI — descriptors:
//   0 matrix double[m*m] RW (row-major; L below / U on and above diagonal)
//   1 info   int[1]      W
//   2 perm   int[m]      W (row permutation: solved rows read rhs[perm[i]])
//   3 UBO    RbfVkSolveUbo (64 bytes; uses m)
//
// Dispatch: local_size_x=256, groups=(1,1,1).

#version 460
layout(local_size_x = 256) in;

layout(std430, binding = 0) buffer Matrix { double matrix[]; };
layout(std430, binding = 1) buffer Info   { int info; };
layout(std430, binding = 2) buffer Perm   { int perm[]; };

layout(std140, binding = 3) uniform Params {
    ivec4  nmc;       // x = n (samples), y = m (n+4), z = count, w = reserved
    double cx;
    double cy;
    double cz;
    double invScale;
    double scale;
    double lambda;    // smoothing (buildMatrix diagonal only)
} params;

shared int failed;

void main() {
    uint tid = gl_LocalInvocationID.x;
    int m = params.nmc.y;
    for (int i = int(tid); i < m; i += 256) perm[i] = i;
    if (tid == 0u) failed = 0;
    memoryBarrierBuffer();
    barrier();
    for (int c = 0; c < m; ++c) {
        if (tid == 0u) {
            int p = c;
            for (int r = c + 1; r < m; ++r)
                if (abs(matrix[r * m + c]) > abs(matrix[p * m + c])) p = r;
            if (matrix[p * m + c] == 0.0) {
                info = c + 1;
                failed = 1;
            } else if (p != c) {
                for (int k = 0; k < m; ++k) {
                    double t = matrix[c * m + k];
                    matrix[c * m + k] = matrix[p * m + k];
                    matrix[p * m + k] = t;
                }
                int tp = perm[c];
                perm[c] = perm[p];
                perm[p] = tp;
            }
        }
        memoryBarrierBuffer();
        barrier();
        if (failed != 0) break;
        double pivot = matrix[c * m + c];
        for (int r = c + 1 + int(tid); r < m; r += 256) {
            double f = matrix[r * m + c] / pivot;
            matrix[r * m + c] = f;
            for (int k = c + 1; k < m; ++k)
                matrix[r * m + k] -= f * matrix[c * m + k];
        }
        memoryBarrierBuffer();
        barrier();
    }
    if (tid == 0u && failed == 0) info = 0;
}
