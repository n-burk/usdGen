#version 450

// Trusted LengthCompactionPipeline ABI. All byte gathers own a complete
// destination uint, including odd-stride records sharing the same word.
layout(local_size_x = 64) in;
layout(set=0,binding=0,std430) readonly buffer InputWords { uint inputWords[]; };
layout(set=0,binding=1,std430) readonly buffer Offsets { uint offsets[]; };
layout(set=0,binding=2,std430) buffer Keep { uint keep[]; };
layout(set=0,binding=3,std430) readonly buffer ScanIn { uint scanIn[]; };
layout(set=0,binding=4,std430) buffer ScanOut { uint scanOut[]; };
layout(set=0,binding=5,std430) buffer Status { uint status[]; };
layout(set=0,binding=6,std430) readonly buffer Spans { uint spans[]; };
layout(set=0,binding=7,std430) buffer ReverseCurve { uint reverseCurve[]; };
layout(set=0,binding=8,std430) buffer ReversePoint { uint reversePoint[]; };
layout(set=0,binding=9,std430) buffer PlaneOutput { uint planeOutput[]; };
layout(push_constant) uniform Controls {
    uint curves;
    uint points;
    uint phase;
    uint distance;
    float threshold;
    uint outputWords;
    uint stride;
    uint inputBytes;
    uint outputBytes;
    uint domain; // 0 Point, 1 Primitive; Groom is an immutable host alias.
    uint spanCount;
} p;

void invalid() { atomicOr(status[0], 1u); }
bool finiteFloat(float v) { return !isnan(v) && !isinf(v); }
uvec2 prefix(uint boundary) {
    if (boundary == 0u) return uvec2(0u);
    uint i = 2u * (boundary - 1u);
    return uvec2(scanIn[i], scanIn[i+1u]);
}
float coordinate(uint point, uint axis) {
    return uintBitsToFloat(inputWords[point * 3u + axis]);
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (p.phase == 0u) {
        // Validate the complete offsets/points packet before any scatter can
        // write it. Every flag/prefix seed is initialized even on bad input.
        if (i == 0u) {
            if (!finiteFloat(p.threshold) || p.threshold < 0.0 ||
                offsets[0] != 0u || (p.curves == 0u && p.points != 0u)) invalid();
        }
        if (i >= p.curves) return;
        keep[i] = 0u;
        scanOut[2u*i] = 0u;
        scanOut[2u*i+1u] = 0u;
        uint begin = offsets[i], end = offsets[i+1u];
        if (begin > end || end > p.points ||
            (i+1u == p.curves && end != p.points)) { invalid(); return; }
        precise float current = 0.0;
        for (uint point = begin; point < end; ++point) {
            float x = coordinate(point,0u), y = coordinate(point,1u), z = coordinate(point,2u);
            if (!finiteFloat(x) || !finiteFloat(y) || !finiteFloat(z)) { invalid(); return; }
            if (point > begin) {
                precise float dx = x - coordinate(point-1u,0u);
                precise float dy = y - coordinate(point-1u,1u);
                precise float dz = z - coordinate(point-1u,2u);
                precise float xx = dx*dx;
                precise float yy = dy*dy;
                precise float zz = dz*dz;
                precise float xy = xx+yy;
                precise float squared = xy+zz;
                precise float segment = sqrt(squared);
                current = current + segment;
            }
        }
        if (!finiteFloat(current)) { invalid(); return; }
        uint survives = current >= p.threshold ? 1u : 0u;
        keep[i] = survives;
        scanOut[2u*i] = survives;
        scanOut[2u*i+1u] = survives * (end-begin);
        return;
    }
    if (p.phase == 1u) {
        // Hillis-Steele ping-pong scan: O(log N) dispatches, no serial
        // whole-buffer loop and no writes to a buffer concurrently read.
        if (i >= p.curves) return;
        uvec2 sum = uvec2(scanIn[2u*i],scanIn[2u*i+1u]);
        if (i >= p.distance) {
            uint previous = 2u*(i-p.distance);
            sum += uvec2(scanIn[previous],scanIn[previous+1u]);
        }
        scanOut[2u*i] = sum.x;
        scanOut[2u*i+1u] = sum.y;
        return;
    }
    if (p.phase == 2u) {
        // Host-visible results are scalar cardinalities and frozen metadata
        // span boundaries only. No geometry, IDs, or named bytes are read back.
        if (i == 0u) {
            uvec2 total = prefix(p.curves);
            status[1] = total.x;
            status[2] = total.y;
        }
        if (i >= p.spanCount) return;
        uint c0 = spans[4u*i], c1 = spans[4u*i+1u];
        uint v0 = spans[4u*i+2u], v1 = spans[4u*i+3u];
        // Ragged chunks have no host-visible terminal CV offset. The host
        // supplies this sentinel; derive it from the immutable GPU topology.
        if (v1 == 0xffffffffu && c1 <= p.curves) v1 = offsets[c1];
        if (c0 > c1 || c1 > p.curves || v0 > v1 || v1 > p.points ||
            offsets[c0] != v0 || offsets[c1] != v1) { invalid(); return; }
        uvec2 first = prefix(c0), last = prefix(c1);
        uint outIndex = 3u+4u*i;
        status[outIndex] = first.x;
        status[outIndex+1u] = last.x-first.x;
        status[outIndex+2u] = first.y;
        status[outIndex+3u] = last.y-first.y;
        return;
    }
    // A compute->compute barrier separates all validation/count dispatches
    // from these phases. A semantic failure cannot launch payload writes.
    if (atomicOr(status[0], 0u) != 0u) return;
    if (p.phase == 3u) {
        if (i >= p.curves || keep[i] == 0u) return;
        uvec2 destination = prefix(i);
        reverseCurve[destination.x] = i;
        uint begin = offsets[i], end = offsets[i+1u];
        for (uint point = begin; point < end; ++point)
            reversePoint[destination.y+point-begin] = point;
        return;
    }
    if (p.phase == 4u) {
        if (i >= p.outputWords) return;
        if (p.stride == 0u || p.domain > 1u) { invalid(); return; }
        uint word = 0u;
        for (uint lane = 0u; lane < 4u; ++lane) {
            uint byteIndex = 4u*i+lane;
            if (byteIndex >= p.outputBytes) continue;
            uint element = byteIndex / p.stride;
            uint relative = byteIndex % p.stride;
            uint count = p.domain == 0u ? status[2] : status[1];
            if (element >= count) { invalid(); continue; }
            uint sourceElement = p.domain == 0u ? reversePoint[element] : reverseCurve[element];
            // Host bounds byte extents to UINT32_MAX; check multiplication
            // before computing an address rather than permitting wraparound.
            if (sourceElement > p.inputBytes / p.stride) { invalid(); continue; }
            uint sourceByte = sourceElement * p.stride;
            if (sourceByte >= p.inputBytes || relative >= p.inputBytes-sourceByte) { invalid(); continue; }
            sourceByte += relative;
            uint byteValue = (inputWords[sourceByte/4u] >> (8u*(sourceByte%4u))) & 255u;
            word |= byteValue << (8u*lane);
        }
        planeOutput[i] = word;
        return;
    }
    if (p.phase == 5u) {
        if (i > status[1]) return;
        planeOutput[i] = i == status[1] ? status[2] : prefix(reverseCurve[i]).y;
    }
}
