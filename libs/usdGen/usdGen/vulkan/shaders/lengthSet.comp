#version 450
// Trusted absolute-Length companion to lengthScale.comp.  It deliberately
// retains that module's descriptor and 16-byte push ABI; CreateWithSet keeps
// this code in a separate pipeline so old scale SPIR-V is never reinterpreted.
layout(local_size_x = 256) in;
layout(set = 0, binding = 0, std430) readonly buffer P { float v[]; } points;
layout(set = 0, binding = 1, std430) readonly buffer O { uint v[]; } offsets;
layout(set = 0, binding = 2, std430) writeonly buffer R { float v[]; } outputPoints;
layout(set = 0, binding = 3, std430) buffer S { uint error; } status;
layout(push_constant) uniform C { uint curves; uint points; uint phase; float target; } c;

bool finite(float x) { return !isnan(x) && !isinf(x); }
void fail() { atomicOr(status.error, 1u); }
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (c.phase == 0u) {
        if (!finite(c.target) || c.target < 0.0) fail();
        if (i <= c.curves) {
            uint o = offsets.v[i];
            if ((i == 0u && o != 0u) || (i == c.curves && o != c.points)) fail();
            if (i < c.curves && o >= offsets.v[i + 1u]) fail();
        }
        if (i < c.points) {
            uint p = 3u * i;
            if (!finite(points.v[p]) || !finite(points.v[p + 1u]) || !finite(points.v[p + 2u])) fail();
        }
        return;
    }
    if (atomicAdd(status.error, 0u) != 0u || i >= c.curves) return;
    uint begin = offsets.v[i], end = offsets.v[i + 1u];
    float current = 0.0;
    for (uint j = begin + 1u; j < end; ++j) {
        uint a = 3u * (j - 1u), b = 3u * j;
        float dx = points.v[b] - points.v[a];
        float dy = points.v[b + 1u] - points.v[a + 1u];
        float dz = points.v[b + 2u] - points.v[a + 2u];
        current += sqrt(dx * dx + dy * dy + dz * dz);
    }
    if (!finite(current)) { fail(); return; }
    // CUDA LengthKernel has no tangent fallback: a positive absolute target
    // for a degenerate strand is a semantic error.  A zero target is its
    // exact no-op (factor 1) rather than an invented collapse direction.
    if (current == 0.0 && c.target > 0.0) { fail(); return; }
    float factor = current > 0.0 ? c.target / current : 1.0;
    if (!finite(factor) || factor < 0.0) { fail(); return; }
    uint root = 3u * begin;
    precise float rx = points.v[root], ry = points.v[root + 1u], rz = points.v[root + 2u];
    for (uint j = begin; j < end; ++j) {
        uint p = 3u * j;
        if (factor == 1.0) {
            outputPoints.v[p] = points.v[p]; outputPoints.v[p + 1u] = points.v[p + 1u]; outputPoints.v[p + 2u] = points.v[p + 2u];
        } else {
            precise float x = rx + (points.v[p] - rx) * factor;
            precise float y = ry + (points.v[p + 1u] - ry) * factor;
            precise float z = rz + (points.v[p + 2u] - rz) * factor;
            if (!finite(x) || !finite(y) || !finite(z)) { fail(); return; }
            outputPoints.v[p] = x; outputPoints.v[p + 1u] = y; outputPoints.v[p + 2u] = z;
        }
    }
}
