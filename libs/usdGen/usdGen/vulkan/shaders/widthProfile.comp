#version 450
// Scalar profile Width ABI: bindings input/output/status/hairT = 0/1/2/3.
layout(local_size_x=256) in;
layout(set=0,binding=0,std430) readonly buffer I { float v[]; } inputWidth;
layout(set=0,binding=1,std430) writeonly buffer O { float v[]; } outputWidth;
layout(set=0,binding=2,std430) buffer S { uint error; } status;
layout(set=0,binding=3,std430) readonly buffer T { float v[]; } hairT;
layout(push_constant) uniform C { uint count; float width; uint replace;
    float rootScale; float tipScale; float taper; float taperStart; uint useHairT; } c;
bool finite(float x) { return !isnan(x) && !isinf(x); }
void main() {
 uint i=gl_GlobalInvocationID.x; if(i>=c.count) return;
 float inW=inputWidth.v[i], t=hairT.v[i];
 if(c.replace>1u || c.useHairT!=1u || !finite(inW)||inW<0.0||!finite(t)||t<0.0||t>1.0||
 !finite(c.width)||c.width<0.0||!finite(c.rootScale)||c.rootScale<0.0||
 !finite(c.tipScale)||c.tipScale<0.0||!finite(c.taper)||c.taper<0.0||c.taper>1.0||
 !finite(c.taperStart)||c.taperStart<0.0||c.taperStart>1.0){atomicOr(status.error,1u);return;}
 // Preserve the CPU operator's evaluation order: taper is applied to the
 // initial target first, then the root-to-tip scale is applied.
 precise float taperTerm=1.0; if(c.taper>0.0&&t>c.taperStart)
  taperTerm=1.0-c.taper*(t-c.taperStart)/(c.taperStart<1.0 ? 1.0-c.taperStart : 1.0);
 precise float target=c.width;
 target*=taperTerm;
 target*=c.rootScale+(c.tipScale-c.rootScale)*t;
 precise float r=c.replace!=0u ? inW+(target-inW) : inW*(1.0+(target-1.0));
 if(!finite(target)||target<0.0||!finite(r)||r<0.0){atomicOr(status.error,2u);return;}
 outputWidth.v[i]=r;
}
