#version 450
// PicktileVkIndices: GPU-native index streams for the native Storm curve
// primitive layouts. Port of usdGen::gpu::BuildCurveIndices +
// PackCurveDrawCount (gpu/curveIndices.cu): CountKernel + TerminalKernel +
// ExclusiveSum + TotalKernel + EmitKernel + PackDrawCountKernel.
//
// The u64 CUB scan becomes a saturating-u32 ping-pong Hillis-Steele scan:
// every downstream decision (total vs maxRecords/INT32_MAX, emit offsets)
// is exact whenever the true total fits u32, and any overflowing total
// saturates to 0xFFFFFFFF which still fails the INT32_MAX bound, so
// saturated and u64 scans agree on status, recordCount, and all emitted
// values. No shaderInt64 feature is required.
//
// Offsets remain global (first value = pointBase, terminal = pointBase +
// pointCount); generated indices and primitive parameters are tile-local.
// basis/wrap/mode use the CUDA CurveIndexBasis/Wrap/Mode ordinals:
//   basis: 0 Linear, 1 Bezier, 2 BSpline, 3 CatmullRom, 4 CentripetalCatmullRom
//   wrap:  0 Nonperiodic, 1 Periodic, 2 Pinned, 3 Segmented
//   mode:  0 Curves, 1 Hull, 2 Points
//
// ABI:
//   push constant (48B, std430): {u32 curveCount, pointCount, pointBase,
//     basis, wrap, mode, maxRecords, arity, phase, stride, srcIsB, spanInvalid}
//     phase 0 = count + terminal, 1 = scan step, 2 = total,
//           3 = emit, 4 = pack draw count
//   set 0:
//     b0 offsets    uint[curveCount+1]  borrowed global offsets (read-only)
//     b1 countsA    uint[curveCount+1]  per-curve counts / ping-pong A
//     b2 scanB      uint[curveCount+1]  ping-pong B
//     b3 offsetsOut uint[curveCount+1]  exclusive record offsets (u32, exact)
//     b4 indices    int[maxRecords*arity] packed records
//     b5 primParam  int[maxRecords]       owning curve per record
//     b6 total      uvec2 (lo,hi)         u64 record count (hi always 0)
//     b7 state      {uint status; uint drawCount}
//       status: 0 valid, 1 bad offsets, 2 invalid segmented count
//
// Host pre-fill: status = 0, total = (0,0), drawCount = 0. Emit and pack run
// after device barriers; emit writes nothing when status != 0, and pack
// yields 0 unless status == 0 with a representable count, so device
// validation failures leave indices/primParam untouched with recordCount 0.

layout(local_size_x = 256) in;

layout(push_constant) uniform PC {
    uint curveCount;
    uint pointCount;
    uint pointBase;
    uint basis;
    uint wrap;
    uint mode;
    uint maxRecords;
    uint arity;
    uint phase;
    uint stride;
    uint srcIsB;
    uint spanInvalid;
} pc;

layout(std430, set = 0, binding = 0) readonly buffer OffsetsBlock { uint offsets[]; };
layout(std430, set = 0, binding = 1) buffer CountsBlock { uint countsA[]; };
layout(std430, set = 0, binding = 2) buffer ScanBBlock { uint scanB[]; };
layout(std430, set = 0, binding = 3) buffer OutOffsBlock { uint offsetsOut[]; };
layout(std430, set = 0, binding = 4) buffer IndicesBlock { int indices[]; };
layout(std430, set = 0, binding = 5) buffer PrimBlock { int primParam[]; };
layout(std430, set = 0, binding = 6) buffer TotalBlock { uvec2 total; } tt;
layout(std430, set = 0, binding = 7) buffer StateBlock {
    uint status;
    uint drawCount;
} st;

const uint kLinear = 0u;
const uint kBezier = 1u;
const uint kBSpline = 2u;
const uint kCatmullRom = 3u;
const uint kCentripetal = 4u;
const uint kNonperiodic = 0u;
const uint kPeriodic = 1u;
const uint kPinned = 2u;
const uint kSegmented = 3u;
const uint kCurves = 0u;
const uint kHull = 1u;
const uint kPoints = 2u;
const uint kIntMax = 0x7FFFFFFFu;

bool cubic() { return pc.basis != kLinear && pc.mode == kCurves; }
bool catmull() { return pc.basis == kCatmullRom || pc.basis == kCentripetal; }
void fail(uint code) { atomicCompSwap(st.status, 0u, code); }

uint countFor(uint n) {
    if (pc.mode == kPoints) return n;
    if (!cubic()) {
        if (n < 2u) return pc.wrap == kPeriodic ? 1u : 0u;
        if (pc.wrap == kSegmented) return n / 2u;
        bool skip = pc.mode == kHull && catmull() && pc.wrap != kPinned;
        if (skip) {
            if (n <= 3u) return pc.wrap == kPeriodic ? 1u : 0u;
            return pc.wrap == kPeriodic ? n - 2u : n - 3u;
        }
        return pc.wrap == kPeriodic ? n : n - 1u;
    }
    if (n < 2u) return 0u;
    uint step = pc.basis == kBezier ? 3u : 1u;
    uint core = pc.wrap == kPeriodic ? max(n / step, 1u)
        : (max(int(n) - 4, 0) / int(step)) + 1u;
    if (pc.wrap == kPinned && step == 1u)
        core += pc.basis == kBSpline ? 4u : 2u;
    return core;
}

void putRecord(uint r, int a, int b, int c, int d, int curve) {
    uint p = r * pc.arity;
    indices[p] = a;
    if (pc.arity > 1u) indices[p + 1u] = b;
    if (pc.arity > 2u) { indices[p + 2u] = c; indices[p + 3u] = d; }
    primParam[r] = curve;
}

void main() {
    const uint idx = gl_GlobalInvocationID.x;
    const uint stride = gl_NumWorkGroups.x * gl_WorkGroupSize.x;

    if (pc.phase == 0u) {
        // Scalar span overflow fails closed through status/recordCount.
        if (pc.spanInvalid != 0u) {
            if (idx == 0u) fail(1u);
            return;
        }
        uint pointEnd = pc.pointBase + pc.pointCount;
        for (uint c = idx; c < pc.curveCount; c += stride) {
            uint a = offsets[c], b = offsets[c + 1u];
            if ((c == 0u && a != pc.pointBase) || a < pc.pointBase || a >= pointEnd ||
                b <= a || b > pointEnd ||
                (c + 1u == pc.curveCount && b != pointEnd)) {
                fail(1u);
                countsA[c] = 0u;
                continue;
            }
            uint n = b - a;
            if (pc.wrap == kSegmented && pc.basis == kLinear && (n & 1u) != 0u) {
                fail(2u);
                countsA[c] = 0u;
                continue;
            }
            countsA[c] = countFor(n);
        }
        if (idx == 0u) {
            countsA[pc.curveCount] = 0u;
            if (pc.curveCount == 0u &&
                (offsets[0u] != pc.pointBase || pointEnd != pc.pointBase)) fail(1u);
        }
    } else if (pc.phase == 1u) {
        // Saturating Hillis-Steele step (see header comment for why u32
        // saturation is exactly equivalent to the u64 scan here).
        if (pc.srcIsB == 0u) {
            for (uint i = idx; i <= pc.curveCount; i += stride) {
                uint v = countsA[i];
                if (i >= pc.stride) {
                    uint w = countsA[i - pc.stride];
                    uint s = v + w;
                    v = (s < v) ? 0xFFFFFFFFu : s;
                }
                scanB[i] = v;
            }
        } else {
            for (uint i = idx; i <= pc.curveCount; i += stride) {
                uint v = scanB[i];
                if (i >= pc.stride) {
                    uint w = scanB[i - pc.stride];
                    uint s = v + w;
                    v = (s < v) ? 0xFFFFFFFFu : s;
                }
                countsA[i] = v;
            }
        }
    } else if (pc.phase == 2u) {
        // Exclusive offsets from the final inclusive plane (srcIsB selects
        // it: an even scan-step count leaves the result in A): exclusive[i]
        // is inclusive[i-1]. Sequential on lane 0, like the CUDA TotalKernel.
        if (idx == 0u) {
            bool overflow = false;
            for (uint i = 0u; i <= pc.curveCount; ++i) {
                // Nested if (never ternary indexing): the i-1 read must be
                // unreachable when i == 0 on every driver.
                uint excl = 0u;
                if (i != 0u) {
                    if (pc.srcIsB == 0u) excl = countsA[i - 1u];
                    else excl = scanB[i - 1u];
                }
                if (excl == 0xFFFFFFFFu && i != 0u) {
                    // A saturated predecessor means the true total exceeds
                    // u32; every later offset saturates too.
                    overflow = true;
                }
                offsetsOut[i] = overflow ? 0xFFFFFFFFu : excl;
            }
            if (st.status != 0u) {
                tt.total = uvec2(0u, 0u);
            } else {
                uint n = offsetsOut[pc.curveCount];
                if (overflow || n > pc.maxRecords || n > kIntMax) {
                    fail(1u);
                    tt.total = uvec2(0u, 0u);
                } else {
                    tt.total = uvec2(n, 0u);
                }
            }
        }
    } else if (pc.phase == 3u) {
        // Emit: one workgroup per curve (mirrors EmitKernel's grid).
        if (st.status != 0u) return;
        uint curve = gl_WorkGroupID.x;
        if (curve >= pc.curveCount) return;
        uint lid = gl_LocalInvocationID.x;
        uint first = offsets[curve] - pc.pointBase;
        uint n = offsets[curve + 1u] - offsets[curve];
        uint base = offsetsOut[curve];
        int icurve = int(curve);
        if (pc.mode == kPoints) {
            for (uint i = lid; i < n; i += 256u) {
                putRecord(base + i, int(first + i), 0, 0, 0, icurve);
            }
            return;
        }
        if (!cubic()) {
            if (n < 2u) {
                if (pc.wrap == kPeriodic && lid == 0u)
                    putRecord(base, int(first), int(first), 0, 0, icurve);
                return;
            }
            bool segmented = pc.wrap == kSegmented;
            bool skip = pc.mode == kHull && catmull() && pc.wrap != kPinned;
            uint records = countFor(n);
            for (uint i = lid; i < records; i += 256u) {
                uint x, y;
                if (segmented) { x = 2u * i; y = x + 1u; }
                else if (skip) {
                    if (pc.wrap == kPeriodic && i + 1u == records) { x = n - 1u; y = 0u; }
                    else { x = i + 1u; y = x + 1u; }
                } else {
                    x = i;
                    y = (pc.wrap == kPeriodic) ? ((i + 1u) % n) : (i + 1u);
                }
                putRecord(base + i, int(first + x), int(first + y), 0, 0, icurve);
            }
            return;
        }
        if (n < 2u) return;
        bool periodic = pc.wrap == kPeriodic;
        uint step = pc.basis == kBezier ? 3u : 1u;
        bool pinned = pc.wrap == kPinned && step == 1u;
        uint core = periodic ? max(n / step, 1u) : (uint(max(int(n) - 4, 0)) / step) + 1u;
        uint pre = pinned ? (pc.basis == kBSpline ? 2u : 1u) : 0u;
        uint total = pre + core + pre;
        for (uint r = lid; r < total; r += 256u) {
            int a, b, c, d;
            if (r < pre) {
                uint v1 = min(1u, n - 1u), v2 = min(2u, n - 1u);
                if (pc.basis == kBSpline && r == 0u) { a = 0; b = 0; c = 0; d = int(v1); }
                else { a = 0; b = 0; c = int(v1); d = int(v2); }
            } else if (r < pre + core) {
                uint i = r - pre, base = i * step;
                if (periodic) {
                    a = int(base % n); b = int((base + 1u) % n);
                    c = int((base + 2u) % n); d = int((base + 3u) % n);
                } else {
                    a = int(min(base, n - 1u)); b = int(min(base + 1u, n - 1u));
                    c = int(min(base + 2u, n - 1u)); d = int(min(base + 3u, n - 1u));
                }
            } else {
                uint base = (core - 1u) * step;
                int q1 = int(min(base + 1u, n - 1u));
                int q2 = int(min(base + 2u, n - 1u));
                int q3 = int(min(base + 3u, n - 1u));
                if (pc.basis == kBSpline && r == pre + core + 1u) { a = q2; b = q3; c = q3; d = q3; }
                else { a = q1; b = q2; c = q3; d = q3; }
            }
            putRecord(base + r, int(first) + a, int(first) + b, int(first) + c, int(first) + d, icurve);
        }
    } else {
        // Pack draw count (mirrors PackDrawCountKernel).
        // No records*arity overflow guard: Begin rejects
        // maxRecords*arity > UINT32_MAX, and records <= maxRecords on the
        // fall-through path, so the product cannot overflow. (A
        // `records > 0xFFFFFFFFu / pc.arity` guard here crashed the
        // NVIDIA compiler with SIGTRAP inside vkCreateComputePipelines;
        // do not reintroduce that shape.)
        if (idx == 0u) {
            uint records = tt.total.x;
            uint hi = tt.total.y;
            if (st.status != 0u || hi != 0u || records > pc.maxRecords) {
                st.drawCount = 0u;
            } else {
                st.drawCount = records * pc.arity;
            }
        }
    }
}
