// ---- 64-bit integer helpers (SplitMix64) ----
uint mul_hi(uint a, uint b) {
    uint a0 = a & 0xFFFFu, a1 = a >> 16;
    uint b0 = b & 0xFFFFu, b1 = b >> 16;
    uint p0 = a0 * b0;
    uint p1 = a0 * b1;
    uint p2 = a1 * b0;
    uint p3 = a1 * b1;
    uint mid = (p0 >> 16) + (p1 & 0xFFFFu) + (p2 & 0xFFFFu);
    return p3 + (p1 >> 16) + (p2 >> 16) + (mid >> 16);
}
uvec2 add64(uvec2 a, uvec2 b) {
    uint lo = a.x + b.x;
    return uvec2(lo, a.y + b.y + (lo < a.x ? 1u : 0u));
}
uvec2 mul64(uvec2 a, uvec2 b) {
    // low 64 bits of a*b
    uint lo = a.x * b.x;
    uint hi = mul_hi(a.x, b.x) + a.x * b.y + a.y * b.x;
    return uvec2(lo, hi);
}
uvec2 shr64u(uvec2 a, uint n) {
    // returns full 64-bit result of (a >> n)
    if (n >= 32u) return uvec2(0u, a.y >> (n - 32u));
    return uvec2((a.x >> n) | (a.y << (32u - n)), a.y >> n);
}
uvec2 Smix64(uvec2 key, uint salt) {
    uvec2 c  = uvec2(0x7F4A7C15u, 0x9E3779B9u);
    uvec2 m1 = uvec2(0x1CE4E5B9u, 0xBF58476Du);
    uvec2 m2 = uvec2(0x133111EBu, 0x94D049BBu);
    uvec2 s = uvec2(salt, 0u);
    uvec2 z = add64(key ^ mul64(s, c), c);
    z = mul64(z ^ shr64u(z, 30u), m1);
    z = mul64(z ^ shr64u(z, 27u), m2);
    return z ^ shr64u(z, 31u);
}
float Draw01(int seed, uvec2 cid, uint salt) {
    uvec2 s64 = uvec2(uint(uint(seed)), 0u);
    uvec2 key = Smix64(s64, salt) ^ cid;
    uvec2 h = Smix64(key, salt);
    return float(h.y >> 8u) * float(1u) / float(1u << 24u);
}
// ---- SeExpr3 Perlin (float in/out, double inner accumulation) ----

double hashReduceChar(int x, int y, int z) {
    // returns the byte; cast to double for G indexing
    uint seed = 0u;
    seed = seed * 1664525u + uint(x) + 1013904223u;
    seed = seed * 1664525u + uint(y) + 1013904223u;
    seed = seed * 1664525u + uint(z) + 1013904223u;
    seed ^= (seed >> 11u);
    seed ^= (seed << 7u) & 0x9d2c5680u;
    seed ^= (seed << 15u) & 0xefc60000u;
    seed ^= (seed >> 18u);
    return float(((((seed & 0xff0000u) >> 4u) + (seed & 0xffu)) & 0xffu));
}

double SCurve(float x) {
    double t = x;
    return t * t * t * (t * (t * 6.0 - 15.0) + 10.0);
}

float Noise3(float x, float y, float z) {
    vec3 X = vec3(x, y, z);
    vec3 f = floor(X);
    ivec3 index = ivec3(f);
    vec3 w0 = X - f;
    vec3 w1 = w0 - vec3(1.0);
    float vals[8];
    for (int dummy = 0; dummy < 8; dummy++) {
        int off0 = (dummy >> 0) & 1;
        int off1 = (dummy >> 1) & 1;
        int off2 = (dummy >> 2) & 1;
        ivec3 lidx = index + ivec3(off0, off1, off2);
        uint lookup = uint(hashReduceChar(lidx.x, lidx.y, lidx.z));
        float val = 0.0;
        val = float(double(val) + G[lookup][0] * double(off0 != 0 ? w1.x : w0.x));
        val = float(double(val) + G[lookup][1] * double(off1 != 0 ? w1.y : w0.y));
        val = float(double(val) + G[lookup][2] * double(off2 != 0 ? w1.z : w0.z));
        vals[dummy] = val;
    }
    float alphas[3];
    alphas[0] = float(SCurve(w0.x));
    alphas[1] = float(SCurve(w0.y));
    alphas[2] = float(SCurve(w0.z));
    for (int newd = 2; newd >= 0; newd--) {
        int newnum = 1 << newd;
        int k = 3 - newd - 1;
        float alpha = alphas[k];
        float beta = 1.0 - alphas[k];
        for (int dummy = 0; dummy < newnum; dummy++) {
            int index2 = dummy * (1 << (3 - newd));
            int otherIndex = index2 + (1 << k);
            vals[index2] = beta * vals[index2] + alpha * vals[otherIndex];
        }
    }
    return vals[0];
}

bool SupportedLatticeCoordinate(float value) {
    if (!Finite(value)) return false;
    double cell = floor(double(value));
    return cell >= -2147483648.0 && cell < 2147483647.0;
}
bool SupportedNoisePoint(float x, float y, float z) {
    return SupportedLatticeCoordinate(x) && SupportedLatticeCoordinate(y) &&
           SupportedLatticeCoordinate(z);
}

bool Vfbm3(float x, float y, float z, int octaves, float lacunarity,
           float gain, out vec3 result) {
    result = vec3(0.0);
    float scale = 1.0;
    for (int octave = 0; octave < octaves; ++octave) {
        float x1 = x + 1000.0, y1 = y + 1000.0, z1 = z + 1000.0;
        float x2 = x + 2000.0, y2 = y + 2000.0, z2 = z + 2000.0;
        if (!SupportedNoisePoint(x, y, z) || !SupportedNoisePoint(x1, y1, z1) ||
            !SupportedNoisePoint(x2, y2, z2)) return false;
        result.x += Noise3(x, y, z) * scale;
        result.y += Noise3(x1, y1, z1) * scale;
        result.z += Noise3(x2, y2, z2) * scale;
        if (octave + 1 == octaves) break;
        scale *= gain;
        x = x * lacunarity + 1234.0;
        y = y * lacunarity + 1234.0;
        z = z * lacunarity + 1234.0;
        if (!Finite(x) || !Finite(y) || !Finite(z) || !Finite(scale))
            return false;
    }
    return FiniteV3(result);
}

float ComputeHairT(uint point, uint begin, uint end) {
    float result = end > begin + 1u ? float(point - begin) / float(end - begin - 1u) : 0.0;
    if ((push.flags & FLAG_HAIR_T) != 0u) result = hairT[point];
    return result;
}

float Sample257(float t) {
    float coordinate = t * 256.0;
    int lower = min(255, max(0, int(floor(coordinate))));
    float fraction = coordinate - float(lower);
    return magnitudeProfile[lower] + (magnitudeProfile[lower + 1] -
                                      magnitudeProfile[lower]) * fraction;
}

// Field readers. Domain values: Groom=1, Primitive=2, Point=4. Host
// validates domain/size legality; the shader indexes accordingly.
#define FIELD_IDX(domain, curve, point) \
    (((domain) == D_PRIM ? (curve) : ((domain) == D_POINT ? (point) : 0u)))
// General scalar/int reader: literal when hasData==0, else data[domain index].
#define READ_FIELD(field, curve, point, data) \
    (int((field).y) == 0 ? (field).x : (data)[FIELD_IDX(uint((field).z), (curve), (point))])
// Bool reader (enabled/cumulative): Groom or Primitive only, per CUDA ReadBool.
#define READ_BOOL(curve, field, data) \
    (int((field).y) == 0 ? uint((field).x) : (data)[(uint((field).z) == D_PRIM ? (curve) : 0u)])

void main() {
    uint stride = GridStride();
    for (uint curve = gl_GlobalInvocationID.x; curve < push.curveCount; curve += stride) {
        if (status != 0u) continue;
        uint begin = curveOffsets[curve];
        uint end = curveOffsets[curve + 1u];

        bool enabled = READ_BOOL(curve, fields.enabled, enabledData) != 0u;
        uint cumRaw = READ_BOOL(curve, fields.cumulative, cumulativeData);
        if (cumRaw > 1u) { StatusErr(3u); continue; }
        bool cumulative = cumRaw != 0u;
        int seed = READ_FIELD(fields.seed, curve, 0u, seedData);

        uint frameCurve = curve;
        if ((push.flags & FLAG_FRAME_IDS) != 0u) {
            uint tlo = ids[2u * curve], thi = ids[2u * curve + 1u];
            uint lo = 0u, hi = push.frameCount;
            while (lo < hi) {
                uint mid = lo + (hi - lo) / 2u;
                bool lt = frameIds[2u*mid + 1u] < thi ||
                          (frameIds[2u*mid + 1u] == thi && frameIds[2u*mid] < tlo);
                if (lt) lo = mid + 1u; else hi = mid;
            }
            if (lo == push.frameCount ||
                frameIds[2u*lo] != tlo || frameIds[2u*lo+1u] != thi) {
                StatusErr(3u); continue;
            }
            frameCurve = lo;
        }
        vec3 tangent = P3(frameTangent, frameCurve);
        vec3 binormal = P3(frameBinormal, frameCurve);
        vec3 normal = P3(frameNormal, frameCurve);
        vec3 rootRest = P3(rest, begin);
        uvec2 stableId = uvec2(ids[2u * curve], ids[2u * curve + 1u]);
        vec3 hash = vec3(
            Draw01(seed, stableId, SALT_NOISE),
            Draw01(seed, stableId, SALT_NOISE + 1u),
            Draw01(seed, stableId, SALT_NOISE + 2u));
        vec3 running = vec3(0.0);
        vec3 previousOutput = P3(points, begin);
        for (uint point = begin; point < end; ++point) {
            float magnitude = READ_FIELD(fields.magnitude, curve, point, magnitudeData);
            float frequency = READ_FIELD(fields.frequency, curve, point, frequencyData);
            float correlation = READ_FIELD(fields.correlation, curve, point, correlationData);
            int octaves = READ_FIELD(fields.octaves, curve, point, octavesData);
            float lacunarity = READ_FIELD(fields.lacunarity, curve, point, lacunarityData);
            float gain = READ_FIELD(fields.gain, curve, point, gainData);
            float preserve = READ_FIELD(fields.preserveLength, curve, point, preserveLengthData);
            float mask = READ_FIELD(fields.mask, curve, point, maskData);

            if (!Finite(magnitude) || !Finite(frequency) || !Finite(correlation) ||
                !Finite(lacunarity) || !Finite(gain) || !Finite(preserve) ||
                !Finite(mask)) { StatusErr(2u); continue; }
            if (octaves < 1 || octaves > 6 ||
                magnitude < 0.0 || frequency <= 0.0 || correlation < 0.0 ||
                correlation > 1.0 || lacunarity <= 1.0 || gain < 0.0 || gain > 1.0 ||
                preserve < 0.0 || preserve > 1.0 || mask < 0.0 || mask > 1.0) {
                StatusErr(3u); continue;
            }
            float t = ComputeHairT(point, begin, end);
            if (!Finite(t) || t < 0.0 || t > 1.0) {
                StatusErr(Finite(t) ? 3u : 2u); continue;
            }
            float magnitudeRamp = Sample257(t);
            float envelope = mask;
            if (!FiniteD(magnitudeRamp)) { StatusErr(2u); continue; }
            if (envelope < 0.0 || envelope > 1.0) { StatusErr(3u); continue; }
            vec3 src = P3(points, point);
            if (!enabled) {
                outPoints[3u*point] = src.x; outPoints[3u*point+1u] = src.y;
                outPoints[3u*point+2u] = src.z;
                previousOutput = src;
                continue;
            }
            float baseX = rootRest.x * correlation + hash.x * (1.0 - correlation);
            float baseY = rootRest.y * correlation + hash.y * (1.0 - correlation);
            float baseZ = rootRest.z * correlation + hash.z * (1.0 - correlation) + t * frequency;
            vec3 field;
            if (!Vfbm3(baseX, baseY, baseZ, octaves, lacunarity, gain, field)) {
                StatusErr(3u); continue;
            }
            vec3 accumulatedField = field;
            if (cumulative) {
                running = running + field;
                accumulatedField = running;
            }
            if (magnitude == 0.0 || magnitudeRamp == 0.0 || envelope == 0.0) {
                outPoints[3u*point] = src.x; outPoints[3u*point+1u] = src.y;
                outPoints[3u*point+2u] = src.z;
                previousOutput = src;
                continue;
            }
            vec3 displacement = accumulatedField * (magnitude * magnitudeRamp * envelope);
            vec3 worldDisplacement = tangent * displacement.x +
                                     binormal * displacement.y +
                                     normal * displacement.z;
            vec3 displaced = src + worldDisplacement;
            if (!FiniteV3(displaced)) { StatusErr(2u); continue; }
            vec3 restored = displaced;
            if (point > begin && preserve != 0.0) {
                vec3 restP = P3(rest, point);
                vec3 restPrev = P3(rest, point - 1u);
                float restLength = length(restP - restPrev);
                float displacedLength = length(displaced - previousOutput);
                if (!Finite(restLength) || !Finite(displacedLength)) {
                    StatusErr(2u); continue;
                }
                if (restLength == 0.0) restored = previousOutput;
                else if (displacedLength == 0.0) { StatusErr(3u); continue; }
                else restored = previousOutput +
                    (displaced - previousOutput) * (restLength / displacedLength);
            }
            vec3 result = preserve == 0.0 ? displaced :
                displaced * (1.0 - preserve) + restored * preserve;
            if (!FiniteV3(result)) { StatusErr(2u); continue; }
            outPoints[3u*point] = result.x; outPoints[3u*point+1u] = result.y;
            outPoints[3u*point+2u] = result.z;
            previousOutput = result;
        }
    }
}
