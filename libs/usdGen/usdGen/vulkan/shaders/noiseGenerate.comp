// noiseGenerate.comp — Vulkan port of the CUDA noiseNoise kernel (noise.cu).
// One thread per curve; each curve's points are processed sequentially
// (required by the cumulative / preserveLength recurrence). Computes a
// SeExpr-vfbm vector field per point, projects it through the rest root
// frame, scales by magnitude/ramp/envelope, and applies optional length
// preservation.  Mirrors CUDA noise.cu NoiseKernel bit-for-bit (float outer,
// double inner accumulation) so results match the CUDA operator and its
// SeExpr CPU oracle within the documented 2e-3 tolerance.
//
// Error model: the generate dispatch only runs after a synchronous validate
// dispatch proved the inputs clean (status==0). The kernel still guards with
// LoadError so a device-side surprise records the first-writer code without
// touching outputs. Codes match CUDA: 1=BadOffsets, 2=NonFinite, 3=BadValue.
//
// ABI — push constants (std430, 20 bytes):
//   uint curveCount, pointCount, frameCount, offsetsCount, flags
//   flags bit0 = hasHairT, bit1 = hasFrameStableIds
//
// Descriptor bindings (packed float3 planes = scalar float[] 12-byte stride;
// u64 id planes = uint[] little-endian lo/hi):
//   0 points            float[3*pointCount]
//   1 restPoints        float[3*pointCount]
//   2 curveOffsets      uint[curveCount+1]
//   3 stableIds         uint[2*curveCount]
//   4 hairT             float[pointCount]
//   5 frameTangent      float[3*frameCount]
//   6 frameBinormal     float[3*frameCount]
//   7 frameNormal       float[3*frameCount]
//   8 frameStableIds    uint[2*frameCount]
//   9 magnitudeProfile  float[257]
//   10 magnitudeData    float[...]   (field data or empty)
//   11 frequencyData    float[...]
//   12 correlationData  float[...]
//   13 octavesData      int[...]
//   14 lacunarityData   float[...]
//   15 gainData         float[...]
//   16 preserveLengthData float[...]
//   17 maskData         float[...]
//   18 enabledData      uint[...]
//   19 cumulativeData   uint[...]
//   20 seedData         int[...]
//   21 outPoints        float[3*pointCount] OUT
//   22 status           uint OUT
// UBO binding 23: field descriptors {literal, hasData, domain, pad} per field.
// Domain values: Groom=1, Primitive=2, Point=4.

#version 450

layout(local_size_x = 256) in;

layout(std430, binding = 0)  readonly buffer Points    { float points[]; };
layout(std430, binding = 1)  readonly buffer Rest      { float rest[]; };
layout(std430, binding = 2)  readonly buffer Offsets   { uint curveOffsets[]; };
layout(std430, binding = 3)  readonly buffer StableIds { uint ids[]; };
layout(std430, binding = 4)  readonly buffer HairT     { float hairT[]; };
layout(std430, binding = 5)  readonly buffer FrameTan  { float frameTangent[]; };
layout(std430, binding = 6)  readonly buffer FrameBin  { float frameBinormal[]; };
layout(std430, binding = 7)  readonly buffer FrameNrm  { float frameNormal[]; };
layout(std430, binding = 8)  readonly buffer FrameIds  { uint frameIds[]; };
layout(std430, binding = 9)  readonly buffer Profile   { float magnitudeProfile[]; };
layout(std430, binding = 10) readonly buffer MagD      { float magnitudeData[]; };
layout(std430, binding = 11) readonly buffer FreqD     { float frequencyData[]; };
layout(std430, binding = 12) readonly buffer CorrD     { float correlationData[]; };
layout(std430, binding = 13) readonly buffer OctD      { int octavesData[]; };
layout(std430, binding = 14) readonly buffer LacD      { float lacunarityData[]; };
layout(std430, binding = 15) readonly buffer GainD     { float gainData[]; };
layout(std430, binding = 16) readonly buffer PresD     { float preserveLengthData[]; };
layout(std430, binding = 17) readonly buffer MaskD     { float maskData[]; };
layout(std430, binding = 18) readonly buffer EnabD     { uint enabledData[]; };
layout(std430, binding = 19) readonly buffer CumD      { uint cumulativeData[]; };
layout(std430, binding = 20) readonly buffer SeedD     { int seedData[]; };
layout(std430, binding = 21) buffer OutPoints         { float outPoints[]; };
layout(std430, binding = 22) buffer Status            { uint status; };

layout(std140, binding = 23) uniform FieldDescs {
    vec4  magnitude;      // x literal, y hasData, z domain, w pad
    vec4  frequency;
    vec4  correlation;
    ivec4 octaves;        // x literal(int), y hasData, z domain, w pad
    vec4  lacunarity;
    vec4  gain;
    vec4  preserveLength;
    vec4  mask;
    vec4  enabled;
    vec4  cumulative;
    ivec4 seed;
} fields;

layout(push_constant) uniform Push {
    uint curveCount;
    uint pointCount;
    uint frameCount;
    uint offsetsCount;
    uint flags;
} push;

const uint FLAG_HAIR_T    = 1u;
const uint FLAG_FRAME_IDS = 2u;
const uint D_GROOM   = 1u;
const uint D_PRIM    = 2u;
const uint D_POINT   = 4u;
const uint SALT_NOISE = 0x4E01523Eu;

uint GridStride() { return uint(gl_WorkGroupSize.x) * uint(gl_NumWorkGroups.x); }
void StatusErr(uint code) { atomicCompSwap(status, 0u, code); }
bool Finite(float v) { return !(isinf(v) || isnan(v)); }
bool FiniteD(double v) { return !(isinf(v) || isnan(v)); }
bool FiniteV3(vec3 v) { return Finite(v.x) && Finite(v.y) && Finite(v.z); }
#define P3(a, i) vec3((a)[3u*(i)], (a)[3u*(i)+1u], (a)[3u*(i)+2u])


