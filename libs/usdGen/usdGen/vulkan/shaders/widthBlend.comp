#version 450
layout(local_size_x = 256) in;
layout(set=0,binding=0,std430) readonly buffer L { float v[]; } leftWidths;
layout(set=0,binding=1,std430) readonly buffer R { float v[]; } rightWidths;
layout(set=0,binding=2,std430) writeonly buffer O { float v[]; } outputWidths;
layout(set=0,binding=3,std430) buffer S { uint error; } status;
layout(push_constant) uniform C { uint count; float blend; } c;
bool finite(float x) { return !isnan(x) && !isinf(x); }
void main() {
    uint i=gl_GlobalInvocationID.x; if(i>=c.count)return;
    float left=leftWidths.v[i], right=rightWidths.v[i];
    if(!finite(c.blend)||c.blend<0.0||c.blend>1.0||!finite(left)||left<0.0||!finite(right)||right<0.0){atomicOr(status.error,1u);return;}
    if(c.blend==0.0){outputWidths.v[i]=left;return;}
    if(c.blend==1.0){outputWidths.v[i]=right;return;}
    precise float value=left+(right-left)*c.blend;
    if(!finite(value)||value<0.0){atomicOr(status.error,2u);return;}
    outputWidths.v[i]=value;
}
