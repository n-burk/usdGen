// rbfVkRhs.comp — Vulkan port of the CUDA RBF rhsKernel + zeroTail pair
// (rbf.cu:86-92): builds the column-major m x 3 right-hand side
// rhs[i + k*m] = (posed[i] - rest[i]) * invScale with a zero polynomial
// tail, flagging non-finite posed samples via atomicOr.
//
// The host reads the flag back after the fence and rejects NonFiniteInput
// before using the solution, exactly as in CudaRbfBinding::Solve (the
// triangular solve in the same command buffer may still run on the
// uncommitted buffer; its output is discarded on flag).
//
// ABI — descriptors:
//   0 rest  float[3*n]  RO
//   1 posed float[3*n]  RO
//   2 rhs   double[3*m] W (column-major m x 3)
//   3 flag  int[1]      RW (atomicOr, 0 == clean; zero-filled by the host cmd)
//   4 UBO   RbfVkSolveUbo (64 bytes; uses n, m, invScale)
//
// Dispatch: local_size_x=256, groups=ceil(n/256). n >= 4 always (Bind
// rejects smaller counts), so the first group covers the 4-wide tail.

#version 460
layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer Rest  { float rest[]; };
layout(std430, binding = 1) readonly buffer Posed { float posed[]; };
layout(std430, binding = 2) buffer Rhs             { double rhs[]; };
layout(std430, binding = 3) buffer Flag            { int flag; };

layout(std140, binding = 4) uniform Params {
    ivec4  nmc;       // x = n (samples), y = m (n+4), z = count, w = reserved
    double cx;
    double cy;
    double cz;
    double invScale;
    double scale;
    double lambda;    // smoothing (buildMatrix diagonal only)
} params;

bool Finite(float v) { return !(isinf(v) || isnan(v)); }

void main() {
    uint i = gl_GlobalInvocationID.x;
    int n = params.nmc.x;
    int m = params.nmc.y;
    if (i < uint(n)) {
        float ax = rest[3u * i], ay = rest[3u * i + 1u], az = rest[3u * i + 2u];
        float bx = posed[3u * i], by = posed[3u * i + 1u], bz = posed[3u * i + 2u];
        if (!Finite(bx) || !Finite(by) || !Finite(bz)) {
            atomicOr(flag, 1);
        } else {
            rhs[i] = (double(bx) - double(ax)) * params.invScale;
            rhs[i + uint(m)] = (double(by) - double(ay)) * params.invScale;
            rhs[i + 2u * uint(m)] = (double(bz) - double(az)) * params.invScale;
        }
    }
    if (i < 4u) {
        rhs[uint(n) + i] = 0.0;
        rhs[uint(m) + uint(n) + i] = 0.0;
        rhs[2u * uint(m) + uint(n) + i] = 0.0;
    }
}
