#version 450
// CurveGrow: fresh-C3-topology geometry producer, one thread per curve,
// mirroring gpu/curveGrow.cu GrowKernel.  The per-curve target length is
// precomputed host-side (CurveGrowPipeline::BuildTargets) because the device
// was created without shaderFloat64; the shader reads that float32 target
// plane and reproduces CUDA's geometry/frame arithmetic in float32 only.
//
// Descriptor set 0 (std430, geometry planes are flat float v[] with 3*i
// indexing to match packed CUDA float3; uvec2[] matches packed uint64 ids):
//   read: 0 input points     1 input restPoints   2 input widths
//         3 curveOffsets (uint[])   4 stableIds (uvec2[])
//         5 rootPrim (int[])        6 rootUV (float[] 2*c)   7 rootT
//         8 rootB        9 rootN    10 frameStableIds (uvec2[], optional)
//         11 precomputedTargets (float[c])
//   write:12 output points 13 output restPoints 14 output widths 15 hairT
//         16 output offsets (uint[]) 17 output ids (uvec2[]) 18 output rootPrim
//         19 output rootUV 20 output rootT 21 output rootB 22 output rootN
//         23 status (atomic uint, single first-writer atomicCAS per branch)
// Bindings 10, 2 may be size 0 (empty) when absent; the host binds the curve
// offsets buffer there so the descriptor range stays nonzero.
//
// Push constants (13 words, 52 bytes; std430 alignment is 4-byte here):
//   phase u32 (0 grow, 1 validateFrameOrder) curves u32 cvCount u32
//   pointCount u32 hasWidths u32 hasFrames u32 frameCount u32 direction u32
//   lift f32 fallbackWidth f32 litDirX f32 litDirY f32 litDirZ f32
// Workgroup size 256.
layout(local_size_x = 256) in;

layout(set=0,binding=0,std430) readonly buffer IPoints  { float v[]; } inPoints;
layout(set=0,binding=1,std430) readonly buffer IRest    { float v[]; } inRest;
layout(set=0,binding=2,std430) readonly buffer IWidths  { float v[]; } inWidths;
layout(set=0,binding=3,std430) readonly buffer IOffsets { uint v[]; } inOffsets;
layout(set=0,binding=4,std430) readonly buffer IIds     { uvec2 v[]; } inIds;
layout(set=0,binding=5,std430) readonly buffer IPrim    { int v[]; } inPrim;
layout(set=0,binding=6,std430) readonly buffer IUV      { float v[]; } inUV;
layout(set=0,binding=7,std430) readonly buffer IT       { float v[]; } inT;
layout(set=0,binding=8,std430) readonly buffer IB       { float v[]; } inB;
layout(set=0,binding=9,std430) readonly buffer IN       { float v[]; } inN;
layout(set=0,binding=10,std430) readonly buffer IFrame  { uvec2 v[]; } inFrame;
layout(set=0,binding=11,std430) readonly buffer ITarget { float v[]; } inTarget;
layout(set=0,binding=12,std430) buffer OPoints  { float v[]; } outPoints;
layout(set=0,binding=13,std430) buffer ORest    { float v[]; } outRest;
layout(set=0,binding=14,std430) buffer OWidths  { float v[]; } outWidths;
layout(set=0,binding=15,std430) buffer OHairT   { float v[]; } outHairT;
layout(set=0,binding=16,std430) buffer OOffsets { uint v[]; } outOffsets;
layout(set=0,binding=17,std430) buffer OIds     { uvec2 v[]; } outIds;
layout(set=0,binding=18,std430) buffer OPrim    { int v[]; } outPrim;
layout(set=0,binding=19,std430) buffer OUV      { float v[]; } outUV;
layout(set=0,binding=20,std430) buffer OT       { float v[]; } outT;
layout(set=0,binding=21,std430) buffer OB       { float v[]; } outB;
layout(set=0,binding=22,std430) buffer ON       { float v[]; } outN;
layout(set=0,binding=23,std430) buffer Status   { uint err; } status;

layout(push_constant) uniform C {
    uint phase; uint curves; uint cvCount; uint pointCount;
    uint hasWidths; uint hasFrames; uint frameCount; uint direction;
    float lift; float fallbackWidth;
    float litDirX; float litDirY; float litDirZ;
} c;

bool finite(float x) { return !isnan(x) && !isinf(x); }
bool finite3(float x, float y, float z) { return finite(x) && finite(y) && finite(z); }

void fail(uint code) { atomicCompSwap(status.err, 0u, code); }

// CUDA SplitMix64-derived Normalize: dot, then sqrt and per-component
// division (never rsqrt/reciprocal-multiply, which changes oracle bits).
void normalize3(float x, float y, float z, out float ox, out float oy, out float oz) {
    float l2 = x*x + y*y + z*z;
    if (!(l2 > 1.0e-24f) || !finite(l2)) { ox = 0.0; oy = 1.0; oz = 0.0; return; }
    float length = sqrt(l2);
    ox = x/length; oy = y/length; oz = z/length;
}

// CUDA RotateAroundB: axis normalized internally, then Rodrigues.
void rotateAroundB(float dx, float dy, float dz,
                   float ax, float ay, float az, float degrees,
                   out float ox, out float oy, out float oz) {
    if (degrees == 0.0f) { ox = dx; oy = dy; oz = dz; return; }
    float nx, ny, nz; normalize3(ax, ay, az, nx, ny, nz);
    const float pi = 3.14159265358979323846f;
    float radians = degrees * (pi / 180.0f);
    float ccos = cos(radians), ssin = sin(radians);
    float dot = nx*dx + ny*dy + nz*dz;
    float cx = ny*dz - nz*dy;
    float cy = nz*dx - nx*dz;
    float cz = nx*dy - ny*dx;
    float oneMinusC = 1.0f - ccos;
    ox = dx*ccos + cx*ssin + nx*dot*oneMinusC;
    oy = dy*ccos + cy*ssin + ny*dot*oneMinusC;
    oz = dz*ccos + cz*ssin + nz*dot*oneMinusC;
}

// detail::CurveGrowWidthLowerIndex verbatim: clamp before the float cast so a
// rounded-up large last index cannot overflow to 2^32.
uint widthLowerIndex(float u, uint count) {
    float position = u * float(count - 1u);
    return position >= float(count - 1u) ? count - 1u : uint(position);
}

// u64 compare as (hi,lo) — uvec2 is {lo,hi}; matches CUDA uint64 ordering.
bool idLess(uvec2 a, uvec2 b) { return a.y < b.y || (a.y == b.y && a.x < b.x); }
bool idEq(uvec2 a, uvec2 b) { return a.x == b.x && a.y == b.y; }

// FrameIndex: binary search sorted frameStableIds for `stableId`; miss -> 1.
void frameIndex(uvec2 stableId, out uint frame, out bool found) {
    found = true; frame = 0u;
    if (c.hasFrames == 0u) return;
    uint lo = 0u, hi = c.frameCount;
    while (lo < hi) {
        uint mid = lo + (hi - lo) / 2u;
        if (idLess(inFrame.v[mid], stableId)) lo = mid + 1u; else hi = mid;
    }
    if (lo >= c.frameCount || !idEq(inFrame.v[lo], stableId)) { found = false; return; }
    frame = lo;
}

// Phase 0: per-curve geometry resample (GrowKernel).
void grow(uint cid) {
    uint first = inOffsets.v[cid];
    uint last = inOffsets.v[cid + 1u];
    if (first >= last || last > c.pointCount ||
        (cid == 0u && first != 0u) ||
        (cid == c.curves - 1u && last != c.pointCount) ||
        last - first < 2u) { fail(1u); return; }
    for (uint i = first; i < last; ++i) {
        uint p = 3u*i;
        if (!finite3(inPoints.v[p], inPoints.v[p+1u], inPoints.v[p+2u]) ||
            !finite3(inRest.v[p], inRest.v[p+1u], inRest.v[p+2u])) { fail(2u); return; }
        if (c.hasWidths != 0u && (!finite(inWidths.v[i]) || inWidths.v[i] < 0.0)) { fail(2u); return; }
    }
    uvec2 id = inIds.v[cid];
    // CUDA parity (curveGrow.cu:100): unmapped mode indexes frames by the
    // curve ordinal; only mapped mode binary-searches frameStableIds.
    uint frame = cid; bool found = true;
    if (c.hasFrames != 0u) frameIndex(id, frame, found);
    if (!found) { fail(1u); return; }
    uint cr = 3u*first;
    float cx = inPoints.v[cr], cy = inPoints.v[cr+1u], cz = inPoints.v[cr+2u];
    float rx = inRest.v[cr], ry = inRest.v[cr+1u], rz = inRest.v[cr+2u];
    uint tf = 3u*frame;
    float tx = inT.v[tf], ty = inT.v[tf+1u], tz = inT.v[tf+2u];
    float bx = inB.v[tf], by = inB.v[tf+1u], bz = inB.v[tf+2u];
    float nx = inN.v[tf], ny = inN.v[tf+1u], nz = inN.v[tf+2u];
    uint uv = 2u*cid;
    if (!finite3(cx, cy, cz) || !finite3(rx, ry, rz) ||
        !finite3(tx, ty, tz) || !finite3(bx, by, bz) ||
        !finite3(nx, ny, nz) || !finite(inUV.v[uv]) || !finite(inUV.v[uv+1u])) {
        fail(2u); return;
    }
    // Direction selection then normalize + lift about root B.
    float dx = c.direction == 1u ? tx : (c.direction == 2u ? c.litDirX : nx);
    float dy = c.direction == 1u ? ty : (c.direction == 2u ? c.litDirY : ny);
    float dz = c.direction == 1u ? tz : (c.direction == 2u ? c.litDirZ : nz);
    float vx, vy, vz, wx, wy, wz;
    normalize3(dx, dy, dz, vx, vy, vz);
    rotateAroundB(vx, vy, vz, bx, by, bz, c.lift, wx, wy, wz);
    // Target is host-precomputed (CUDA double math lives in BuildTargets).
    float target = inTarget.v[cid];
    if (!finite(target)) { fail(2u); return; }
    uint outputFirst = cid * c.cvCount;
    outOffsets.v[cid] = outputFirst;
    if (cid == c.curves - 1u) outOffsets.v[c.curves] = c.curves * c.cvCount;
    uint inputCount = last - first;
    for (uint i = 0u; i < c.cvCount; ++i) {
        float h = float(i) / float(c.cvCount - 1u);
        float distance = target * h;
        if (!finite(distance)) { fail(2u); return; }
        uint o = 3u*(outputFirst + i);
        float opx = cx + wx*distance, opy = cy + wy*distance, opz = cz + wz*distance;
        float orx = rx + wx*distance, ory = ry + wy*distance, orz = rz + wz*distance;
        if (!finite3(opx, opy, opz) || !finite3(orx, ory, orz)) { fail(2u); return; }
        outPoints.v[o] = opx; outPoints.v[o+1u] = opy; outPoints.v[o+2u] = opz;
        outRest.v[o] = orx; outRest.v[o+1u] = ory; outRest.v[o+2u] = orz;
        if (c.hasWidths != 0u) {
            float position = h * float(inputCount - 1u);
            uint lo = widthLowerIndex(h, inputCount);
            uint hi = min(lo + 1u, inputCount - 1u);
            float a = position - float(lo);
            float w0 = inWidths.v[first + lo];
            float w1 = inWidths.v[first + hi];
            if (!finite(w0) || !finite(w1) || w0 < 0.0 || w1 < 0.0) { fail(2u); return; }
            outWidths.v[outputFirst + i] = w0 + (w1 - w0) * a;
        } else {
            outWidths.v[outputFirst + i] = c.fallbackWidth;
        }
        if (!finite(outWidths.v[outputFirst + i])) { fail(2u); return; }
        outHairT.v[outputFirst + i] = h;
    }
    outIds.v[cid] = id;
    outPrim.v[cid] = inPrim.v[cid];
    outUV.v[2u*cid] = inUV.v[2u*cid]; outUV.v[2u*cid + 1u] = inUV.v[2u*cid + 1u];
    outT.v[3u*cid] = tx; outT.v[3u*cid+1u] = ty; outT.v[3u*cid+2u] = tz;
    outB.v[3u*cid] = bx; outB.v[3u*cid+1u] = by; outB.v[3u*cid+2u] = bz;
    outN.v[3u*cid] = nx; outN.v[3u*cid+1u] = ny; outN.v[3u*cid+2u] = nz;
}

// Phase 1: GPU-side grid validation of a sorted frameStableIds domain
// (ValidateFrameStableIds): ids[i-1] >= ids[i] -> kInvalidTopology(1).
void validateFrameOrder() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= c.frameCount) return;
    if (i != 0u) {
        uvec2 prev = inFrame.v[i - 1u];
        uvec2 cur = inFrame.v[i];
        if (!idLess(prev, cur)) fail(1u);
    }
}

void main() {
    if (c.phase == 0u) {
        uint cid = gl_GlobalInvocationID.x;
        if (cid >= c.curves) return;
        if (status.err != 0u) return;
        grow(cid);
    } else {
        validateFrameOrder();
    }
}