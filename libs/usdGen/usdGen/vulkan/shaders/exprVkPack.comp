#version 450
layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer Slots { uint slots[]; };
layout(std430, binding = 1) writeonly buffer Values { uint values[]; };
layout(push_constant) uniform Controls { uint count; } controls;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i < controls.count) values[i] = slots[2u * i];
}
