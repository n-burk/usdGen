// rbfVkApply.comp — device-solver application. Vulkan port of the CUDA ApplyDeformation kernel
// (deformCurves.cu:74-134). One thread per curve; each curve's points are
// processed sequentially. Blends the input CVs (`src`) toward the RBF-warped
// CVs (`warped`) by a clamped envelope, with optional root-lock correction.
//
// Always writes output[point] (result is initialized to src) so disabled /
// zero-envelope cases are a bitwise input pass-through. Error codes match CUDA:
// 1 = BadOffsets, 2 = NonFinite, 3 = BadValue. Groom + mask envelopes only
// (v1); primitive/point envelopes are the null case (factor 1.0).
//
// ABI — descriptors:
//   0 src        float[3*pointCount] RO
//   1 warped     float[3*pointCount] RO
//   2 offsets    uint[curveCount+1]  RO
//   3 targets    float[3*curveCount] RO
//   4 output     float[3*pointCount] OUT
//   5 maskData   float[...]  RO (fallback 4B buffer when literal)
//   6 enabledData uint[...]  RO (fallback 4B buffer when literal)
//   7 lockData   uint[...]   RO (fallback 4B buffer when literal)
//   8 status     int[1]      OUT (atomicCompSwap first-writer, 0 == clean)
//   9 UBO        Params (std140, 80 bytes)
//
// Dispatch: local_size_x=256, groups=ceil(curveCount/256). Domain codes:
// Groom=1, Primitive=2, Point=4.

#version 460
layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer Src     { float src[]; };
layout(std430, binding = 1) readonly buffer Warped  { float warped[]; };
layout(std430, binding = 2) readonly buffer Offsets { uint offsets[]; };
layout(std430, binding = 3) readonly buffer Targets { float targets[]; };
layout(std430, binding = 4) buffer Out      { float outData[]; };
layout(std430, binding = 5) readonly buffer MaskD   { float maskData[]; };
layout(std430, binding = 6) readonly buffer EnabD   { uint enabledData[]; };
layout(std430, binding = 7) readonly buffer LockD   { uint lockData[]; };
layout(std430, binding = 8) buffer Status           { int status; };

layout(std140, binding = 9) uniform Params {
    uvec3 counts;        // x = curveCount, y = pointCount, z = sampleCount(pad)
    float groomEnvelope;
    vec4  maskF;         // x literal, y hasData, z domain, w pad
    vec4  enabledF;      // x literal, y hasData, z domain, w pad
    vec4  lockF;         // x literal, y hasData, z domain, w pad
    uvec3 fieldCounts;   // x maskCount, y enabledCount, z lockCount
} params;

const uint D_GROOM = 1u, D_PRIM = 2u, D_POINT = 4u;

#define P3(a, i) vec3((a)[3u*(i)], (a)[3u*(i)+1u], (a)[3u*(i)+2u])

bool Finite(float v) { return !(isinf(v) || isnan(v)); }
void StatusErr(int code) { atomicCompSwap(status, 0, code); }

void main() {
    uint curve = gl_GlobalInvocationID.x +
                 gl_GlobalInvocationID.y * gl_NumWorkGroups.x * 256u;
    if (curve >= params.counts.x) return;
    // Canonical endpoints must hold even when every individual span is valid.
    if (offsets[0] != 0u || offsets[params.counts.x] != params.counts.y) {
        StatusErr(1); return;
    }
    uint begin = offsets[curve];
    uint end = offsets[curve + 1u];
    if (begin >= end || end > params.counts.y) { StatusErr(1); return; }

    // enabled is one Groom value shared by every curve.
    uint enabledRaw = (int(params.enabledF.y) != 0) ? enabledData[0] : uint(params.enabledF.x);
    if (enabledRaw > 1u) { StatusErr(3); return; }
    bool groomEnabled = enabledRaw != 0u;

    // Groom lockRoots broadcasts element zero; Primitive indexes the curve.
    uint lockIdx = uint(params.lockF.z) == D_GROOM ? 0u : curve;
    uint lockRaw = (int(params.lockF.y) != 0) ? lockData[lockIdx] : uint(params.lockF.x);
    if (lockRaw > 1u) { StatusErr(3); return; }
    bool lock = lockRaw != 0u;

    vec3 correction = vec3(0.0);
    if (lock) {
        correction = P3(targets, curve) - P3(warped, begin);
        if (!Finite(correction.x) || !Finite(correction.y) || !Finite(correction.z)) {
            StatusErr(2); return;
        }
    }

    for (uint point = begin; point < end; ++point) {
        vec3 s = P3(src, point);
        vec3 w = P3(warped, point);
        if (!Finite(s.x) || !Finite(s.y) || !Finite(s.z) ||
            !Finite(w.x) || !Finite(w.y) || !Finite(w.z)) {
            StatusErr(2); continue;
        }

        uint maskIdx = uint(params.maskF.z) == D_GROOM ? 0u :
                       (uint(params.maskF.z) == D_POINT ? point : curve);
        float maskValue = (int(params.maskF.y) != 0) ? maskData[maskIdx] : params.maskF.x;
        if (!Finite(maskValue)) { StatusErr(2); continue; }
        if (maskValue < 0.0 || maskValue > 1.0) { StatusErr(3); continue; }

        float envelope = params.groomEnvelope * maskValue;
        if (!Finite(envelope)) { StatusErr(2); continue; }
        envelope = clamp(envelope, 0.0, 1.0);

        vec3 result = s;
        if (groomEnabled && envelope > 0.0) {
            vec3 destination = lock ? (w + correction) : w;
            result = s + (destination - s) * envelope;
        }
        if (!Finite(result.x) || !Finite(result.y) || !Finite(result.z)) {
            StatusErr(2); continue;
        }
        outData[3u*point]     = result.x;
        outData[3u*point + 1u] = result.y;
        outData[3u*point + 2u] = result.z;
    }
}
