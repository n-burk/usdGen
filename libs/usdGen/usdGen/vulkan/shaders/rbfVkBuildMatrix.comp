// rbfVkBuildMatrix.comp — Vulkan port of the CUDA RBF buildMatrix kernel
// (rbf.cu:73-85): builds the bordered (n+4)x(n+4) system matrix
// [K P; P^T 0] with K[i,j] = |y_i - y_j|^3 (+ smoothing on the diagonal)
// and P[i] = [1, y_i] in normalized coordinates.
//
// The matrix is ROW-major here (CUDA builds column-major for cuSOLVER);
// the layout is internal to the device solve, whose LU and triangular
// solve shaders share it. Element formulas and evaluation order match
// rbf.cu and deformRbfHost.h exactly.
//
// ABI — descriptors:
//   0 rest   float[3*n]   RO
//   1 matrix double[m*m]  W (row-major)
//   2 UBO    RbfVkSolveUbo (64 bytes; uses n, m, cx, cy, cz, invScale, lambda)
//
// Dispatch: local_size_x=256; groups span x/y within device dispatch limits.

#version 460
layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer Rest   { float rest[]; };
layout(std430, binding = 1) buffer Matrix          { double matrix[]; };

layout(std140, binding = 2) uniform Params {
    ivec4  nmc;       // x = n (samples), y = m (n+4), z = count, w = reserved
    double cx;
    double cy;
    double cz;
    double invScale;
    double scale;
    double lambda;    // smoothing (buildMatrix diagonal only)
} params;

#define P3(a, i) vec3((a)[3u*(i)], (a)[3u*(i)+1u], (a)[3u*(i)+2u])

double Poly(uint i, uint q) {
    vec3 p = P3(rest, i);
    if (q == 0u) return 1.0;
    if (q == 1u) return (double(p.x) - params.cx) * params.invScale;
    if (q == 2u) return (double(p.y) - params.cy) * params.invScale;
    return (double(p.z) - params.cz) * params.invScale;
}

void main() {
    uint k = gl_GlobalInvocationID.x +
             gl_GlobalInvocationID.y * gl_NumWorkGroups.x * 256u;
    int n = params.nmc.x;
    int m = params.nmc.y;
    if (k >= uint(m) * uint(m)) return;
    uint row = k / uint(m), col = k % uint(m); // row-major
    double value = 0.0;
    if (int(row) < n && int(col) < n) {
        vec3 x = P3(rest, row), y = P3(rest, col);
        double dx = (double(x.x) - params.cx) * params.invScale -
                    (double(y.x) - params.cx) * params.invScale;
        double dy = (double(x.y) - params.cy) * params.invScale -
                    (double(y.y) - params.cy) * params.invScale;
        double dz = (double(x.z) - params.cz) * params.invScale -
                    (double(y.z) - params.cz) * params.invScale;
        double r = sqrt(dx * dx + dy * dy + dz * dz);
        value = r * r * r + (row == col ? params.lambda : 0.0);
    } else if (int(row) < n) {
        value = Poly(row, col - uint(n));
    } else if (int(col) < n) {
        value = Poly(col, row - uint(n));
    }
    matrix[k] = value;
}
