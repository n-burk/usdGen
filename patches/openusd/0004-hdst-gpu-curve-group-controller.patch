+//
+// usdGen development extension for OpenUSD
+//
+// Licensed under the terms set forth in the LICENSE.txt file available at
+// https://openusd.org/license.
+//
+#ifndef PXR_IMAGING_HD_ST_BASIS_CURVES_GPU_GROUP_CONTROLLER_H
+#define PXR_IMAGING_HD_ST_BASIS_CURVES_GPU_GROUP_CONTROLLER_H
+
+#include "pxr/pxr.h"
+#include "pxr/imaging/hdSt/api.h"
+#include "pxr/imaging/hdSt/basisCurvesGpuGroupDataSource.h"
+
+#include "pxr/base/tf/token.h"
+#include "pxr/usd/sdf/path.h"
+
+#include <cstdint>
+#include <memory>
+
+PXR_NAMESPACE_OPEN_SCOPE
+
+class HdStResourceRegistry;
+
+/// The terminal control-datasource child name.  A control prim may carry this
+/// opaque datasource without being a renderable prim.
+HDST_API
+TfToken const &HdStGetBasisCurvesGpuGroupDataSourceToken();
+
+/// Render-thread owner for renderer-neutral GPU group requests.  Scene-index
+/// observers may enqueue/remove work concurrently, but all provider Prepare
+/// calls and state transitions occur in Update().  Update uses a finite queue
+/// watermark and publishes exactly one terminal result for every admitted
+/// request at the normal resource-registry Commit boundary.
+class HdStBasisCurvesGpuGroupController final
+{
+public:
+    HDST_API HdStBasisCurvesGpuGroupController();
+    HDST_API ~HdStBasisCurvesGpuGroupController();
+
+    /// Takes an immutable value copy of candidate immediately.  A candidate
+    /// and mailbox must be non-null.  Copy/allocation failure and a stale or
+    /// conflicting ticket are non-admitted cancellation: their incoming
+    /// mailbox is canceled without an acknowledgement or a Commit callback.
+    /// Once admitted, malformed, empty, and Prepare-failed candidates publish
+    /// their sole terminal result only from normal Commit.
+    HDST_API void Enqueue(
+        HdStBasisCurvesGpuGroupCandidateSharedPtr const &candidate,
+        HdStBasisCurvesGpuGroupMailboxSharedPtr const &mailbox);
+
+    /// Cancels every live group at or below prefix on the render thread.
+    /// The removal itself is queued so observer callbacks never touch GPU
+    /// state or renderer-owned maps.
+    HDST_API void RemovePrefix(SdfPath const &prefix);
+
+    /// Drains a finite observer-command watermark and prepares every member
+    /// once for Curves, Hull, and Points.  registrySerial is stable for this
+    /// render-delegate instance and distinguishes a reused registry address.
+    HDST_API void Update(
+        std::shared_ptr<HdStResourceRegistry> const &registry,
+        uint64_t registrySerial);
+
+    /// Cancellation/lifetime boundary used before observer replacement and
+    /// render-delegate teardown.  It invalidates outstanding ready-provider
+    /// identities and makes queued post-Commit work invisible.
+    HDST_API void CancelAll();
+
+private:
+    class _Impl;
+    std::unique_ptr<_Impl> _impl;
+};
+
+PXR_NAMESPACE_CLOSE_SCOPE
+
+#endif // PXR_IMAGING_HD_ST_BASIS_CURVES_GPU_GROUP_CONTROLLER_H
