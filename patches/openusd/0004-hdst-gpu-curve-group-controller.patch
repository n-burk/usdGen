+    _gpuGroupTerminalObserver.reset(new _GpuGroupTerminalObserver(this));
+    _gpuGroupTerminalSceneIndex->AddObserver(
+        HdSceneIndexObserverPtr(_gpuGroupTerminalObserver.get()));
+    // Observers receive only subsequent notices.  Capture pre-existing
+    // controls now; this traversal copies values and performs no GPU work.
+    _gpuGroupTerminalObserver->Scan(*_gpuGroupTerminalSceneIndex,
+                                    SdfPath::AbsoluteRootPath());
