+#include "pxr/pxr.h"
+#include "pxr/imaging/hdSt/basisCurvesGpuGroupMemberDataSource.h"
+
+#include "pxr/imaging/hd/basisCurvesSchema.h"
+#include "pxr/imaging/hd/basisCurvesTopologySchema.h"
+#include "pxr/imaging/hd/dependencySchema.h"
+#include "pxr/imaging/hd/materialBindingSchema.h"
+#include "pxr/imaging/hd/materialBindingsSchema.h"
+#include "pxr/imaging/hd/retainedDataSource.h"
+#include "pxr/imaging/hd/visibilitySchema.h"
+#include "pxr/imaging/hd/xformSchema.h"
+
+#include <vector>
+
+PXR_NAMESPACE_OPEN_SCOPE
+namespace {
+
+template <class T>
+auto _Sample(T const& value)
+    -> decltype(HdRetainedTypedSampledDataSource<T>::New(value)) {
+    return HdRetainedTypedSampledDataSource<T>::New(value);
+}
+
+HdDataSourceBaseHandle _Token(TfToken const& value) { return _Sample(value); }
+
+TfToken _MaterialPurpose(TfToken const& purpose) {
+    return purpose.IsEmpty() || purpose == TfToken("allPurpose")
+        ? HdMaterialBindingsSchemaTokens->allPurpose : purpose;
+}
+
+HdContainerDataSourceHandle _Container(
+    std::vector<TfToken> const& names,
+    std::vector<HdDataSourceBaseHandle> const& values) {
+    return HdRetainedContainerDataSource::New(names.size(), names.data(), values.data());
+}
+
+} // namespace
+
+HdContainerDataSourceHandle HdStBuildBasisCurvesGpuGroupMemberDataSource(
+    HdStBasisCurvesGpuGroupMember::Presentation const& presentation,
+    HdStBasisCurvesGpuReadyProviderHandle const& readyProvider,
+    uint64_t generation) {
+    if (!readyProvider || readyProvider->GetGeneration() != generation ||
+        presentation.refineLevel < 0)
+        return {};
+
+    auto topology = HdBasisCurvesTopologySchema::Builder()
+        .SetType(_Sample(presentation.curveType))
+        .SetBasis(_Sample(presentation.curveBasis))
+        .SetWrap(_Sample(presentation.curveWrap))
+        .Build();
+    auto basisCurves = HdBasisCurvesSchema::Builder().SetTopology(topology).Build();
+    GfRange3d const& localRange = presentation.bounds.GetRange();
+    auto extent = _Container({TfToken("min"), TfToken("max")},
+        {_Sample(localRange.GetMin()), _Sample(localRange.GetMax())});
+    auto xform = HdXformSchema::Builder()
+        .SetMatrix(_Sample(presentation.bounds.GetMatrix()))
+        .SetResetXformStack(_Sample(true))
+        .Build();
+
+    std::vector<TfToken> names{TfToken("basisCurves"), TfToken("extent"),
+        TfToken("xform"), TfToken("hdStBasisCurvesGpu"), TfToken("generation"),
+        TfToken("displayStyle")};
+    std::vector<HdDataSourceBaseHandle> values{basisCurves, extent, xform,
+        readyProvider, _Sample(generation),
+        _Container({TfToken("refineLevel")}, {_Sample(presentation.refineLevel)})};
+    if (!presentation.purpose.IsEmpty()) {
+        names.push_back(TfToken("purpose"));
+        values.push_back(_Container({TfToken("purpose")}, {_Token(presentation.purpose)}));
+    }
+    if (!presentation.visibility.IsEmpty()) {
+        names.push_back(TfToken("visibility"));
+        values.push_back(HdVisibilitySchema::Builder().SetVisibility(
+            _Sample(presentation.visibility != TfToken("invisible"))).Build());
+    }
+    if (!presentation.materialPath.IsEmpty()) {
+        HdDataSourceBaseHandle binding = HdMaterialBindingSchema::Builder().SetPath(
+            _Sample(presentation.materialPath)).Build();
+        names.push_back(TfToken("materialBindings"));
+        values.push_back(_Container({_MaterialPurpose(presentation.materialPurpose)},
+                                    {binding}));
+    }
+    if (!presentation.primOrigin.IsEmpty()) {
+        names.push_back(TfToken("primOrigin"));
+        values.push_back(_Container({TfToken("scenePath")},
+                                    {_Sample(presentation.primOrigin)}));
+    }
+    if (!presentation.dependencySurface.IsEmpty()) {
+        HdDataSourceLocator const points(TfToken("primvars"), TfToken("points"));
+        auto dependency = HdDependencySchema::Builder()
+            .SetDependedOnPrimPath(_Sample(presentation.dependencySurface))
+            .SetDependedOnDataSourceLocator(_Sample(points))
+            .SetAffectedDataSourceLocator(
+                _Sample(HdDataSourceLocator(TfToken("hdStBasisCurvesGpu"))))
+            .Build();
+        names.push_back(TfToken("__dependencies"));
+        values.push_back(_Container({TfToken("usdGenSurface")}, {dependency}));
+    }
+    return _Container(names, values);
+}
+
+PXR_NAMESPACE_CLOSE_SCOPE
