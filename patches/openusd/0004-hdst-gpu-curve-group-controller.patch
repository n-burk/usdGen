+PXR_NAMESPACE_OPEN_SCOPE
+
+// Per-renderer, retained staging boundary for already-prepared curve groups.
+// Controller/GL work remains downstream: this index only overlays its own
+// mailbox-bearing control and publishes complete ready providers on Poll().
+class HdStBasisCurvesGpuGroupStagingSceneIndex final
+    : public HdSingleInputFilteringSceneIndexBase
+{
+public:
+    HDST_API static HdSceneIndexBaseRefPtr New(
+        HdSceneIndexBaseRefPtr const& inputSceneIndex);
