+//
+// usdGen development extension for OpenUSD
+//
+// Licensed under the terms set forth in the LICENSE.txt file available at
+// https://openusd.org/license.
+//
+#include "pxr/pxr.h"
+#include "pxr/imaging/hdSt/basisCurvesGpuGroupController.h"
+
+#include "pxr/imaging/hdSt/resourceRegistry.h"
+
+#include <algorithm>
+#include <atomic>
+#include <map>
+#include <utility>
+#include <vector>
+
+#include <tbb/concurrent_queue.h>
+
+PXR_NAMESPACE_OPEN_SCOPE
+
+namespace {
+
+TfToken const _gpuGroupDataSourceToken("hdStBasisCurvesGpuGroup");
+
+HdStBasisCurvesGpuTopologyModeVector const _allTopologyModes = {
+    HdStBasisCurvesGpuTopologyMode::Curves,
+    HdStBasisCurvesGpuTopologyMode::Hull,
+    HdStBasisCurvesGpuTopologyMode::Points};
+
+HdStBasisCurvesGpuGroupResult
+_RejectedResult(
+    HdStBasisCurvesGpuGroupCandidate const &candidate,
+    HdStBasisCurvesGpuRegistryIdentitySharedPtr const &identity)
+{
+    HdStBasisCurvesGpuGroupResult result;
+    result.groupPath = candidate.groupPath;
+    result.ticket = candidate.ticket;
+    result.generation = candidate.generation;
+    result.registryIdentity = identity;
+    return result;
+}
+
+void
+_CancelMailbox(HdStBasisCurvesGpuGroupMailboxSharedPtr const &mailbox)
+{
+    if (mailbox) {
+        mailbox->Cancel();
+    }
+}
+
+} // anonymous namespace
+
+class HdStBasisCurvesGpuGroupController::_Impl final
+{
+public:
+    struct _State {
+        HdStBasisCurvesGpuGroupCandidateSharedPtr candidate;
+        HdStBasisCurvesGpuGroupMailboxSharedPtr mailbox;
+        HdStBasisCurvesGpuRegistryIdentitySharedPtr identity;
+    };
+
+    struct _Command {
+        enum class _Kind : uint8_t { Enqueue, RemovePrefix } kind;
+        HdStBasisCurvesGpuGroupCandidateSharedPtr candidate;
+        HdStBasisCurvesGpuGroupMailboxSharedPtr mailbox;
+        SdfPath prefix;
+    };
+
+    void Push(_Command command)
+    {
+        _commands.push(std::move(command));
+        // The count is deliberately incremented after push.  Update consumes
+        // at most the count captured at entry, so concurrent observer traffic
+        // cannot make the render-thread drain unbounded.
+        _commandCount.fetch_add(1, std::memory_order_release);
+    }
+
+    void CancelState(_State const &state)
+    {
+        // Replacement/removal stops only a pending result.  An already
+        // accepted ReadyProvider may still be the filter's last-good bundle
+        // while a newer candidate is rejected, so its registry identity must
+        // remain live until the controller's actual teardown boundary.
+        _CancelMailbox(state.mailbox);
+    }
+
+    void CancelPrefix(SdfPath const &prefix)
+    {
+        for (auto it = _states.begin(); it != _states.end();) {
+            if (it->first.HasPrefix(prefix)) {
+                CancelState(it->second);
+                it = _states.erase(it);
+            } else {
+                ++it;
+            }
+        }
+    }
+
+    void CancelEverything()
+    {
+        for (auto const &entry : _states) {
+            CancelState(entry.second);
+        }
+        _states.clear();
+
+        for (std::weak_ptr<HdStBasisCurvesGpuRegistryIdentity> const &weak :
+             _identities) {
+            if (HdStBasisCurvesGpuRegistryIdentitySharedPtr const identity =
+                    weak.lock()) {
+                identity->Invalidate();
+            }
+        }
+        _identities.clear();
+
+        _Command command;
+        while (_commands.try_pop(command)) {
+            if (command.mailbox) {
+                command.mailbox->Cancel();
+            }
+        }
+        _commandCount.store(0, std::memory_order_release);
+    }
+
+    tbb::concurrent_queue<_Command> _commands;
+    std::atomic<size_t> _commandCount{0};
+    std::map<SdfPath, _State> _states;
+    // Older accepted providers can outlive their state-map entry.  Weak
+    // tracking avoids a controller/provider ownership cycle while still
+    // invalidating every identity on terminal/delegate teardown.
+    std::vector<std::weak_ptr<HdStBasisCurvesGpuRegistryIdentity>> _identities;
+};
+
+TfToken const &
+HdStGetBasisCurvesGpuGroupDataSourceToken()
+{
+    return _gpuGroupDataSourceToken;
+}
+
+HdStBasisCurvesGpuGroupController::HdStBasisCurvesGpuGroupController()
+    : _impl(new _Impl)
+{
+}
+
+HdStBasisCurvesGpuGroupController::~HdStBasisCurvesGpuGroupController()
+{
+    CancelAll();
+}
+
+void
+HdStBasisCurvesGpuGroupController::Enqueue(
+    HdStBasisCurvesGpuGroupCandidateSharedPtr const &candidate,
+    HdStBasisCurvesGpuGroupMailboxSharedPtr const &mailbox)
+{
+    if (!candidate || !mailbox) {
+        return;
+    }
+
+    try {
+        // Do not retain a frontend-owned candidate object.  The provider
+        // handle is immutable by contract; all scalar/group state is copied.
+        auto snapshot = std::make_shared<HdStBasisCurvesGpuGroupCandidate>(
+            *candidate);
+        _Impl::_Command command;
+        command.kind = _Impl::_Command::_Kind::Enqueue;
+        command.candidate = std::move(snapshot);
+        command.mailbox = mailbox;
+        _impl->Push(std::move(command));
+    } catch (...) {
+        // A snapshot could not be made, so this request was never admitted.
+        mailbox->Cancel();
+    }
+}
+
+void
+HdStBasisCurvesGpuGroupController::RemovePrefix(SdfPath const &prefix)
+{
+    if (prefix.IsEmpty()) {
+        return;
+    }
+    _Impl::_Command command;
+    command.kind = _Impl::_Command::_Kind::RemovePrefix;
+    command.prefix = prefix;
+    _impl->Push(std::move(command));
+}
+
+void
+HdStBasisCurvesGpuGroupController::Update(
+    std::shared_ptr<HdStResourceRegistry> const &registry,
+    uint64_t const registrySerial)
+{
+    // One exchange is the finite watermark.  A producer can either contribute
+    // to this pass or a later pass; it cannot extend this pass indefinitely.
+    size_t const commandLimit =
+        _impl->_commandCount.exchange(0, std::memory_order_acq_rel);
+    _impl->_identities.erase(
+        std::remove_if(_impl->_identities.begin(), _impl->_identities.end(),
+            [](std::weak_ptr<HdStBasisCurvesGpuRegistryIdentity> const &weak) {
+                return weak.expired();
+            }),
+        _impl->_identities.end());
+    for (size_t i = 0; i != commandLimit; ++i) {
+        _Impl::_Command command;
+        if (!_impl->_commands.try_pop(command)) {
+            // A producer can publish to the queue just before it increments
+            // the count.  Retain every unclaimed slot for a later Update
+            // rather than losing part of this finite watermark.
+            _impl->_commandCount.fetch_add(commandLimit - i,
+                                           std::memory_order_release);
+            break;
+        }
+        if (command.kind == _Impl::_Command::_Kind::RemovePrefix) {
+            _impl->CancelPrefix(command.prefix);
+            continue;
+        }
+
+        HdStBasisCurvesGpuGroupCandidateSharedPtr const &candidate =
+            command.candidate;
+        HdStBasisCurvesGpuGroupMailboxSharedPtr const &mailbox = command.mailbox;
+        if (!candidate || !mailbox || mailbox->IsCanceled()) {
+            continue;
+        }
+
+        // Registry availability/identity is an admission precondition.  Do
+        // not supersede the last accepted state with a request which cannot
+        // ever reach the normal Commit boundary.
+        if (!registry || registrySerial == 0) {
+            mailbox->Cancel();
+            continue;
+        }
+
+        auto current = _impl->_states.find(candidate->groupPath);
+        if (current != _impl->_states.end()) {
+            uint64_t const currentTicket = current->second.candidate->ticket;
+            if (candidate->ticket == currentTicket &&
+                mailbox == current->second.mailbox) {
+                continue;
+            }
+            if (candidate->ticket <= currentTicket) {
+                // The conflicting request was never admitted; preserve the
+                // current group and make its incoming mailbox invisible.
+                mailbox->Cancel();
+                continue;
+            }
+        }
+
+        _Impl::_State state;
+        state.candidate = candidate;
+        state.mailbox = mailbox;
+        try {
+            std::shared_ptr<void const> registryLease(registry, registry.get());
+            state.identity = std::make_shared<HdStBasisCurvesGpuRegistryIdentity>(
+                registry.get(), registrySerial,
+                std::weak_ptr<void const>(registryLease));
+            _impl->_identities.push_back(state.identity);
+        } catch (...) {
+            // Identity bookkeeping is part of admission: no later callback
+            // can safely publish this request if it failed.
+            mailbox->Cancel();
+            continue;
+        }
+
+        std::vector<HdStBasisCurvesGpuGroupPreparedMember> prepared;
+        bool const canPrepare =
+            HdStValidateBasisCurvesGpuGroupCandidate(*candidate) &&
+            bool(state.identity);
+        bool prepareFailed = !canPrepare;
+        if (canPrepare) {
+            try {
+                prepared.reserve(candidate->members.size());
+            } catch (...) {
+                prepareFailed = true;
+            }
+        }
+        for (HdStBasisCurvesGpuGroupMember const &member : candidate->members) {
+            HdStBasisCurvesGpuGroupPreparedMember entry;
+            entry.id = member.id;
+            // Keep preparing subsequent members after a failure: a group
+            // preparation always invokes each valid member exactly once, so
+            // hidden members cannot be deferred by an earlier failure.
+            if (canPrepare && member.provider) {
+                HdStBasisCurvesGpuPrepareRequest request;
+                request.rprimId = member.rprimPath;
+                request.topologyModes = _allTopologyModes;
+                try {
+                    entry.bundle = member.provider->Prepare(registry.get(), request);
+                } catch (...) {
+                    prepareFailed = true;
+                }
+                if (!entry.bundle ||
+                    !entry.bundle->IsCompleteFor(_allTopologyModes)) {
+                    prepareFailed = true;
+                }
+            } else {
+                prepareFailed = true;
+            }
+            try {
+                prepared.push_back(std::move(entry));
+            } catch (...) {
+                prepareFailed = true;
+            }
+        }
+
+        // A request, including an empty or failed one, has exactly one normal
+        // Commit-boundary result.  The closure never captures the controller,
+        // delegate, registry, rprims, or mutable scene-index data.
+        try {
+            registry->AddPostCommitCallback(
+                [candidate, mailbox, identity = state.identity,
+                 prepared = std::move(prepared), prepareFailed]() mutable {
+                    if (!mailbox || mailbox->IsCanceled()) {
+                        return;
+                    }
+                    if (!identity || !identity->IsLive()) {
+                        mailbox->Cancel();
+                        return;
+                    }
+                    if (prepareFailed) {
+                        mailbox->Post(_RejectedResult(*candidate, identity));
+                        return;
+                    }
+                    mailbox->Post(HdStMakeBasisCurvesGpuGroupReadyResult(
+                        *candidate, identity, prepared));
+                });
+        } catch (...) {
+            // Callback registration failed before Commit, so this candidate
+            // was not admitted and cannot receive a terminal ACK.
+            mailbox->Cancel();
+            continue;
+        }
+
+        // Commit registration is the final admission step.  Only now may a
+        // newer request cancel the previous mailbox: an allocation failure
+        // above leaves the old accepted provider/state intact.
+        if (current != _impl->_states.end()) {
+            _impl->CancelState(current->second);
+            current->second = std::move(state);
+        } else {
+            try {
+                _impl->_states.emplace(candidate->groupPath, std::move(state));
+            } catch (...) {
+                // The callback is already queued but observes cancellation;
+                // no result can escape without controller-owned state.
+                mailbox->Cancel();
+            }
+        }
+    }
+}
+
+void
+HdStBasisCurvesGpuGroupController::CancelAll()
+{
+    _impl->CancelEverything();
+}
+
+PXR_NAMESPACE_CLOSE_SCOPE
