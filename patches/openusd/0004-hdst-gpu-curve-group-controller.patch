+HdStBasisCurvesGpuGroupStagingSceneIndex::HdStBasisCurvesGpuGroupStagingSceneIndex(
+    HdSceneIndexBaseRefPtr const& input)
+    : HdSingleInputFilteringSceneIndexBase(input) {
+    auto initial = std::make_shared<_Snapshot const>();
+    std::atomic_store(&_visible, initial);
+    _working = std::move(initial);
+}
+
+HdStBasisCurvesGpuGroupStagingSceneIndex::~HdStBasisCurvesGpuGroupStagingSceneIndex() {
+    for (auto const& entry : _active) if (entry.second.mailbox) entry.second.mailbox->Cancel();
+}
+
+HdSceneIndexBaseRefPtr HdStBasisCurvesGpuGroupStagingSceneIndex::New(
+    HdSceneIndexBaseRefPtr const& input) {
+    auto result = TfCreateRefPtr(new HdStBasisCurvesGpuGroupStagingSceneIndex(input));
+    result->_self = TfCreateWeakPtr(result.operator->());
+    std::vector<SdfPath> stack{SdfPath::AbsoluteRootPath()};
+    while (!stack.empty()) {
+        SdfPath path = stack.back(); stack.pop_back();
+        result->_CaptureControl(path);
+        auto children = result->_GetInputSceneIndex()->GetChildPrimPaths(path);
+        stack.insert(stack.end(), children.begin(), children.end());
+    }
+    result->_DrainPackets();
+    return result;
+}
+
+std::shared_ptr<HdStBasisCurvesGpuGroupStagingSceneIndex::_Snapshot const>
+HdStBasisCurvesGpuGroupStagingSceneIndex::_Visible() const {
+    return std::atomic_load(&_visible);
+}
+
+std::shared_ptr<HdStBasisCurvesGpuGroupStagingSceneIndex::_Snapshot const>
+HdStBasisCurvesGpuGroupStagingSceneIndex::_Working() const {
+    return _working ? _working : _Visible();
+}
+
+bool HdStBasisCurvesGpuGroupStagingSceneIndex::_CaptureControl(SdfPath const& scope) {
+    auto input = _GetInputSceneIndex();
+    auto prim = input->GetPrim(scope);
+    auto control = HdStBasisCurvesGpuGroupDataSource::Cast(
+        prim.dataSource ? prim.dataSource->Get(HdStGetBasisCurvesGpuGroupDataSourceToken()) : nullptr);
+    if (!control) return false;
+    auto upstream = control->GetCandidate();
+    // A recognized control resync must not be mistaken for an authored CPU
+    // prim transition, even if its candidate is stale or malformed.
+    if (!upstream || upstream->groupPath != scope ||
+        !HdStValidateBasisCurvesGpuGroupCandidate(*upstream)) return true;
+    auto candidate = std::make_shared<HdStBasisCurvesGpuGroupCandidate const>(*upstream);
+    for (auto const& active : _active) {
+        if (active.first != scope && _Intersects(active.first, scope)) return false;
+    }
+    auto visible = _Working();
+    for (auto const& group : visible->groups) {
+        if (group.first != scope && _Intersects(group.first, scope)) return false;
+    }
+    for (auto const& member : candidate->members) {
+        auto existing = input->GetPrim(member.rprimPath);
+        if (existing.dataSource || !existing.primType.IsEmpty()) return false;
+    }
+    auto old = _active.find(scope);
+    if (old != _active.end()) {
+        if (_SameCandidate(*old->second.candidate, *candidate)) return true;
+        if (candidate->ticket <= old->second.candidate->ticket) return true;
+        if (old->second.mailbox) old->second.mailbox->Cancel();
+    }
+    _Active active{candidate, std::make_shared<HdStBasisCurvesGpuGroupMailbox>(), false};
+    _active[scope] = active;
+    auto next = std::make_shared<_Snapshot>(*_Working());
+    next->controls[scope] = std::move(active);
+    _QueueSnapshot(std::shared_ptr<_Snapshot const>(std::move(next)), {}, {}, {});
+    return true;
+}
+
+void HdStBasisCurvesGpuGroupStagingSceneIndex::_QueueSnapshot(
+    std::shared_ptr<_Snapshot const> snapshot,
+    HdSceneIndexObserver::RemovedPrimEntries removed,
+    HdSceneIndexObserver::AddedPrimEntries added,
+    HdSceneIndexObserver::DirtiedPrimEntries dirtied,
+    std::function<bool()> admission) {
+    _packets.push_back({std::move(snapshot), std::move(removed), std::move(added),
+                        std::move(dirtied), std::move(admission)});
+    _working = _packets.back().snapshot;
+}
+
+void HdStBasisCurvesGpuGroupStagingSceneIndex::_DrainPackets() {
+    if (_dispatching) { _deferredDrain = true; return; }
+    auto self = TfCreateRefPtrFromProtectedWeakPtr(_self);
+    if (!self) return;
+    _dispatching = true;
+    auto resetDispatch = [this] {
+        _dispatching = false;
+        if (_packets.empty()) _working = _Visible();
+    };
+    try {
+        do {
+            _deferredDrain = false;
+            while (!_packets.empty()) {
+                _Packet packet = std::move(_packets.front()); _packets.pop_front();
+                if (packet.admission && !packet.admission()) continue;
+                std::atomic_store(&_visible, packet.snapshot);
+                try { if (!packet.removed.empty()) _SendPrimsRemoved(packet.removed); }
+                catch (...) { TF_WARN("HdSt GPU group removal observer threw; ignoring it"); }
+                try { if (!packet.added.empty()) _SendPrimsAdded(packet.added); }
+                catch (...) { TF_WARN("HdSt GPU group addition observer threw; ignoring it"); }
+                try { if (!packet.dirtied.empty()) _SendPrimsDirtied(packet.dirtied); }
+                catch (...) { TF_WARN("HdSt GPU group dirty observer threw; ignoring it"); }
+            }
+            // Poll requests made from an observer are delayed until the current
+            // immutable packet has completed.  Therefore a ready admission can
+            // be checked at dispatch before any later packet is based on it.
+            if (_pollPending) {
+                _pollPending = false;
+                _PollReadyResults();
+            }
+        } while (_deferredDrain || !_packets.empty() || _pollPending);
+    } catch (...) {
+        resetDispatch();
+        throw;
+    }
+    resetDispatch();
+}
+
+void HdStBasisCurvesGpuGroupStagingSceneIndex::Poll() {
+    auto self = TfCreateRefPtrFromProtectedWeakPtr(_self);
+    if (!self) return;
+    if (_dispatching) { _pollPending = true; return; }
+    _PollReadyResults();
+    _DrainPackets();
+}
+
+void HdStBasisCurvesGpuGroupStagingSceneIndex::_PollReadyResults() {
+    auto next = std::make_shared<_Snapshot>(*_Working());
+    HdSceneIndexObserver::RemovedPrimEntries removed;
+    HdSceneIndexObserver::AddedPrimEntries added;
+    using _Admission = std::pair<HdStBasisCurvesGpuGroupCandidateSharedPtr,
+                                 HdStBasisCurvesGpuGroupResult>;
+    auto admissions = std::make_shared<std::vector<_Admission>>();
+    bool changed = false;
+    for (auto& entry : _active) {
+        HdStBasisCurvesGpuGroupResult result;
+        if (entry.second.terminalConsumed || !entry.second.mailbox ||
+            !entry.second.mailbox->TryPop(&result)) continue;
+        auto const& candidate = entry.second.candidate;
+        // Matching terminal messages are one-shot even when malformed or
+        // rejected.  Nonmatching stale messages do not consume the current
+        // candidate, so a controller's current result can still arrive.
+        bool const matching = candidate && result.groupPath == entry.first &&
+            result.ticket == candidate->ticket && result.generation == candidate->generation;
+        if (matching) {
+            entry.second.terminalConsumed = true;
+            entry.second.mailbox->Cancel();
+        }
+        if (!candidate || result.status != HdStBasisCurvesGpuGroupResultStatus::Ready ||
+            !matching || !result.registryIdentity ||
+            !result.registryIdentity->IsLive() || result.providers.size() != candidate->members.size())
+            continue;
+        // Build against a trial snapshot.  A malformed or cross-registry
+        // result must leave the last accepted group (and its notices) intact.
+        auto trial = std::make_shared<_Snapshot>(*next);
+        HdSceneIndexObserver::RemovedPrimEntries trialRemoved;
+        HdSceneIndexObserver::AddedPrimEntries trialAdded;
+        auto found = trial->groups.find(entry.first);
+        if (found != trial->groups.end()) {
+            for (auto const& path : found->second) {
+                trial->tiles.erase(path); trialRemoved.emplace_back(path);
+            }
+            trial->groups.erase(found);
+        }
+        std::set<SdfPath> claimed;
+        bool valid = true;
+        for (size_t i = 0; i != candidate->members.size(); ++i) {
+            auto const& member = candidate->members[i];
+            auto const& provider = result.providers[i];
+            if (!provider || provider->GetTicket() != candidate->ticket ||
+                provider->GetGeneration() != result.generation ||
+                provider->GetRprimPath() != member.rprimPath ||
+                provider->GetRegistryIdentity() != result.registryIdentity ||
+                !provider->GetRegistryIdentity() || !provider->GetRegistryIdentity()->IsLive() ||
+                !claimed.insert(member.rprimPath).second || trial->tiles.count(member.rprimPath)) {
+                valid = false; break;
+            }
+            auto data = HdStBuildBasisCurvesGpuGroupMemberDataSource(
+                member.presentation, provider, result.generation);
+            if (!data) { valid = false; break; }
+            trial->tiles.emplace(member.rprimPath, data);
+            trialAdded.emplace_back(member.rprimPath, TfToken("basisCurves"));
+        }
+        if (!valid) continue;
+        // Check the identity once more immediately before accepting this
+        // immutable trial; _DrainPackets repeats it before visible install.
+        if (!result.registryIdentity->IsLive()) continue;
+        for (auto const& provider : result.providers) {
+            if (!provider || provider->GetTicket() != candidate->ticket ||
+                provider->GetGeneration() != result.generation ||
+                provider->GetRegistryIdentity() != result.registryIdentity ||
+                !provider->GetRegistryIdentity()->IsLive()) {
+                valid = false; break;
+            }
+        }
+        if (!valid) continue;
+        trial->groups[entry.first] = std::move(claimed);
+        next = std::move(trial);
+        removed.insert(removed.end(), trialRemoved.begin(), trialRemoved.end());
+        added.insert(added.end(), trialAdded.begin(), trialAdded.end());
+        admissions->emplace_back(candidate, result);
+        changed = true;
+    }
+    if (changed) {
+        std::set<SdfPath> const previousParents = next->syntheticParents;
+        _RebuildSyntheticParents(next->tiles, next->groups, &next->syntheticParents);
+        for (auto const& parent : previousParents)
+            if (!next->syntheticParents.count(parent)) removed.emplace_back(parent);
+        for (auto const& parent : next->syntheticParents)
+            if (!previousParents.count(parent)) added.emplace_back(parent, TfToken("scope"));
+        // Registry invalidation can race queued observer callbacks.  Do not
+        // install a packet unless every newly-ready provider still exactly
+        // belongs to its candidate and live registry.
+        auto admission = [admissions]() {
+            for (auto const& item : *admissions) {
+                auto const& candidate = item.first;
+                auto const& result = item.second;
+                if (!candidate || !result.registryIdentity ||
+                    !result.registryIdentity->IsLive() ||
+                    result.ticket != candidate->ticket ||
+                    result.generation != candidate->generation ||
+                    result.providers.size() != candidate->members.size()) return false;
+                for (size_t i = 0; i != result.providers.size(); ++i) {
+                    auto const& provider = result.providers[i];
+                    if (!provider || provider->GetTicket() != result.ticket ||
+                        provider->GetGeneration() != result.generation ||
+                        provider->GetRprimPath() != candidate->members[i].rprimPath ||
+                        provider->GetRegistryIdentity() != result.registryIdentity ||
+                        !provider->GetRegistryIdentity() ||
+                        !provider->GetRegistryIdentity()->IsLive()) return false;
+                }
+            }
+            return true;
+        };
+        _QueueSnapshot(std::shared_ptr<_Snapshot const>(std::move(next)),
+                       std::move(removed), std::move(added), {}, std::move(admission));
+    }
+}
+
+void HdStBasisCurvesGpuGroupStagingSceneIndex::_RemoveScopes(SdfPath const& prefix) {
+    std::set<SdfPath> canceledPendingScopes;
+    std::set<SdfPath> removedAcceptedScopes;
+    for (auto const& entry : _active) {
+        // A member-path removal can cancel a pending replacement without
+        // removing the older accepted group at the enclosing control scope.
+        bool remove = entry.first.HasPrefix(prefix);
+        if (entry.second.candidate)
+            for (auto const& member : entry.second.candidate->members)
+                remove = remove || member.rprimPath.HasPrefix(prefix);
+        if (remove) canceledPendingScopes.insert(entry.first);
+    }
+    for (auto const& entry : _Working()->groups) {
+        if (entry.first.HasPrefix(prefix)) removedAcceptedScopes.insert(entry.first);
+    }
+    for (auto it = _active.begin(); it != _active.end();) {
+        if (canceledPendingScopes.count(it->first) ||
+            removedAcceptedScopes.count(it->first)) {
+            if (it->second.mailbox) it->second.mailbox->Cancel(); it = _active.erase(it);
+        }
+        else ++it;
+    }
+    auto old = _Working(); auto next = std::make_shared<_Snapshot>(*old);
+    for (auto it = next->controls.begin(); it != next->controls.end();) {
+        if (canceledPendingScopes.count(it->first) ||
+            removedAcceptedScopes.count(it->first)) it = next->controls.erase(it); else ++it;
+    }
+    HdSceneIndexObserver::RemovedPrimEntries removed;
+    for (auto it = next->groups.begin(); it != next->groups.end();) {
+        if (removedAcceptedScopes.count(it->first)) {
+            for (auto const& path : it->second) { next->tiles.erase(path); removed.emplace_back(path); }
+            it = next->groups.erase(it);
+        } else ++it;
+    }
+    std::set<SdfPath> const oldParents = next->syntheticParents;
+    _RebuildSyntheticParents(next->tiles, next->groups, &next->syntheticParents);
+    for (auto const& parent : oldParents)
+        if (!next->syntheticParents.count(parent)) removed.emplace_back(parent);
+    if (next != old)
+        _QueueSnapshot(std::shared_ptr<_Snapshot const>(std::move(next)),
+                       std::move(removed), {}, {});
+}
+
+HdSceneIndexPrim HdStBasisCurvesGpuGroupStagingSceneIndex::GetPrim(SdfPath const& path) const {
+    auto input = _GetInputSceneIndex(); auto authored = input->GetPrim(path);
+    auto snapshot = _Visible();
+    auto active = snapshot->controls.find(path);
+    if (active != snapshot->controls.end()) {
+        auto data = _OverlayControl(authored.dataSource, HdStGetBasisCurvesGpuGroupDataSourceToken(),
+            active->second.candidate, active->second.mailbox);
+        if (data) return {authored.primType.IsEmpty() ? TfToken("scope") : authored.primType, data};
+    }
+    auto tile = snapshot->tiles.find(path);
+    if (tile != snapshot->tiles.end()) return {TfToken("basisCurves"), tile->second};
+    if (snapshot->syntheticParents.count(path) && authored.primType.IsEmpty() && !authored.dataSource)
+        return {TfToken("scope"), HdRetainedContainerDataSource::New()};
+    return authored;
+}
+
+SdfPathVector HdStBasisCurvesGpuGroupStagingSceneIndex::GetChildPrimPaths(SdfPath const& path) const {
+    auto result = _GetInputSceneIndex()->GetChildPrimPaths(path);
+    auto append = [&](SdfPath const& child) {
+        if (std::find(result.begin(), result.end(), child) == result.end()) result.push_back(child);
+    };
+    auto snapshot = _Visible();
+    for (auto const& tile : snapshot->tiles) if (tile.first.GetParentPath() == path) append(tile.first);
+    for (auto const& parent : snapshot->syntheticParents)
+        if (parent.GetParentPath() == path) append(parent);
+    return result;
+}
+
+void HdStBasisCurvesGpuGroupStagingSceneIndex::_PrimsAdded(
+    HdSceneIndexBase const&, HdSceneIndexObserver::AddedPrimEntries const& entries) {
+    auto self = TfCreateRefPtrFromProtectedWeakPtr(_self);
+    if (!self) return;
+    for (auto const& entry : entries) {
+        // Control resyncs carry only a candidate.  They retain the last good
+        // accepted subtree while their replacement waits in the new mailbox.
+        if (_CaptureControl(entry.primPath)) continue;
+        // A CPU/backend transition at a claimed member path wins immediately;
+        // never hide a newly-authored upstream prim behind an old GPU tile.
+        std::vector<SdfPath> conflicts;
+        for (auto const& group : _Working()->groups)
+            for (auto const& member : group.second)
+                if (_Intersects(entry.primPath, member)) { conflicts.push_back(group.first); break; }
+        for (auto const& group : conflicts) _RemoveScopes(group);
+    }
+    _QueueSnapshot(_Working(), {}, entries, {});
+    _DrainPackets();
+}
+void HdStBasisCurvesGpuGroupStagingSceneIndex::_PrimsRemoved(
+    HdSceneIndexBase const&, HdSceneIndexObserver::RemovedPrimEntries const& entries) {
+    auto self = TfCreateRefPtrFromProtectedWeakPtr(_self);
+    if (!self) return;
+    for (auto const& entry : entries) _RemoveScopes(entry.primPath);
+    // An upstream removal can target a pending member (or an input-side path
+    // colliding with a retained synthetic parent).  Never forward a subtree
+    // removal that would make downstream consumers delete still-visible tiles.
+    HdSceneIndexObserver::RemovedPrimEntries forwarded;
+    auto snapshot = _Working();
+    for (auto const& entry : entries) {
+        bool retainedBelow = false;
+        for (auto const& tile : snapshot->tiles)
+            retainedBelow = retainedBelow || tile.first.HasPrefix(entry.primPath);
+        for (auto const& parent : snapshot->syntheticParents)
+            retainedBelow = retainedBelow || parent.HasPrefix(entry.primPath);
+        if (!retainedBelow) forwarded.push_back(entry);
+    }
+    _QueueSnapshot(snapshot, std::move(forwarded), {}, {});
+    _DrainPackets();
+}
+void HdStBasisCurvesGpuGroupStagingSceneIndex::_PrimsDirtied(
+    HdSceneIndexBase const&, HdSceneIndexObserver::DirtiedPrimEntries const& entries) {
+    auto self = TfCreateRefPtrFromProtectedWeakPtr(_self);
+    if (!self) return;
+    for (auto const& entry : entries) _CaptureControl(entry.primPath);
+    _QueueSnapshot(_Working(), {}, {}, entries);
+    _DrainPackets();
+}
+void HdStBasisCurvesGpuGroupStagingSceneIndex::_PrimsRenamed(
+    HdSceneIndexBase const& sender, HdSceneIndexObserver::RenamedPrimEntries const& entries) {
+    auto self = TfCreateRefPtrFromProtectedWeakPtr(_self);
+    if (!self) return;
+    HdSceneIndexObserver::RemovedPrimEntries removed; HdSceneIndexObserver::AddedPrimEntries added;
+    HdSceneIndexObserver::ConvertPrimsRenamedToRemovedAndAdded(sender, entries, &removed, &added);
+    _PrimsRemoved(sender, removed); _PrimsAdded(sender, added);
+}
+void HdStBasisCurvesGpuGroupStagingSceneIndex::_SystemMessage(
+    TfToken const& type, HdDataSourceBaseHandle const&) {
+    auto self = TfCreateRefPtrFromProtectedWeakPtr(_self);
+    if (!self) return;
+    if (type == HdSystemMessageTokens->asyncAllow) { _asyncAllowed = true; return; }
+    if (type == HdSystemMessageTokens->asyncPoll && _asyncAllowed) Poll();
+}
