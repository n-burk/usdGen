+#ifndef PXR_IMAGING_HD_ST_BASIS_CURVES_GPU_GROUP_STAGING_SCENE_INDEX_H
+#define PXR_IMAGING_HD_ST_BASIS_CURVES_GPU_GROUP_STAGING_SCENE_INDEX_H
+
