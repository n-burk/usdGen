+void
+HdStRenderDelegate::SetTerminalSceneIndex(
+    HdSceneIndexBaseRefPtr const &terminalSceneIndex)
+{
+    if (_gpuGroupTerminalSceneIndex && _gpuGroupTerminalObserver) {
+        _gpuGroupTerminalSceneIndex->RemoveObserver(
+            HdSceneIndexObserverPtr(_gpuGroupTerminalObserver.get()));
+    }
+    _gpuGroupTerminalObserver.reset();
+    _gpuGroupTerminalSceneIndex.Reset();
+    if (_gpuGroupController) {
+        _gpuGroupController->CancelAll();
+    }
