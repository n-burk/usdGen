+class _Control final : public HdStBasisCurvesGpuGroupDataSource {
+public:
+    HD_DECLARE_DATASOURCE(_Control);
+    static Handle Make(HdStBasisCurvesGpuGroupCandidateSharedPtr const& candidate,
+                       HdStBasisCurvesGpuGroupMailboxSharedPtr const& mailbox) {
+        return candidate && mailbox ? _Control::New(candidate, mailbox) : Handle{};
+    }
+    HdStBasisCurvesGpuGroupCandidateSharedPtr GetCandidate() const override {
+        return _candidate;
+    }
+    HdStBasisCurvesGpuGroupMailboxSharedPtr GetMailbox() const override {
+        return _mailbox;
+    }
+private:
+    _Control(HdStBasisCurvesGpuGroupCandidateSharedPtr const& candidate,
+             HdStBasisCurvesGpuGroupMailboxSharedPtr const& mailbox)
+        : _candidate(candidate), _mailbox(mailbox) {}
+    HdStBasisCurvesGpuGroupCandidateSharedPtr const _candidate;
+    HdStBasisCurvesGpuGroupMailboxSharedPtr const _mailbox;
+};
+
+HdContainerDataSourceHandle _OverlayControl(
+    HdContainerDataSourceHandle const& base, TfToken const& token,
+    HdStBasisCurvesGpuGroupCandidateSharedPtr const& candidate,
+    HdStBasisCurvesGpuGroupMailboxSharedPtr const& mailbox) {
+    auto control = _Control::Make(candidate, mailbox);
+    if (!control) return {};
+    HdDataSourceBaseHandle const value = control;
+    auto overlay = HdRetainedContainerDataSource::New(1, &token, &value);
+    return HdOverlayContainerDataSource::New(overlay, base);
+}
+
+bool _Intersects(SdfPath const& a, SdfPath const& b) {
+    return a.HasPrefix(b) || b.HasPrefix(a);
+}
+
+bool _SamePresentation(HdStBasisCurvesGpuGroupMember::Presentation const& a,
+                       HdStBasisCurvesGpuGroupMember::Presentation const& b) {
+    return a.curveType == b.curveType && a.curveBasis == b.curveBasis &&
+        a.curveWrap == b.curveWrap && a.bounds.GetRange() == b.bounds.GetRange() &&
+        a.bounds.GetMatrix() == b.bounds.GetMatrix() &&
+        a.refineLevel == b.refineLevel && a.purpose == b.purpose &&
+        a.visibility == b.visibility && a.materialPath == b.materialPath &&
+        a.materialPurpose == b.materialPurpose && a.primOrigin == b.primOrigin &&
+        a.dependencySurface == b.dependencySurface;
+}
+
+bool _SameCandidate(HdStBasisCurvesGpuGroupCandidate const& a,
+                    HdStBasisCurvesGpuGroupCandidate const& b) {
+    if (a.groupPath != b.groupPath || a.ticket != b.ticket ||
+        a.generation != b.generation || a.members.size() != b.members.size()) return false;
+    for (size_t i = 0; i != a.members.size(); ++i)
+        if (a.members[i].id != b.members[i].id ||
+            a.members[i].rprimPath != b.members[i].rprimPath ||
+            !_SamePresentation(a.members[i].presentation, b.members[i].presentation)) return false;
+    return true;
+}
+
+void _RebuildSyntheticParents(
+    std::map<SdfPath, HdContainerDataSourceHandle> const& tiles,
+    std::map<SdfPath, std::set<SdfPath>> const& groups,
+    std::set<SdfPath>* parents) {
+    parents->clear();
+    for (auto const& tile : tiles) {
+        for (SdfPath path = tile.first.GetParentPath();
+             path != SdfPath::AbsoluteRootPath() && !groups.count(path);
+             path = path.GetParentPath()) {
+            parents->insert(path);
+        }
+    }
+}
