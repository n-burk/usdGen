+class HdStRenderDelegate::_GpuGroupTerminalObserver final
+    : public HdSceneIndexObserver
+{
+public:
+    explicit _GpuGroupTerminalObserver(HdStRenderDelegate *owner)
+        : _owner(owner)
+    {
+    }
+
+    void Scan(HdSceneIndexBase const &sceneIndex, SdfPath const &path)
+    {
+        _ObservePrim(sceneIndex, path);
+        for (SdfPath const &child : sceneIndex.GetChildPrimPaths(path)) {
+            Scan(sceneIndex, child);
+        }
+    }
+
+    void PrimsAdded(
+        HdSceneIndexBase const &sender,
+        AddedPrimEntries const &entries) override
+    {
+        for (AddedPrimEntry const &entry : entries) {
+            Scan(sender, entry.primPath);
+        }
+    }
+
+    void PrimsRemoved(
+        HdSceneIndexBase const &,
+        RemovedPrimEntries const &entries) override
+    {
+        if (!_owner || !_owner->_gpuGroupController) {
+            return;
+        }
+        for (RemovedPrimEntry const &entry : entries) {
+            _owner->_gpuGroupController->RemovePrefix(entry.primPath);
+            _EraseControlsAtOrBelow(entry.primPath);
+        }
+    }
+
+    void PrimsDirtied(
+        HdSceneIndexBase const &sender,
+        DirtiedPrimEntries const &entries) override
+    {
+        for (DirtiedPrimEntry const &entry : entries) {
+            _ObservePrim(sender, entry.primPath);
+        }
+    }
+
+    void PrimsRenamed(
+        HdSceneIndexBase const &sender,
+        RenamedPrimEntries const &entries) override
+    {
+        if (!_owner || !_owner->_gpuGroupController) {
+            return;
+        }
+        for (RenamedPrimEntry const &entry : entries) {
+            _owner->_gpuGroupController->RemovePrefix(entry.oldPrimPath);
+            _EraseControlsAtOrBelow(entry.oldPrimPath);
+            Scan(sender, entry.newPrimPath);
+        }
+    }
+
+private:
+    void _ObservePrim(HdSceneIndexBase const &sceneIndex, SdfPath const &path)
+    {
+        if (!_owner || !_owner->_gpuGroupController) {
+            return;
+        }
+        HdSceneIndexPrim const prim = sceneIndex.GetPrim(path);
+        HdStBasisCurvesGpuGroupDataSourceHandle const group =
+            HdStBasisCurvesGpuGroupDataSource::Cast(
+                prim.dataSource ? prim.dataSource->Get(
+                    HdStGetBasisCurvesGpuGroupDataSourceToken())
+                                : HdDataSourceBaseHandle());
+        HdStBasisCurvesGpuGroupCandidateSharedPtr const candidate =
+            group ? group->GetCandidate()
+                  : HdStBasisCurvesGpuGroupCandidateSharedPtr();
+        HdStBasisCurvesGpuGroupMailboxSharedPtr const mailbox =
+            group ? group->GetMailbox()
+                  : HdStBasisCurvesGpuGroupMailboxSharedPtr();
+        if (candidate && mailbox && candidate->groupPath == path) {
+            _controlPaths.insert(path);
+            _owner->_gpuGroupController->Enqueue(candidate, mailbox);
+        } else if (_controlPaths.erase(path) != 0) {
+            // A dirty/re-added path which used to carry a control but no
+            // longer does is an explicit GPU-to-CPU/disabled transition.
+            // Unrelated dirties are not removal scopes.
+            _owner->_gpuGroupController->RemovePrefix(path);
+        }
+    }
+
+    void _EraseControlsAtOrBelow(SdfPath const &prefix)
+    {
+        for (auto it = _controlPaths.begin(); it != _controlPaths.end();) {
+            if (it->HasPrefix(prefix)) {
+                it = _controlPaths.erase(it);
+            } else {
+                ++it;
+            }
+        }
+    }
+
+    HdStRenderDelegate *_owner;
+    std::set<SdfPath> _controlPaths;
+};
 
