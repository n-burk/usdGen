+struct HdStBasisCurvesGpuGroupStagingSceneIndex::_Active {
+    HdStBasisCurvesGpuGroupCandidateSharedPtr candidate;
+    HdStBasisCurvesGpuGroupMailboxSharedPtr mailbox;
+    // A mailbox result is terminal for its candidate/ticket.  Keep the
+    // consumed control for same-candidate dedupe, but never republish it.
+    bool terminalConsumed = false;
+};
+
+struct HdStBasisCurvesGpuGroupStagingSceneIndex::_Snapshot {
+    std::map<SdfPath, HdContainerDataSourceHandle> tiles;
+    std::map<SdfPath, std::set<SdfPath>> groups;
+    std::set<SdfPath> syntheticParents;
+    std::map<SdfPath, _Active> controls;
+};
+
+struct HdStBasisCurvesGpuGroupStagingSceneIndex::_Packet {
+    std::shared_ptr<_Snapshot const> snapshot;
+    HdSceneIndexObserver::RemovedPrimEntries removed;
+    HdSceneIndexObserver::AddedPrimEntries added;
+    HdSceneIndexObserver::DirtiedPrimEntries dirtied;
+    // Ready results are checked again at publication, since a registry can
+    // become dead while a publication waits behind a reentrant observer.
+    std::function<bool()> admission;
+};
