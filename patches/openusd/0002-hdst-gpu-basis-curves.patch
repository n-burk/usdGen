+// False means fail closed: the caller must not execute/encode this batch.
+HDST_API bool HdStApplyIndirectDrawCounts(
+    std::vector<HdStDrawItemInstance const *> const &items,
+    std::shared_ptr<HdStDispatchBuffer> const &dispatch,
+    HdStResourceRegistry *registry);
