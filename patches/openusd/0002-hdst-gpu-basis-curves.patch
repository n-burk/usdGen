+class HdStResourceRegistry;
+
+/// The topology slots used by BasisCurves representations.  A provider is
+/// asked only for slots currently required by active representations.
+enum class HdStBasisCurvesGpuTopologyMode : uint8_t {
+    Curves,
+    Hull,
+    Points
+};
+
+using HdStBasisCurvesGpuTopologyModeVector =
+    std::vector<HdStBasisCurvesGpuTopologyMode>;
+
+/// Input to a GPU curve provider.  Prepare is called during Sync.  The
+/// provider owns allocation and computation queueing against ‘registry’;
+/// HdSt only stages the returned immutable BAR bundle for publication after
+/// Commit.
+struct HdStBasisCurvesGpuPrepareRequest {
+    SdfPath rprimId;
+    HdStBasisCurvesGpuTopologyModeVector topologyModes;
+};
+
+/// A topology BAR and the one-element GPU draw-count BAR paired with it.
+/// topologyRange's element count is a capacity.  drawCountRange, not that
+/// capacity, is the true draw index/vertex count for the GPU indirect path
+/// (for example, four times a cubic record count).
+struct HdStBasisCurvesGpuTopologyRange {
+    HdStBasisCurvesGpuTopologyMode mode =
+        HdStBasisCurvesGpuTopologyMode::Curves;
+    HdBufferArrayRangeSharedPtr topologyRange;
+    HdBufferArrayRangeSharedPtr drawCountRange;
+};
+
+/// Immutable complete generation prepared by an external GPU producer.
+/// The provider must queue all BAR allocation/computations in Prepare and
+/// must not mutate this object thereafter.  vertexRange may contain a
+/// composite layout (points, widths, hairT, etc.); per-channel CPU fallback
+/// is intentionally not part of this contract.
+struct HdStBasisCurvesGpuBundle {
+    uint64_t generation = 0;
+    TfToken curveType;
+    TfToken curveBasis;
+    TfToken curveWrap;
+    GfBBox3d bounds;
+    bool basisWidthInterpolation = false;
+    bool basisNormalInterpolation = false;
+
+    HdBufferArrayRangeSharedPtr vertexRange;
+    std::vector<HdStBasisCurvesGpuTopologyRange> topologyRanges;
+
+    /// Called only after HdStResourceRegistry has committed the work queued by
+    /// Prepare.  It must validate every requested topology, draw-count, and
+    /// vertex computation.  A false result keeps the prior complete bundle
+    /// visible (or leaves an initially unpublished prim empty).
+    std::function<bool()> ready;
+
+    HDST_API
+    bool IsCompleteFor(
+        HdStBasisCurvesGpuTopologyModeVector const &requestedModes) const;
+
+    HDST_API
+    bool Ready() const;
+
+    HDST_API
+    HdStBasisCurvesGpuTopologyRange const *FindTopologyRange(
+        HdStBasisCurvesGpuTopologyMode mode) const;
+};
+
+using HdStBasisCurvesGpuBundleSharedPtr =
+    std::shared_ptr<const HdStBasisCurvesGpuBundle>;
+
+/// HdSt-owned opaque scene-index datasource.  An application may derive this
+/// class and place it under its own scene data only by using the public HdSt
+/// token selected by its integration.  HdSt has no dependency on the
+/// application or on any GPU runtime.
+class HdStBasisCurvesGpuDataSource : public HdDataSourceBase
+{
+public:
+    HD_DECLARE_DATASOURCE_ABSTRACT(HdStBasisCurvesGpuDataSource);
+
+    /// Prepare a complete generation during Sync.  Prepare owns all resource
+    /// allocation and AddComputation calls.  Null is a failed/unavailable
+    /// generation, not permission for HdSt to ingest CPU curve attributes.
+    virtual HdStBasisCurvesGpuBundleSharedPtr Prepare(
+        HdStResourceRegistry *registry,
+        HdStBasisCurvesGpuPrepareRequest const &request) = 0;
+
+protected:
+    HDST_API
+    ~HdStBasisCurvesGpuDataSource() override;
+};
+
+HD_DECLARE_DATASOURCE_HANDLES(HdStBasisCurvesGpuDataSource);
