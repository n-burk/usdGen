+bool
+HdStBasisCurves::_StageGpuBundle(HdSceneDelegate *sceneDelegate,
+                                 HdRenderParam *renderParam)
+{
+    HdRenderIndex &renderIndex = sceneDelegate->GetRenderIndex();
+    HdSceneIndexPrim const prim =
+        renderIndex.GetTerminalSceneIndex()->GetPrim(GetId());
+    HdStBasisCurvesGpuDataSourceHandle const provider =
+        HdStBasisCurvesGpuDataSource::Cast(
+            prim.dataSource ? prim.dataSource->Get(_gpuBasisCurvesDataSourceToken)
+                            : HdDataSourceBaseHandle());
+    if (!provider) {
+        // A provider was removed: old indirect GPU counts must not shadow the
+        // host-authored topology path on the next ordinary sync.
+        if (_gpuProviderPresent) {
+            for (auto const &reprPair : _reprs) {
+                for (HdRepr::DrawItemUniquePtr const &item :
+                     reprPair.second->GetDrawItems()) {
+                    static_cast<HdStDrawItem *>(item.get())
+                        ->SetIndirectDrawCountRange({});
+                }
+            }
+            ++_gpuEpoch;
+            _gpuCallbackState->epoch = _gpuEpoch;
+            _pendingGpuBundle.reset();
+        }
+        return false;
+    }
+
+    // Supersede an older candidate before Prepare, including when Prepare
+    // subsequently fails.  Its callback will observe the new epoch and drop.
+    const uint64_t requestEpoch = ++_gpuEpoch;
+    _gpuCallbackState->epoch = requestEpoch;
+    _pendingGpuBundle.reset();
+    _gpuRenderParam = nullptr;
+
+    // Presence is authoritative: a provider that cannot make a complete next
+    // bundle preserves the old bundle (or an initially empty rprim), rather
+    // than falling through to CPU topology/primvar ingestion.
+    HdStResourceRegistrySharedPtr const registry =
+        std::static_pointer_cast<HdStResourceRegistry>(
+            renderIndex.GetResourceRegistry());
+    if (!registry || registry->GetHgi()->GetAPIName() != HgiTokens->OpenGL ||
+        !registry->GetHgi()->GetCapabilities()->IsSet(
+            HgiDeviceCapabilitiesBitsMultiDrawIndirect)) {
+        TF_WARN("HdSt GPU BasisCurves provider requires HgiGL with MultiDrawIndirect");
+        return true;
+    }
+
+    HdStBasisCurvesGpuPrepareRequest request;
+    request.rprimId = GetId();
+    std::set<HdStBasisCurvesGpuTopologyMode> modes;
+    for (auto const &reprPair : _reprs) {
+        HdReprSharedPtr const &repr = reprPair.second;
+        for (HdRepr::DrawItemUniquePtr const &item : repr->GetDrawItems()) {
+            modes.insert(_GetGpuTopologyMode(
+                static_cast<HdStDrawItem *>(item.get())));
+        }
+    }
+    request.topologyModes.assign(modes.begin(), modes.end());
+
+    HdStBasisCurvesGpuBundleSharedPtr const bundle =
+        provider->Prepare(registry.get(), request);
+    if (!bundle || !bundle->IsCompleteFor(request.topologyModes)) {
+        return true;
+    }
+
+    _pendingGpuBundle = bundle;
+    _gpuResourceRegistry = registry;
+    _gpuRenderParam = renderParam;
+    HdDisplayStyle const style = GetDisplayStyle(sceneDelegate);
+    _pendingGpuRefineLevel = style.refineLevel;
+    _pendingGpuDisplayInOverlay = style.displayInOverlay;
+    _pendingGpuOccludedSelectionShowsThrough =
+        style.occludedSelectionShowsThrough;
+    _pendingGpuPointsShadingEnabled = style.pointsShadingEnabled;
+    _gpuShadingStyle = sceneDelegate->GetShadingStyle(GetId())
+        .GetWithDefault<TfToken>();
+    std::shared_ptr<_GpuCallbackState> const callbackState = _gpuCallbackState;
+    registry->AddPostCommitCallback([callbackState, requestEpoch]() {
+        // Finalize/destruction clears owner before this callback can touch it.
+        if (!callbackState->owner || callbackState->epoch != requestEpoch) {
+            return;
+        }
+        callbackState->owner->_PublishGpuBundle();
+    });
+    return true;
+}
+
+void
+HdStBasisCurves::_PublishGpuBundle()
+{
+    HdStBasisCurvesGpuBundleSharedPtr const bundle = _pendingGpuBundle;
+    struct _PendingCleanup {
+        HdStBasisCurves *owner;
+        ~_PendingCleanup() {
+            owner->_pendingGpuBundle.reset();
+            owner->_gpuRenderParam = nullptr;
+        }
+    } cleanup{this};
+    if (!bundle || !bundle->Ready()) {
+        return;
+    }
+
+    // Metadata only: never feed this empty topology to a native index builder.
+    _topology = HdSt_BasisCurvesTopology::New(HdBasisCurvesTopology(
+        bundle->curveType, bundle->curveBasis, bundle->curveWrap,
+        VtIntArray(), VtIntArray()));
+    _refineLevel = _pendingGpuRefineLevel;
+    _displayInOverlay = _pendingGpuDisplayInOverlay;
+    _occludedSelectionShowsThrough = _pendingGpuOccludedSelectionShowsThrough;
+    _pointsShadingEnabled = _pendingGpuPointsShadingEnabled;
+    _basisWidthInterpolation = bundle->basisWidthInterpolation;
+    _basisNormalInterpolation = bundle->basisNormalInterpolation;
+
+    std::set<int> publishedSlots;
+    bool publishedVertex = false;
+    for (auto const &reprPair : _reprs) {
+        HdReprSharedPtr const &repr = reprPair.second;
+        for (HdRepr::DrawItemUniquePtr const &item : repr->GetDrawItems()) {
+            HdStDrawItem * const drawItem =
+                static_cast<HdStDrawItem *>(item.get());
+            if (!publishedVertex) {
+                HdStUpdateDrawItemBAR(bundle->vertexRange,
+                    drawItem->GetDrawingCoord()->GetVertexPrimvarIndex(),
+                    &_sharedData, _gpuRenderParam, nullptr);
+                publishedVertex = true;
+            }
+            const HdStBasisCurvesGpuTopologyRange * const topo =
+                bundle->FindTopologyRange(_GetGpuTopologyMode(drawItem));
+            const int topologySlot = drawItem->GetDrawingCoord()->GetTopologyIndex();
+            if (topo && publishedSlots.insert(topologySlot).second) {
+                HdStUpdateDrawItemBAR(topo->topologyRange, topologySlot,
+                    &_sharedData, _gpuRenderParam, nullptr);
+            }
+            if (topo) {
+                drawItem->SetIndirectDrawCountRange(topo->drawCountRange);
+            }
+        }
+    }
+    _sharedData.bounds = bundle->bounds;
+    _UpdateGpuGeometricShaders(_gpuRenderParam);
+    // drawCount BAR values are consumed by the indirect dispatch path and can
+    // change while the topology/vertex allocations are reused.
+    HdStMarkDrawBatchesDirty(_gpuRenderParam);
+}
+
+void
+HdStBasisCurves::_UpdateGpuGeometricShaders(HdRenderParam *renderParam)
+{
+    for (auto const &reprPair : _reprs) {
+        _BasisCurvesReprConfig::DescArray const &descs =
+            _GetReprDesc(reprPair.first);
+        HdReprSharedPtr const &repr = reprPair.second;
+        int drawItemIndex = 0;
+        for (HdBasisCurvesReprDesc const &desc : descs) {
+            if (desc.geomStyle != HdBasisCurvesGeomStyleInvalid) {
+                _UpdateDrawItemGeometricShader(nullptr, renderParam,
+                    static_cast<HdStDrawItem *>(
+                        repr->GetDrawItem(drawItemIndex++)), desc);
+            }
+        }
+    }
+}
+
+void
+HdStBasisCurves::_InvalidateGpuCallbackState()
+{
+    ++_gpuEpoch;
+    _pendingGpuBundle.reset();
+    _gpuRenderParam = nullptr;
+    if (_gpuCallbackState) {
+        _gpuCallbackState->owner = nullptr;
+        _gpuCallbackState->epoch = _gpuEpoch;
+    }
+}
