+HdStBasisCurvesGpuDataSource::~HdStBasisCurvesGpuDataSource() = default;
+
+HdStBasisCurvesGpuTopologyRange const *
+HdStBasisCurvesGpuBundle::FindTopologyRange(
+    HdStBasisCurvesGpuTopologyMode const mode) const
+{
+    const auto it = std::find_if(
+        topologyRanges.begin(), topologyRanges.end(),
+        [mode](HdStBasisCurvesGpuTopologyRange const &range) {
+            return range.mode == mode;
+        });
+    return it == topologyRanges.end() ? nullptr : &*it;
+}
+
+bool
+HdStBasisCurvesGpuBundle::IsCompleteFor(
+    HdStBasisCurvesGpuTopologyModeVector const &requestedModes) const
+{
+    // Generation zero is the first valid producer generation.  Bundle
+    // presence and the resources below, rather than the numeric stamp,
+    // establish whether this candidate is complete.
+    if (curveType.IsEmpty() || !vertexRange ||
+        !vertexRange->IsValid()) {
+        return false;
+    }
+    for (HdStBasisCurvesGpuTopologyMode const mode : requestedModes) {
+        HdStBasisCurvesGpuTopologyRange const * const range =
+            FindTopologyRange(mode);
+        if (!range || !range->topologyRange || !range->drawCountRange ||
+            !range->topologyRange->IsValid() ||
+            !range->drawCountRange->IsValid()) {
+            return false;
+        }
+    }
+    return true;
+}
+
+bool
+HdStBasisCurvesGpuBundle::Ready() const
+{
+    return ready && ready();
+}
