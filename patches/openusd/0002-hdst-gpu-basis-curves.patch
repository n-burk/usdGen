+TfToken const _gpuBasisCurvesDataSourceToken("hdStBasisCurvesGpu");
+
+HdStBasisCurvesGpuTopologyMode
+_GetGpuTopologyMode(HdStDrawItem *drawItem)
+{
+    const int index = drawItem->GetDrawingCoord()->GetTopologyIndex();
+    if (index == HdDrawingCoord::CustomSlotsBegin) {
+        return HdStBasisCurvesGpuTopologyMode::Hull;
+    }
+    if (index == HdDrawingCoord::CustomSlotsBegin + 1) {
+        return HdStBasisCurvesGpuTopologyMode::Points;
+    }
+    return HdStBasisCurvesGpuTopologyMode::Curves;
+}
+
+} // anonymous namespace
