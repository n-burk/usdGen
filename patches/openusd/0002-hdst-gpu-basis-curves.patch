+// usdGen development extension for OpenUSD.
+// Licensed under the terms at https://openusd.org/license.
+#include "pxr/imaging/hdSt/indirectDrawCount.h"
+#include "pxr/imaging/hdSt/drawItemInstance.h"
+#include "pxr/imaging/hdSt/dispatchBuffer.h"
+#include "pxr/imaging/hdSt/resourceRegistry.h"
+#include "pxr/imaging/hd/tokens.h"
+#include "pxr/imaging/hgi/blitCmds.h"
+#include "pxr/imaging/hgi/blitCmdsOps.h"
+#include "pxr/imaging/hgi/buffer.h"
+#include <limits>
+PXR_NAMESPACE_OPEN_SCOPE
+namespace {
+bool _Fits(size_t offset, size_t size, size_t capacity) {
+    return offset <= capacity && size <= capacity - offset;
+}
+}
+bool HdStApplyIndirectDrawCounts(
+    std::vector<HdStDrawItemInstance const *> const &items,
+    std::shared_ptr<HdStDispatchBuffer> const &dispatch,
+    HdStResourceRegistry *registry)
+{
+    bool any = false;
+    for (auto const *item : items) {
+        if (!item) return false;
+        any |= bool(item->GetDrawItem()->GetIndirectDrawCountRange());
+    }
+    if (!any) return true;
+    if (!registry || !dispatch || dispatch->GetCount() < 0 ||
+        size_t(dispatch->GetCount()) != items.size()) return false;
+    const auto destination = dispatch->GetResource(HdTokens->drawDispatch);
+    if (!destination || !destination->GetHandle() || destination->GetOffset() < 0 ||
+        destination->GetStride() == 0)
+        return false;
+    const size_t stride = size_t(dispatch->GetCommandNumUints()) * sizeof(uint32_t);
+    if (stride < sizeof(uint32_t) || destination->GetStride() != stride)
+        return false;
+    // HdStDispatchBuffer is monolithic; its dispatch BAR intentionally does
+    // not implement GetByteOffset().  The resource offset is therefore the
+    // complete destination address.
+    const size_t destinationOffset = size_t(destination->GetOffset());
+    if (destinationOffset % alignof(uint32_t)) return false;
+    const size_t capacity = destination->GetHandle()->GetByteSizeOfResource();
+    std::vector<HgiBufferGpuToGpuOp> copies;
+    copies.reserve(items.size());
+    const TfToken name("drawCount");
+    for (size_t i = 0; i < items.size(); ++i) {
+        auto const &range = items[i]->GetDrawItem()->GetIndirectDrawCountRange();
+        if (!range) continue;
+        auto sourceRange = std::dynamic_pointer_cast<HdStBufferArrayRange>(range);
+        auto source = sourceRange ? sourceRange->GetResource(name) : nullptr;
+        if (!source || sourceRange->GetNumElements() != 1 ||
+            source->GetTupleType() != HdTupleType{HdTypeUInt32, 1} ||
+            !source->GetHandle() || source->GetOffset() < 0 ||
+            sourceRange->GetByteOffset(name) < 0 || source->GetStride() < 4)
+            return false;
+        const size_t fieldOffset = size_t(source->GetOffset());
+        const size_t rangeOffset = size_t(sourceRange->GetByteOffset(name));
+        if (fieldOffset > std::numeric_limits<size_t>::max() - rangeOffset ||
+            i > (std::numeric_limits<size_t>::max() - destinationOffset) / stride)
+            return false;
+        HgiBufferGpuToGpuOp op;
+        op.gpuSourceBuffer = source->GetHandle();
+        op.gpuDestinationBuffer = destination->GetHandle();
+        op.sourceByteOffset = fieldOffset + rangeOffset;
+        op.destinationByteOffset = destinationOffset + i * stride;
+        op.byteSize = sizeof(uint32_t);
+        if (op.sourceByteOffset % alignof(uint32_t) || !_Fits(op.sourceByteOffset, op.byteSize,
+                   source->GetHandle()->GetByteSizeOfResource()) ||
+            !_Fits(op.destinationByteOffset, op.byteSize, capacity)) return false;
+        copies.push_back(op);
+    }
+    // Native dispatch uploads may still be queued when culling is disabled.
+    // Submit earlier work first; no host fence or readback is needed.
+    registry->SubmitBlitWork();
+    registry->SubmitComputeWork();
+    auto *commands = registry->GetGlobalBlitCmds();
+    commands->InsertMemoryBarrier(HgiMemoryBarrierAll);
+    for (auto const &copy : copies) commands->CopyBufferGpuToGpu(copy);
+    commands->InsertMemoryBarrier(HgiMemoryBarrierAll);
+    registry->SubmitBlitWork();
+    return true;
+}
