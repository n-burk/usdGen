diff --git a/pxr/imaging/hdSt/resourceRegistry.cpp b/pxr/imaging/hdSt/resourceRegistry.cpp
index a649c5a7d..f2620edde 100644
--- a/pxr/imaging/hdSt/resourceRegistry.cpp
+++ b/pxr/imaging/hdSt/resourceRegistry.cpp
@@ -144,6 +144,10 @@ HdStResourceRegistry::HdStResourceRegistry(Hgi * const hgi)
 
 HdStResourceRegistry::~HdStResourceRegistry()
 {
+    // Drop uncommitted closures before collecting resources: their captured
+    // BARs/leases may own the final reference to a registry-managed resource.
+    // Never invoke publication callbacks during destruction.
+    _pendingPostCommitCallbacks.clear();
     // XXX Ideally all the HdInstanceRegistry would get destroy here and
     // they cleanup all GPU resources. Since that mechanism isn't in place
     // yet, we call GarbageCollect to emulate this behavior.
@@ -538,6 +542,19 @@ HdStResourceRegistry::AddComputation(HdBufferArrayRangeSharedPtr const &range,
     }
 }
 
+void
+HdStResourceRegistry::AddPostCommitCallback(std::function<void()> callback)
+{
+    if (!callback) {
+        TF_CODING_ERROR("Cannot add an empty post-commit callback");
+        return;
+    }
+
+    // As with AddComputation, callers may register in parallel while Sync is
+    // running, but the owner must quiesce registration before Commit begins.
+    _pendingPostCommitCallbacks.emplace_back(std::move(callback));
+}
+
 /// ------------------------------------------------------------------------
 /// Dispatch & misc buffer API
 /// ------------------------------------------------------------------------
@@ -845,6 +862,23 @@ HdStResourceRegistry::_CommitTextures()
 void
 HdStResourceRegistry::_Commit()
 {
+    if (_isCommitting) {
+        TF_CODING_ERROR("Recursive HdStResourceRegistry::Commit is not supported");
+        return;
+    }
+    struct _CommitScope {
+        explicit _CommitScope(bool *isCommitting) : _isCommitting(isCommitting) {
+            *_isCommitting = true;
+        }
+        ~_CommitScope() { *_isCommitting = false; }
+        bool *_isCommitting;
+    } commitScope(&_isCommitting);
+
+    // The Sync/Commit contract has quiesced producers by this point.  Swapping
+    // gives callbacks registered from a callback a fresh next-Commit batch.
+    _PostCommitCallbackList postCommitCallbacks;
+    postCommitCallbacks.swap(_pendingPostCommitCallbacks);
+
     // Process sub resource registries before other resources in
     // case they depend on any resources in this resource registry
     // being committed.
@@ -1082,6 +1116,19 @@ HdStResourceRegistry::_Commit()
         compVec.clear();
     }
 
+    // Computation queues have been submitted above and their pending entries
+    // are now released.  Callbacks decide their own readiness/success; this
+    // hook deliberately neither waits for GPU completion nor reports a global
+    // computation result.  One bad callback must not replay or suppress the
+    // remainder of this detached batch.
+    for (std::function<void()> &callback : postCommitCallbacks) {
+        try {
+            callback();
+        } catch (...) {
+            TF_WARN("HdStResourceRegistry post-commit callback threw; ignoring it");
+        }
+    }
+
     HD_PERF_COUNTER_INCR(HdPerfTokens->committed);
 }
 
diff --git a/pxr/imaging/hdSt/resourceRegistry.h b/pxr/imaging/hdSt/resourceRegistry.h
