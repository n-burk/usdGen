--- a/pxr/imaging/hdSt/resourceRegistry.h
+++ b/pxr/imaging/hdSt/resourceRegistry.h
@@ -26,6 +26,7 @@
 #include <tbb/concurrent_vector.h>
 
 #include <atomic>
+#include <functional>
 #include <map>
 #include <memory>
 
@@ -316,6 +317,20 @@ public:
                         HdStComputationSharedPtr const &computation,
                         HdStComputeQueue const queue);
 
+    /// Register work to run after this registry has submitted all of its
+    /// queued computation work and released the pending sources and
+    /// computations for a Commit.  This is a serialized Commit-context
+    /// callback; it does not imply GPU completion or that any computation
+    /// succeeded.  It is intended for a client which has independently
+    /// established those conditions before publishing a preallocated BAR.
+    ///
+    /// Registration is safe in the normal parallel Sync phase, but must be
+    /// quiesced before Commit just like AddComputation.  A callback registered
+    /// by a callback is deferred to the next Commit.  Callbacks must not draw,
+    /// reenter Commit, or retain resources beyond their documented owners.
+    HDST_API
+    void AddPostCommitCallback(std::function<void()> callback);
+
     /// ------------------------------------------------------------------------
     /// Dispatch & buffer API
     /// ------------------------------------------------------------------------
@@ -641,6 +656,16 @@ private:
     typedef tbb::concurrent_vector<_PendingComputation> _PendingComputationList;
     _PendingComputationList  _pendingComputations[HdStComputeQueueCount];
 
+    using _PostCommitCallbackList =
+        tbb::concurrent_vector<std::function<void()>>;
+    // Detached at Commit entry.  Destruction deliberately drops any entries
+    // which were never committed, without invoking them.
+    _PostCommitCallbackList _pendingPostCommitCallbacks;
+
+    // Commits are serialized by the owning render pipeline.  This guard makes
+    // an accidental recursive Commit from a post-commit callback diagnosable.
+    bool _isCommitting = false;
+
     // aggregated buffer array
     HdStBufferArrayRegistry _nonUniformBufferArrayRegistry;
     HdStBufferArrayRegistry _nonUniformImmutableBufferArrayRegistry;
