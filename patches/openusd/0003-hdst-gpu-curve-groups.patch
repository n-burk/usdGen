+//
+// usdGen development extension for OpenUSD
+//
+// Licensed under the terms set forth in the LICENSE.txt file available at
+// https://openusd.org/license.
+//
+#include "pxr/pxr.h"
+#include "pxr/imaging/hdSt/basisCurvesGpuGroupDataSource.h"
+
+#include "pxr/imaging/hdSt/resourceRegistry.h"
+
+#include "pxr/base/gf/matrix4d.h"
+#include "pxr/base/gf/range3d.h"
+
+#include <cmath>
+#include <set>
+#include <utility>
+
+#include <tbb/concurrent_queue.h>
+
+PXR_NAMESPACE_OPEN_SCOPE
+
+namespace {
+
+bool
+_Finite(GfBBox3d const &bounds)
+{
+    GfRange3d const range = bounds.GetRange();
+    GfVec3d const &minimum = range.GetMin();
+    GfVec3d const &maximum = range.GetMax();
+    for (int i = 0; i != 3; ++i) {
+        if (!std::isfinite(minimum[i]) || !std::isfinite(maximum[i]) ||
+            minimum[i] > maximum[i]) {
+            return false;
+        }
+    }
+    GfMatrix4d const matrix = bounds.GetMatrix();
+    for (int row = 0; row != 4; ++row) {
+        for (int column = 0; column != 4; ++column) {
+            if (!std::isfinite(matrix[row][column])) {
+                return false;
+            }
+        }
+    }
+    return true;
+}
+
+bool
+_SameBounds(GfBBox3d const &lhs, GfBBox3d const &rhs)
+{
+    return lhs.GetRange() == rhs.GetRange() &&
+        lhs.GetMatrix() == rhs.GetMatrix();
+}
+
+HdStBasisCurvesGpuBundleSharedPtr
+_CachedReadyBundle(HdStBasisCurvesGpuBundleSharedPtr const &bundle)
+{
+    if (!bundle) {
+        return {};
+    }
+    auto result = std::make_shared<HdStBasisCurvesGpuBundle>(*bundle);
+    result->ready = [] { return true; };
+    return result;
+}
+
+bool
+_ReadySafely(HdStBasisCurvesGpuBundleSharedPtr const &bundle)
+{
+    try {
+        return bundle && bundle->Ready();
+    } catch (...) {
+        return false;
+    }
+}
+
+} // anonymous namespace
+
+class HdStBasisCurvesGpuGroupMailbox::_Queue final
+{
+public:
+    tbb::concurrent_queue<HdStBasisCurvesGpuGroupResult> values;
+};
+
+HdStBasisCurvesGpuGroupMailbox::HdStBasisCurvesGpuGroupMailbox()
+    : _queue(new _Queue)
+{
+}
+
+HdStBasisCurvesGpuGroupMailbox::~HdStBasisCurvesGpuGroupMailbox() = default;
+
+HdStBasisCurvesGpuRegistryIdentity::HdStBasisCurvesGpuRegistryIdentity(
+    HdStResourceRegistry const * const registry,
+    uint64_t const serial,
+    std::weak_ptr<void const> registryLease)
+    : _registry(registry)
+    , _serial(serial)
+    , _registryLease(std::move(registryLease))
+{
+}
+
+bool
+HdStBasisCurvesGpuRegistryIdentity::Matches(
+    HdStResourceRegistry const * const registry) const
+{
+    return Acquire(registry) != nullptr;
+}
+
+std::shared_ptr<void const>
+HdStBasisCurvesGpuRegistryIdentity::Acquire(
+    HdStResourceRegistry const * const registry) const
+{
+    if (_serial == 0 || _registry == nullptr || _registry != registry ||
+        !_live.load(std::memory_order_acquire)) {
+        return {};
+    }
+    std::shared_ptr<void const> lease = _registryLease.lock();
+    if (!lease || lease.get() != _registry ||
+        !_live.load(std::memory_order_acquire)) {
+        return {};
+    }
+    return lease;
+}
+
+bool
+HdStBasisCurvesGpuRegistryIdentity::IsLive() const
+{
+    if (_serial == 0 || _registry == nullptr ||
+        !_live.load(std::memory_order_acquire)) {
+        return false;
+    }
+    std::shared_ptr<void const> const lease = _registryLease.lock();
+    return lease && lease.get() == _registry &&
+        _live.load(std::memory_order_acquire);
+}
+
+void
+HdStBasisCurvesGpuRegistryIdentity::Invalidate()
+{
+    _live.store(false, std::memory_order_release);
+}
+
+HdStBasisCurvesGpuReadyProvider::HdStBasisCurvesGpuReadyProvider(
+    HdStBasisCurvesGpuRegistryIdentitySharedPtr identity,
+    HdStBasisCurvesGpuBundleSharedPtr bundle,
+    SdfPath rprimPath,
+    uint64_t const ticket,
+    uint64_t const generation)
+    : _identity(std::move(identity))
+    , _bundle(_CachedReadyBundle(bundle))
+    , _rprimPath(std::move(rprimPath))
+    , _ticket(ticket)
+    , _generation(generation)
+{
+}
+
+HdStBasisCurvesGpuReadyProvider::Handle
+HdStBasisCurvesGpuReadyProvider::_NewAccepted(
+    HdStBasisCurvesGpuRegistryIdentitySharedPtr identity,
+    HdStBasisCurvesGpuBundleSharedPtr bundle,
+    SdfPath rprimPath,
+    uint64_t const ticket,
+    uint64_t const generation)
+{
+    return std::shared_ptr<HdStBasisCurvesGpuReadyProvider>(
+        new HdStBasisCurvesGpuReadyProvider(std::move(identity),
+            std::move(bundle), std::move(rprimPath), ticket, generation));
+}
+
+HdStBasisCurvesGpuBundleSharedPtr
+HdStBasisCurvesGpuReadyProvider::Prepare(
+    HdStResourceRegistry * const registry,
+    HdStBasisCurvesGpuPrepareRequest const &request)
+{
+    std::shared_ptr<void const> const lease =
+        _identity ? _identity->Acquire(registry) : std::shared_ptr<void const>();
+    if (!lease || !_bundle ||
+        _ticket == 0 || _bundle->generation != _generation ||
+        request.rprimId != _rprimPath ||
+        !_bundle->IsCompleteFor(request.topologyModes)) {
+        return {};
+    }
+    return _bundle;
+}
+
+bool
+HdStValidateBasisCurvesGpuGroupCandidate(
+    HdStBasisCurvesGpuGroupCandidate const &candidate)
+{
+    if (!candidate.groupPath.IsAbsolutePath() || !candidate.groupPath.IsPrimPath() ||
+        candidate.groupPath.IsEmpty() || candidate.groupPath.IsAbsoluteRootPath() ||
+        candidate.ticket == 0) {
+        return false;
+    }
+
+    std::set<uint32_t> ids;
+    std::set<SdfPath> paths;
+    for (HdStBasisCurvesGpuGroupMember const &member : candidate.members) {
+        if (!ids.insert(member.id).second || !paths.insert(member.rprimPath).second ||
+            !member.rprimPath.IsAbsolutePath() || !member.rprimPath.IsPrimPath() ||
+            member.rprimPath.IsEmpty() || member.presentation.curveType.IsEmpty() ||
+            member.presentation.curveBasis.IsEmpty() ||
+            member.presentation.curveWrap.IsEmpty() ||
+            !member.rprimPath.HasPrefix(candidate.groupPath) ||
+            member.rprimPath == candidate.groupPath || !member.provider ||
+            member.presentation.refineLevel < 0 ||
+            !_Finite(member.presentation.bounds) ||
+            (!member.presentation.materialPath.IsEmpty() &&
+             (!member.presentation.materialPath.IsAbsolutePath() ||
+              !member.presentation.materialPath.IsPrimPath() ||
+              member.presentation.materialPath.IsAbsoluteRootPath())) ||
+            (!member.presentation.primOrigin.IsEmpty() &&
+             (!member.presentation.primOrigin.IsAbsolutePath() ||
+              !member.presentation.primOrigin.IsPrimPath() ||
+              member.presentation.primOrigin.IsAbsoluteRootPath())) ||
+            (!member.presentation.dependencySurface.IsEmpty() &&
+             (!member.presentation.dependencySurface.IsAbsolutePath() ||
+              !member.presentation.dependencySurface.IsPrimPath() ||
+              member.presentation.dependencySurface.IsAbsoluteRootPath()))) {
+            return false;
+        }
+    }
+    return true;
+}
+
+HdStBasisCurvesGpuGroupResult
+HdStMakeBasisCurvesGpuGroupReadyResult(
+    HdStBasisCurvesGpuGroupCandidate const &candidate,
+    HdStBasisCurvesGpuRegistryIdentitySharedPtr const &identity,
+    std::vector<HdStBasisCurvesGpuGroupPreparedMember> const &prepared)
+{
+    HdStBasisCurvesGpuGroupResult result;
+    result.groupPath = candidate.groupPath;
+    result.ticket = candidate.ticket;
+    result.generation = candidate.generation;
+    result.registryIdentity = identity;
+    if (!HdStValidateBasisCurvesGpuGroupCandidate(candidate) || !identity ||
+        !identity->IsLive() || prepared.size() != candidate.members.size()) {
+        return result;
+    }
+
+    try {
+        result.providers.reserve(prepared.size());
+        HdStBasisCurvesGpuTopologyModeVector const allModes = {
+            HdStBasisCurvesGpuTopologyMode::Curves,
+            HdStBasisCurvesGpuTopologyMode::Hull,
+            HdStBasisCurvesGpuTopologyMode::Points};
+        for (size_t i = 0; i != prepared.size(); ++i) {
+            HdStBasisCurvesGpuGroupMember const &member = candidate.members[i];
+            HdStBasisCurvesGpuGroupPreparedMember const &entry = prepared[i];
+            HdStBasisCurvesGpuBundleSharedPtr const &bundle = entry.bundle;
+            if (entry.id != member.id || !bundle ||
+                bundle->generation != candidate.generation ||
+                bundle->curveType != member.presentation.curveType ||
+                bundle->curveBasis != member.presentation.curveBasis ||
+                bundle->curveWrap != member.presentation.curveWrap ||
+                !_SameBounds(bundle->bounds, member.presentation.bounds) ||
+                !bundle->IsCompleteFor(allModes) || !_ReadySafely(bundle)) {
+                result.providers.clear();
+                return result;
+            }
+            result.providers.push_back(HdStBasisCurvesGpuReadyProvider::_NewAccepted(
+                identity, bundle, member.rprimPath, candidate.ticket,
+                candidate.generation));
+        }
+    } catch (...) {
+        result.providers.clear();
+        return result;
+    }
+
+    result.status = HdStBasisCurvesGpuGroupResultStatus::Ready;
+    return result;
+}
+
+void
+HdStBasisCurvesGpuGroupMailbox::Post(HdStBasisCurvesGpuGroupResult result)
+{
+    if (!_canceled.load(std::memory_order_acquire) && _queue) {
+        _queue->values.push(std::move(result));
+    }
+}
+
+bool
+HdStBasisCurvesGpuGroupMailbox::TryPop(HdStBasisCurvesGpuGroupResult * const result)
+{
+    if (!result || _canceled.load(std::memory_order_acquire) || !_queue) {
+        return false;
+    }
+    return _queue->values.try_pop(*result) &&
+        !_canceled.load(std::memory_order_acquire);
+}
+
+void
+HdStBasisCurvesGpuGroupMailbox::Cancel()
+{
+    _canceled.store(true, std::memory_order_release);
+}
+
+bool
+HdStBasisCurvesGpuGroupMailbox::IsCanceled() const
+{
+    return _canceled.load(std::memory_order_acquire);
+}
+
+HdStBasisCurvesGpuGroupDataSource::~HdStBasisCurvesGpuGroupDataSource() = default;
+
+PXR_NAMESPACE_CLOSE_SCOPE
