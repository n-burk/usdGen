+#ifndef PXR_IMAGING_HD_ST_BASIS_CURVES_GPU_GROUP_DATA_SOURCE_H
+#define PXR_IMAGING_HD_ST_BASIS_CURVES_GPU_GROUP_DATA_SOURCE_H
+
+#include "pxr/pxr.h"
+#include "pxr/imaging/hdSt/api.h"
+#include "pxr/imaging/hdSt/basisCurvesGpuDataSource.h"
+
+#include "pxr/base/gf/bbox3d.h"
+#include "pxr/base/tf/token.h"
+#include "pxr/imaging/hd/dataSource.h"
+#include "pxr/usd/sdf/path.h"
+
+#include <atomic>
+#include <cstdint>
+#include <memory>
+#include <vector>
+
+PXR_NAMESPACE_OPEN_SCOPE
+
+class HdStResourceRegistry;
+struct HdStBasisCurvesGpuGroupCandidate;
+struct HdStBasisCurvesGpuGroupPreparedMember;
+struct HdStBasisCurvesGpuGroupResult;
+
+/// A renderer-owned, lifetime-qualified resource-registry identity.
+///
+/// The pointer alone is deliberately not an identity: a later registry can
+/// reuse an address.  The render delegate supplies a monotonically unique
+/// serial plus an aliasing weak lease.  Acquire() takes a transient strong
+/// lease for one Prepare lookup; the identity itself never keeps a registry
+/// alive across a pending callback or mailbox result.
+class HdStBasisCurvesGpuRegistryIdentity final
+{
+public:
+    HDST_API
+    HdStBasisCurvesGpuRegistryIdentity(
+        HdStResourceRegistry const *registry,
+        uint64_t serial,
+        std::weak_ptr<void const> registryLease);
+
+    HDST_API bool Matches(HdStResourceRegistry const *registry) const;
+    HDST_API std::shared_ptr<void const> Acquire(
+        HdStResourceRegistry const *registry) const;
+    HDST_API bool IsLive() const;
+    HDST_API void Invalidate();
+    uint64_t GetSerial() const { return _serial; }
+
+private:
+    HdStResourceRegistry const * const _registry;
+    uint64_t const _serial;
+    std::atomic<bool> _live{true};
+    std::weak_ptr<void const> const _registryLease;
+};
+
+using HdStBasisCurvesGpuRegistryIdentitySharedPtr =
+    std::shared_ptr<HdStBasisCurvesGpuRegistryIdentity>;
+
+/// A no-allocation provider for a bundle that a particular registry has
+/// already completed and accepted.  Its Ready callback is deliberately a
+/// cached success; it never re-enters a producer's potentially fallible
+/// readiness callback.
+class HdStBasisCurvesGpuReadyProvider final
+    : public HdStBasisCurvesGpuDataSource
+{
+public:
+    HD_DECLARE_DATASOURCE_ABSTRACT(HdStBasisCurvesGpuReadyProvider);
+
+    HDST_API HdStBasisCurvesGpuBundleSharedPtr Prepare(
+        HdStResourceRegistry *registry,
+        HdStBasisCurvesGpuPrepareRequest const &request) override;
+
+    uint64_t GetTicket() const { return _ticket; }
+    uint64_t GetGeneration() const { return _generation; }
+
+private:
+    HDST_API
+    HdStBasisCurvesGpuReadyProvider(
+        HdStBasisCurvesGpuRegistryIdentitySharedPtr identity,
+        HdStBasisCurvesGpuBundleSharedPtr bundle,
+        SdfPath rprimPath,
+        uint64_t ticket,
+        uint64_t generation);
+
+    static Handle _NewAccepted(
+        HdStBasisCurvesGpuRegistryIdentitySharedPtr identity,
+        HdStBasisCurvesGpuBundleSharedPtr bundle,
+        SdfPath rprimPath,
+        uint64_t ticket,
+        uint64_t generation);
+
+    friend HdStBasisCurvesGpuGroupResult
+    HdStMakeBasisCurvesGpuGroupReadyResult(
+        HdStBasisCurvesGpuGroupCandidate const &candidate,
+        HdStBasisCurvesGpuRegistryIdentitySharedPtr const &identity,
+        std::vector<HdStBasisCurvesGpuGroupPreparedMember> const &prepared);
+
+    HdStBasisCurvesGpuRegistryIdentitySharedPtr const _identity;
+    HdStBasisCurvesGpuBundleSharedPtr const _bundle;
+    SdfPath const _rprimPath;
+    uint64_t const _ticket;
+    uint64_t const _generation;
+};
+
+HD_DECLARE_DATASOURCE_HANDLES(HdStBasisCurvesGpuReadyProvider);
+
+/// Immutable renderer-neutral member description.  Scalar presentation is a
+/// value snapshot, so HdSt can verify that a prepared GPU bundle agrees with
+/// the paired curve tokens and conservative local bbox without retaining a
+/// mutable frontend datasource.
+struct HdStBasisCurvesGpuGroupMember {
+    uint32_t id = 0;
+    SdfPath rprimPath;
+    /// Value-only, renderer-neutral presentation snapshot.  No live scene
+    /// datasource is retained, so later source mutation cannot pair new
+    /// scalar presentation with an already-ready bundle.
+    struct Presentation {
+        TfToken curveType;
+        TfToken curveBasis;
+        TfToken curveWrap;
+        GfBBox3d bounds;
+        int refineLevel = 0;
+        TfToken purpose;
+        TfToken visibility;
+        SdfPath materialPath;
+        TfToken materialPurpose;
+        SdfPath primOrigin;
+        SdfPath dependencySurface;
+    } presentation;
+    HdStBasisCurvesGpuDataSourceHandle provider;
+};
+
+struct HdStBasisCurvesGpuGroupCandidate {
+    SdfPath groupPath;
+    uint64_t ticket = 0;
+    uint64_t generation = 0;
+    std::vector<HdStBasisCurvesGpuGroupMember> members;
+};
+
+using HdStBasisCurvesGpuGroupCandidateSharedPtr =
+    std::shared_ptr<HdStBasisCurvesGpuGroupCandidate const>;
+
+/// Prepared bundles are supplied in exactly the candidate member order.
+struct HdStBasisCurvesGpuGroupPreparedMember {
+    uint32_t id = 0;
+    HdStBasisCurvesGpuBundleSharedPtr bundle;
+};
+
+enum class HdStBasisCurvesGpuGroupResultStatus : uint8_t {
+    Rejected,
+    Ready,
+    Canceled
+};
+
+struct HdStBasisCurvesGpuGroupResult {
+    SdfPath groupPath;
+    uint64_t ticket = 0;
+    uint64_t generation = 0;
+    HdStBasisCurvesGpuGroupResultStatus status =
+        HdStBasisCurvesGpuGroupResultStatus::Rejected;
+    HdStBasisCurvesGpuRegistryIdentitySharedPtr registryIdentity;
+    std::vector<HdStBasisCurvesGpuReadyProviderHandle> providers;
+};
+
+/// Candidate admission is intentionally generic: empty and one-member groups
+/// are valid.  Application policies such as a maximum tile count are enforced
+/// by the frontend, not this HdSt extension.
+HDST_API
+bool HdStValidateBasisCurvesGpuGroupCandidate(
+    HdStBasisCurvesGpuGroupCandidate const &candidate);
+
+/// Validates the complete, already-Ready bundle set and creates providers
+/// scoped to \p identity.  A rejected result contains no provider handles.
+HDST_API
+HdStBasisCurvesGpuGroupResult HdStMakeBasisCurvesGpuGroupReadyResult(
+    HdStBasisCurvesGpuGroupCandidate const &candidate,
+    HdStBasisCurvesGpuRegistryIdentitySharedPtr const &identity,
+    std::vector<HdStBasisCurvesGpuGroupPreparedMember> const &prepared);
+
+/// Nonblocking endpoint shared by a per-renderer staging scene index and the
+/// renderer's post-Commit callback.  Cancellation is terminal; any queued or
+/// racing result is intentionally invisible to the frontend.  It is a raw
+/// transport: its serialized controller owns ticket/generation stale checks
+/// and exactly-once result admission.
+class HdStBasisCurvesGpuGroupMailbox final
+{
+public:
+    HDST_API HdStBasisCurvesGpuGroupMailbox();
+    HDST_API ~HdStBasisCurvesGpuGroupMailbox();
+    HDST_API void Post(HdStBasisCurvesGpuGroupResult result);
+    HDST_API bool TryPop(HdStBasisCurvesGpuGroupResult *result);
+    HDST_API void Cancel();
+    HDST_API bool IsCanceled() const;
+
+private:
+    std::atomic<bool> _canceled{false};
+    class _Queue;
+    std::unique_ptr<_Queue> _queue;
+};
+
+using HdStBasisCurvesGpuGroupMailboxSharedPtr =
+    std::shared_ptr<HdStBasisCurvesGpuGroupMailbox>;
+
+/// Opaque control datasource placed on a scope/control prim.  It carries no
+/// geometry and no renderer-specific resources.  A terminal observer copies
+/// Candidate(), while its post-Commit callback posts only to Mailbox().
+class HdStBasisCurvesGpuGroupDataSource : public HdDataSourceBase
+{
+public:
+    HD_DECLARE_DATASOURCE_ABSTRACT(HdStBasisCurvesGpuGroupDataSource);
+
+    virtual HdStBasisCurvesGpuGroupCandidateSharedPtr GetCandidate() const = 0;
+    virtual HdStBasisCurvesGpuGroupMailboxSharedPtr GetMailbox() const = 0;
+
+protected:
+    HDST_API ~HdStBasisCurvesGpuGroupDataSource() override;
+};
+
+HD_DECLARE_DATASOURCE_HANDLES(HdStBasisCurvesGpuGroupDataSource);
+
+PXR_NAMESPACE_CLOSE_SCOPE
+
+#endif // PXR_IMAGING_HD_ST_BASIS_CURVES_GPU_GROUP_DATA_SOURCE_H
