 bool
+HdStBasisCurves::_StageGpuPresentation(
+    HdSceneDelegate *sceneDelegate,
+    HdRenderParam *renderParam,
+    HdStBasisCurvesGpuBundle const &bundle)
+{
+    std::unique_ptr<_GpuPresentation> presentation(
+        new _GpuPresentation);
+    presentation->visible = sceneDelegate->GetVisible(GetId());
+    presentation->materialId = sceneDelegate->GetMaterialId(GetId());
+    presentation->transform = sceneDelegate->GetTransform(GetId());
+    presentation->displayStyle = GetDisplayStyle(sceneDelegate);
+    presentation->shadingStyle = sceneDelegate->GetShadingStyle(GetId())
+        .GetWithDefault<TfToken>();
+    presentation->materialNetworkShader = HdStGetMaterialNetworkShader(
+        this, sceneDelegate, presentation->materialId);
+    presentation->instancerId = sceneDelegate->GetInstancerId(GetId());
+    presentation->changeTracker =
+        &sceneDelegate->GetRenderIndex().GetChangeTracker();
+    if (!presentation->instancerId.IsEmpty()) {
+        // Constant primvars embed the instancer transform hierarchy.  Sync it
+        // before capturing that BAR, rather than after the capture as the
+        // ordinary draw-item path does.
+        HdInstancer::_SyncInstancerAndParents(
+            sceneDelegate->GetRenderIndex(), presentation->instancerId);
+    }
+
+    std::set<int> stagedConstantSlots;
+    std::set<int> stagedInstanceSlots;
+    for (auto const &reprPair : _reprs) {
+        for (HdRepr::DrawItemUniquePtr const &item :
+             reprPair.second->GetDrawItems()) {
+            HdStDrawItem * const drawItem =
+                static_cast<HdStDrawItem *>(item.get());
+            const int constantSlot =
+                drawItem->GetDrawingCoord()->GetConstantPrimvarIndex();
+            const bool stageConstants =
+                stagedConstantSlots.insert(constantSlot).second;
+
+            // Populate an independent full constant BAR.  The ordinary path
+            // updates the live shared-data slot before Commit; that would let
+            // a later Ready() failure leak a new transform or primvar.
+            HdRprimSharedData scratchSharedData(0);
+            scratchSharedData.rprimID = GetId();
+            scratchSharedData.bounds = bundle.bounds;
+            HdStDrawItem scratchDrawItem(&scratchSharedData);
+            *scratchDrawItem.GetDrawingCoord() = *drawItem->GetDrawingCoord();
+            scratchDrawItem.SetMaterialNetworkShader(
+                presentation->materialNetworkShader);
+
+            if (stageConstants) {
+                HdDirtyBits scratchDirtyBits =
+                    HdChangeTracker::DirtyTransform |
+                    HdChangeTracker::DirtyExtent |
+                    HdChangeTracker::DirtyPrimID |
+                    HdChangeTracker::DirtyPrimvar |
+                    HdChangeTracker::DirtyNormals |
+                    HdChangeTracker::DirtyWidths;
+                bool hasDisplayOpacity = false;
+                HdStPopulateConstantPrimvars(
+                    this, &scratchSharedData, sceneDelegate, renderParam,
+                    &scratchDrawItem, &scratchDirtyBits, nullptr,
+                    HdMeshGeomStyleInvalid, 0, 0, HdBufferSpecVector(),
+                    presentation->instancerId, nullptr, &hasDisplayOpacity,
+                    nullptr);
+
+                HdBufferArrayRangeSharedPtr const &range =
+                    scratchDrawItem.GetConstantPrimvarRange();
+                if (!range || !range->IsValid()) {
+                    TF_WARN("HdSt GPU BasisCurves candidate could not stage "
+                            "its constant primvar BAR");
+                    return false;
+                }
+                presentation->constantRanges.push_back({constantSlot, range});
+                presentation->displayOpacityFromPrimvars =
+                    presentation->displayOpacityFromPrimvars ||
+                    hasDisplayOpacity;
+            }
+
+            if (!presentation->instancerId.IsEmpty()) {
+                bool hasInstancerDisplayOpacity = false;
+                bool instancerStagingSucceeded = false;
+                HdStUpdateInstancerData(
+                    sceneDelegate->GetRenderIndex(), renderParam, GetId(),
+                    presentation->instancerId, &scratchDrawItem,
+                    &scratchSharedData,
+                    HdChangeTracker::DirtyInstancer |
+                        HdChangeTracker::DirtyInstanceIndex,
+                    &hasInstancerDisplayOpacity, nullptr,
+                    &instancerStagingSucceeded);
+                if (!instancerStagingSucceeded) {
+                    TF_WARN("HdSt GPU BasisCurves candidate could not "
+                            "stage instancer data");
+                    return false;
+                }
+                presentation->displayOpacityFromInstancer =
+                    presentation->displayOpacityFromInstancer ||
+                    hasInstancerDisplayOpacity;
+                presentation->instancerLevels =
+                    scratchSharedData.instancerLevels;
+
+                for (int level = 0;
+                     level < scratchSharedData.instancerLevels;
+                     ++level) {
+                    const int instanceSlot = scratchDrawItem.GetDrawingCoord()
+                        ->GetInstancePrimvarIndex(level);
+                    if (!stagedInstanceSlots.insert(instanceSlot).second) {
+                        continue;
+                    }
+                    HdBufferArrayRangeSharedPtr const &range =
+                        scratchDrawItem.GetInstancePrimvarRange(level);
+                    if (range && !range->IsValid()) {
+                        TF_WARN("HdSt GPU BasisCurves candidate could not "
+                                "stage an instance primvar BAR");
+                        return false;
+                    }
+                    presentation->instanceRanges.push_back({instanceSlot, range});
+                }
+
+                const int indexSlot = scratchDrawItem.GetDrawingCoord()
+                    ->GetInstanceIndexIndex();
+                if (stagedInstanceSlots.insert(indexSlot).second) {
+                    HdBufferArrayRangeSharedPtr const &range =
+                        scratchDrawItem.GetInstanceIndexRange();
+                    if (!range || !range->IsValid()) {
+                        TF_WARN("HdSt GPU BasisCurves candidate could not "
+                                "stage an instance index BAR");
+                        return false;
+                    }
+                    presentation->instanceRanges.push_back({indexSlot, range});
+                }
+            }
+        }
+    }
+
+    presentation->materialTag = _ComputeGpuMaterialTag(
+        sceneDelegate, presentation->materialId,
+        presentation->displayOpacityFromPrimvars ||
+            presentation->displayOpacityFromInstancer,
+        presentation->displayStyle);
+    _pendingGpuPresentation = std::move(presentation);
+    return true;
+}
