@@ -0,0 +1,5 @@
+# domain: primitive
+# A mask that falls off from the middle of the surface outwards, for driving a
+# clump or any other per-strand weight. Single statement on purpose: it is the
+# one preset that compiles against the frontend as it stands today.
+clamp(1.0 - 2.0 * smoothstep(abs($v - 0.5), 0.1, 0.45), 0.0, 1.0)
diff --git a/plugin/usdGenTools/resources/expressions/randomLength.se b/plugin/usdGenTools/resources/expressions/randomLength.se
new file mode 100644
index 0000000..8a86930
--- /dev/null
+++ b/plugin/usdGenTools/resources/expressions/randomLength.se
@@ -0,0 +1,7 @@
+# domain: primitive
+# Scatters strand length around the authored value. $spread is the fraction
+# either side of it, and the operator's own $seed moves the whole pattern
+# without changing its character.
+$spread = 0.35; # 0, 1
+$hash = sin($primIndex * 12.9898 + $seed * 78.233) * 43758.5453;
+$value * (1.0 + $spread * (2.0 * ($hash - floor($hash)) - 1.0))
diff --git a/plugin/usdGenTools/resources/expressions/rootTipTaper.se b/plugin/usdGenTools/resources/expressions/rootTipTaper.se
new file mode 100644
index 0000000..44c1c87
--- /dev/null
+++ b/plugin/usdGenTools/resources/expressions/rootTipTaper.se
@@ -0,0 +1,5 @@
+# domain: point
+# Narrows a strand from root to tip. $tip is the fraction of the root width
+# the tip keeps, so 1 is a cylinder and 0 a needle.
+$tip = 0.15; # 0, 1
+$value * fit(smoothstep($t, 0.0, 1.0), 0, 1, 1.0, $tip)
