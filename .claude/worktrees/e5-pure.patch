+    app.processEvents()
+    check("curve($t, 0.0, 1.0, 4, 1.0, 0.0, 4)" in dock.sourceEdit.toPlainText(),
+          "deleting a knot takes its triple out of the call")
+
+    ramp = '$ramp = ccurve($t, 0, [1, 0, 0], 4, 1, [0, 0, 1], 4); # ccurve\n$value'
