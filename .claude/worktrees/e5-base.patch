-    return g * mix(1.0, phi, 0.5) / (sqrt(2.0 * UGH_PI) * w);
-}
-
-// Cheap forward scattering (TT): strongest when the light is directly behind
-// the strand relative to the eye.
-float UsdGenHairTransmission(vec3 T, vec3 L, vec3 E)
