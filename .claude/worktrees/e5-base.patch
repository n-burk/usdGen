-void Check(bool ok, std::string const &what)
-{
-    if (!ok) {
-        ++g_failures;
-        std::printf("FAIL: %s\n", what.c_str());
-    } else {
-        std::printf("ok:   %s\n", what.c_str());
-    }
-}
