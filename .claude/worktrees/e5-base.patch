+                          "ceil($t * 4)", "fmod($t, 0.25)", "tan($t)", "atan2($t, 1)",
+                          "smoothstep($t, 0, 1)", "fit($t, 0, 1, 1.0, 0.15)",
+                          "mix(1.0, 0.15, $t)",
