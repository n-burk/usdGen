+    }
+    // kPure now matches what Lower() implements: a function that cannot lower
+    // is reported by the AST walk, with the supported list, instead of
+    // reaching the lowering pass.
+    for (auto const *s : {"noise($P)", "fbm($P)", "snoise($P)", "hash($primIndex)",
+                          "dot($P, $P)", "length($P)", "norm($P)", "cross($P, $P)",
