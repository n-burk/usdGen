-// Kajiya-Kay diffuse: the strand integrates the cosine lobe around its
-// circumference, which reduces to sin(angle(T,L)) = sqrt(1 - dot(T,L)^2).
-// "wrap" pushes energy past the terminator, faking the multiple scattering
-// that dominates the look of dense light fur.
-float UsdGenHairDiffuse(vec3 T, vec3 L, float wrap)
-{
-    float TdotL = clamp(dot(T, L), -1.0, 1.0);
-    float s = sqrt(max(0.0, 1.0 - TdotL * TdotL));
-    // Wrap on the cosine-with-the-tube-normal sense, cheaply approximated by
-    // remapping sin() which is already >= 0.
-    return clamp((s + wrap) / (1.0 + wrap), 0.0, 1.0);
-}
-
-// Marschner-lite longitudinal lobe. theta_h is the half-angle between the
-// light and eye longitudinal angles measured from the normal plane of the
-// strand; the lobe is a normalized Gaussian in theta_h shifted by `shift`.
-// (Cheaper and better behaved than Kajiya-Kay's pow(sin,e); it is the same
-// approximation used by Scheuermann-style real-time hair.)
-float UsdGenHairSpecular(vec3 T, vec3 L, vec3 E, float shift, float width)
-{
-    float sinThetaL = clamp(dot(T, L), -1.0, 1.0);
-    float sinThetaE = clamp(dot(T, E), -1.0, 1.0);
-    float thetaH = 0.5 * (asin(sinThetaL) + asin(sinThetaE)) - shift;
