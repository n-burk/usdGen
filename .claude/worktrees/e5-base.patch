+        bool named=false;
+        for (auto const &d:r.diagnostics) named |= d.find("supported functions are") != std::string::npos;
+        if (r.ok || !named) { ++fail; std::printf("FAIL unsupported function diagnostic for %s\n",s); }
+    }
+    // SupportedFunctions() is the single source of truth: everything it
+    // advertises must compile, with the arity it advertises.
+    for (auto const &info : Frontend::SupportedFunctions()) {
+        std::string call = info.name + "(";
+        for (uint32_t i=0;i<info.arity;++i) call += i ? ", 0.5" : "0.5";
+        call += ")";
+        if (!Frontend::Compile(call, {Domain::Groom, ScalarType::Float32, 1}).ok) {
+            ++fail; std::printf("FAIL advertised function does not lower: %s\n", info.signature.c_str());
+        }
+        std::string wrong = info.name + "(";
+        for (uint32_t i=0;i<info.arity+1;++i) wrong += i ? ", 0.5" : "0.5";
+        wrong += ")";
+        if (Frontend::Compile(wrong, {Domain::Groom, ScalarType::Float32, 1}).ok) {
+            ++fail; std::printf("FAIL wrong arity accepted: %s\n", wrong.c_str());
+        }
+    }
     std::printf("testUsdGenExpressionFrontend: %s\n", fail ? "FAILED" : "PASS");
     return fail;
 }
