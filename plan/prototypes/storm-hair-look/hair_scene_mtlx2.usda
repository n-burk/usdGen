    def "Looks"
    {
        def Material "HairPreview"
        {
            token outputs:surface.connect = </World/Looks/HairPreview/Surface.outputs:surface>

            def Shader "Surface"
            {
                custom asset info:glslfx:sourceAsset = @./usdGenHairPreview.glslfx@
                uniform token info:implementationSource = "sourceAsset"
                float inputs:randomValue = 0.25
                color3f inputs:rootColor = (0.03, 0.014, 0.006)
                float inputs:specular1Gain = 0.45
                float inputs:specular2Gain = 0.3
                color3f inputs:tipColor = (0.32, 0.17, 0.07)
                token outputs:surface
            }
        }

        def Material "HairMx"
        {
            token outputs:mtlx:surface.connect = </World/Looks/HairMx/Surface.outputs:out>

            def Shader "Absorb"
            {
                uniform token info:id = "ND_deon_hair_absorption_from_melanin"
                float inputs:melanin_concentration = 0.03
                float inputs:melanin_redness = 0.6
                float3 outputs:absorption
            }

            def Shader "Rough"
            {
                uniform token info:id = "ND_chiang_hair_roughness"
                float inputs:azimuthal = 0.22
                float inputs:longitudinal = 0.1
                float2 outputs:roughness_R
                float2 outputs:roughness_TRT
                float2 outputs:roughness_TT
            }

            def Shader "Bsdf"
            {
                uniform token info:id = "ND_chiang_hair_bsdf"
                float3 inputs:absorption_coefficient.connect = </World/Looks/HairMx/Absorb.outputs:absorption>
                float3 inputs:curve_direction.connect = </World/Looks/HairMx/TangentPV.outputs:out>
                float inputs:cuticle_angle = 0.5
                float inputs:ior = 1.55
                float2 inputs:roughness_R.connect = </World/Looks/HairMx/Rough.outputs:roughness_R>
                float2 inputs:roughness_TRT.connect = </World/Looks/HairMx/Rough.outputs:roughness_TRT>
                float2 inputs:roughness_TT.connect = </World/Looks/HairMx/Rough.outputs:roughness_TT>
                token outputs:out
            }

            def Shader "Surface"
            {
                uniform token info:id = "ND_surface"
                token inputs:bsdf.connect = </World/Looks/HairMx/Bsdf.outputs:out>
                float inputs:opacity = 1
                token outputs:out
            }

            def Shader "TangentPV"
            {
                uniform token info:id = "ND_geompropvalue_vector3"
                string inputs:geomprop = "hairTangent"
                float3 outputs:out
            }
        }
    }

    def "Lights"
    {
        def DistantLight "Key"
        {
            float inputs:intensity = 3
            float3 xformOp:rotateXYZ = (-35, 25, 0)
            uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
        }

        def DistantLight "Rim"
        {
            color3f inputs:color = (0.7, 0.85, 1)
            float inputs:intensity = 4
            float3 xformOp:rotateXYZ = (-10, 200, 0)
            uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
        }
    }

    def Camera "Cam"
    {
        float2 clippingRange = (0.1, 100)
        float focalLength = 50
        float horizontalAperture = 24
        float verticalAperture = 24
        double3 xformOp:translate = (0, 0.35, 5.2)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}

