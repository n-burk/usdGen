#usda 1.0
(
    defaultPrim = "Character"
    metersPerUnit = 0.01
    upAxis = "Y"
    startTimeCode = 1
    endTimeCode = 24
    timeCodesPerSecond = 24
    framesPerSecond = 24
    doc = "Schema discussion draft: hierarchy-ordered CUDA operators and execution-time SeExpr over GPU-resident geometry."
)

# Baseline: plan/02-schema.md, with plan/13-codebase-alignment.md overrides.
# Proposed extension: operator-expressions.md beside this file defines the
# new UsdGenExpression type, connections and per-attribute evaluation metadata.
# gpu-execution.md defines the CUDA, tool and renderer buffer contract.
# rbf-deformation.md records a host renderer/HiPhy research and the animation contract.
# The schema/adapters and a limited CUDA execution subset are implemented;
# the full operator network below still exceeds that executable subset.
# See cuda-width-network.usda for the tested source/Width tool-consumer path.
# This is an authored scene example, not a schema class-definition file.
# GuideInterpolate and Clump have no kernels in the plan v2 status table.
# Parsing this file does not imply it can cook yet.
# Omitted parameters use schema defaults; algorithmVersion=0 tracks latest.
#
# Execution: scatter -> interpolate -> clump -> frizz -> width -> deform
# References: head guides -> interpolate and clump
# Expressions: one groom-level CV count, primitive-level clump strength,
#              point-level frizz/width and a shared primitive-level mask.
# Publication: the description publishes its last logical result (deform).
# No usdGen:input or usdGen:terminal is authored: composed hierarchy orders ops,
# matching usdRig's reverse-sibling post-order, including nested operator prims.
# SeExpr programs compile with the graph; values evaluate DURING EXECUTION.
# All operators and expression values execute on CUDA. Geometry stays in device
# buffers across operators, brushes, picking and rendering. USD stores authored
# inputs and instructions; it never stores CUDA pointers or live buffer handles.
# customData.usdGen.evaluation = groom | primitive | point on numeric inputs.
# Strings, tokens and asset paths stay literal; relationships retain their roles.

def Xform "Character"
{
    # Five non-coplanar vertices for a small RBF binding example.
    # Face 0 and both guide roots retain their original rest positions.
    # Time samples stand in for an upstream animation/deformation provider.
    def Mesh "Scalp" (
        prepend apiSchemas = ["UsdGenRestAPI"]
    )
    {
        uniform token subdivisionScheme = "none"
        int[] faceVertexCounts = [3, 3, 3]
        int[] faceVertexIndices = [0, 1, 2, 2, 1, 3, 2, 3, 4]
        point3f[] points = [
            (0, 0, 0), (0, 0, 10), (10, 0, 0), (10, 2, 10), (15, 1, 5)
        ]
        point3f[] points.timeSamples = {
            1: [(0, 0, 0), (0, 0, 10), (10, 0, 0), (10, 2, 10), (15, 1, 5)],
            24: [(0, 0, 0), (0, 0, 10), (8, 2, 0), (8, 5, 10), (10, 6, 5)]
        }
        texCoord2f[] primvars:st = [(0, 0), (0, 1), (1, 0), (1, 1), (1.5, 0.5)] (
            interpolation = "vertex"
        )
        uniform token usdGen:rest:source = "primvar"
        point3f[] primvars:rest = [
            (0, 0, 0), (0, 0, 10), (10, 0, 0), (10, 2, 10), (15, 1, 5)
        ] (
            interpolation = "vertex"
        )
    }

    def UsdGenGroom "Groom"
    {
        # Proposed groom-wide requirement, inherited by every description/op.
        # "cuda" includes GPU-resident tools/rendering, with no CPU fallback.
        # Device selection and allocation are session state, not asset settings.
        custom uniform token usdGen:execution:backend = "cuda"

        def UsdGenDescription "hair"
        {
            # Operators inherit this surface unless they author an override.
            rel usdGen:surface = </Character/Scalp>
            uniform token usdGen:curve:basis = "bspline"

            # Bottom sibling first; descendants before their operator parent.
            # The compiler derives preceding-value dependencies from this order.
            def Scope "Ops"
            {
                def UsdGenDeform "deform"
                {
                    # Required animation path: rest-bound RBF surface deformation.
                    # The mode/sample-count properties already exist in the schema;
                    # a working CUDA RBF implementation is new required work.
                    rel usdGen:surface = </Character/Scalp>
                    # Toy fixture: all five vertices. Production budget starts
                    # around 100, then is tuned to the actual deformation domain.
                    int usdGen:rbfSamples = 5 (
                        customData = { dictionary usdGen = { string evaluation = "groom" } }
                    )
                    bool usdGen:lockRoots = true (
                        customData = { dictionary usdGen = { string evaluation = "primitive" } }
                    )
                }

                def UsdGenWidth "width"
                {
                    float usdGen:width = 0.03 (
                        customData = { dictionary usdGen = { string evaluation = "point" } }
                    )
                    float usdGen:width.connect = </Character/Groom/hair/Expressions/strandWidth.outputs:result>
                    # The expression supplies the taper, so the existing ramp is neutral.
                    float2[] usdGen:width:knots = [(0, 1), (1, 1)] (
                        customData = { dictionary usdGen = { string evaluation = "groom" } }
                    )
                    uniform token usdGen:width:interpolation = "linear"
                    bool usdGen:replace = true (
                        customData = { dictionary usdGen = { string evaluation = "groom" } }
                    )
                }

                # A grouping scope orders its descendants but does no computation.
                def Scope "style"
                {
                    def UsdGenNoise "frizz"
                    {
                        bool usdGen:enabled = true (
                            customData = { dictionary usdGen = { string evaluation = "groom" } }
                        )
                        bool usdGen:enabled.connect = </Character/Groom/hair/Expressions/enableFrizz.outputs:result>
                        uniform int usdGen:seed = 37 (
                            customData = { dictionary usdGen = { string evaluation = "groom" } }
                        )
                        float usdGen:noise:magnitude = 0.12 (
                            customData = { dictionary usdGen = { string evaluation = "point" } }
                        )
                        float usdGen:noise:magnitude.connect = </Character/Groom/hair/Expressions/frizzMagnitude.outputs:result>
                        float usdGen:noise:frequency = 3 (
                            customData = { dictionary usdGen = { string evaluation = "primitive" } }
                        )

                        # Same field, different local envelope: protect the
                        # roots.  The connection names the expression PRIM,
                        # which resolves to its outputs:result.
                        float usdGen:mask = 1 (
                            customData = { dictionary usdGen = { string evaluation = "primitive" } }
                        )
                        float usdGen:mask.connect = </Character/Groom/hair/Expressions/styleMask>
                    }

                    def UsdGenClump "clump"
                    {
                        rel usdGen:clump:centers = </Character/Groom/hair/Guides/head/curves>
                        uniform int usdGen:seed = 23 (
                            customData = { dictionary usdGen = { string evaluation = "groom" } }
                        )
                        float usdGen:clump:amount = 0.65 (
                            customData = { dictionary usdGen = { string evaluation = "primitive" } }
                        )
                        float usdGen:clump:amount.connect = </Character/Groom/hair/Expressions/clumpStrength.outputs:result>
                        float usdGen:clump:size = 5 (
                            customData = { dictionary usdGen = { string evaluation = "primitive" } }
                        )
                        float2[] usdGen:clump:profile:knots = [(0, 0), (1, 1)] (
                            customData = { dictionary usdGen = { string evaluation = "groom" } }
                        )
                        uniform token usdGen:clump:profile:interpolation = "linear"

                        # usdGen:mask is declared on UsdGenStyler, so every
                        # styler carries the operator envelope.
                        float usdGen:mask = 0.8 (
                            customData = { dictionary usdGen = { string evaluation = "primitive" } }
                        )
                        float usdGen:mask.connect = </Character/Groom/hair/Expressions/styleMask.outputs:result>
                    }
                }

                def UsdGenGuideInterpolate "interpolate"
                {
                    rel usdGen:guides = </Character/Groom/hair/Guides/head>
                    int usdGen:maxGuides = 2 (
                        customData = { dictionary usdGen = { string evaluation = "primitive" } }
                    )
                    int usdGen:cvCount = 8 (
                        customData = { dictionary usdGen = { string evaluation = "groom" } }
                    )
                    int usdGen:cvCount.connect = </Character/Groom/hair/Expressions/cvCount.outputs:result>
                    float usdGen:influenceRadius = 15 (
                        customData = { dictionary usdGen = { string evaluation = "primitive" } }
                    )
                    # Child source executes before this interpolation operator.
                    def UsdGenScatter "scatter"
                    {
                        uniform int usdGen:seed = 11 (
                            customData = { dictionary usdGen = { string evaluation = "groom" } }
                        )
                        float usdGen:density = 20 (
                            customData = { dictionary usdGen = { string evaluation = "groom" } }
                        )
                    }
                }
            }

            # Proposed reusable expression programs. The consuming attribute
            # selects evaluation granularity and supplies the input context.
            # outputs:result declares the type, not a stored evaluated value.
            def Scope "Expressions"
            {
                def UsdGenExpression "cvCount"
                {
                    custom string usdGen:expr:source = "4 * 2"
                    custom int outputs:result
                }

                def UsdGenExpression "enableFrizz"
                {
                    custom string usdGen:expr:source = "$frame >= 1"
                    custom bool outputs:result
                }

                def UsdGenExpression "clumpStrength"
                {
                    custom string usdGen:expr:source = "$value * (0.5 + 0.5 * $u)"
                    custom float outputs:result
                }

                def UsdGenExpression "frizzMagnitude"
                {
                    custom string usdGen:expr:source = "$value * $t"
                    custom float outputs:result
                }

                def UsdGenExpression "strandWidth"
                {
                    custom string usdGen:expr:source = "$value * (1 - 0.95 * $t)"
                    custom float outputs:result
                }

                def UsdGenExpression "styleMask"
                {
                    # $value is the consumer's literal: 0.8 on clump, 1 on frizz.
                    custom string usdGen:expr:source = "$value * (0.25 + 0.75 * $u)"
                    custom float outputs:result
                }
            }

            def Scope "Guides"
            {
                def UsdGenGuideSet "head"
                {
                    rel usdGen:surface = </Character/Scalp>

                    # Two 4-CV guides, packed in one BasisCurves prim (C3).
                    # Triangle UVs are weights for vertices 1 and 2:
                    # root = (1-u-v)*P0 + u*P1 + v*P2.
                    def BasisCurves "curves" (
                        prepend apiSchemas = ["UsdGenCurveAPI"]
                    )
                    {
                        uniform token purpose = "guide"
                        uniform token type = "cubic"
                        uniform token basis = "bspline"
                        uniform token wrap = "pinned"
                        int[] curveVertexCounts = [4, 4]
                        point3f[] points = [
                            (2, 0, 2), (2, 1, 2), (2.3, 2, 2), (3, 3, 2),
                            (2, 0, 6), (2, 1, 6), (2.3, 2, 6), (3, 3, 6)
                        ]
                        point3f[] primvars:rest = [
                            (2, 0, 2), (2, 1, 2), (2.3, 2, 2), (3, 3, 2),
                            (2, 0, 6), (2, 1, 6), (2.3, 2, 6), (3, 3, 6)
                        ] (interpolation = "vertex")
                        float[] primvars:widths = [0.06] (interpolation = "constant")
                        int[] primvars:skinprim = [0, 0] (interpolation = "uniform")
                        texCoord2f[] primvars:skinprimuv = [(0.2, 0.2), (0.6, 0.2)] (
                            interpolation = "uniform"
                        )
                        uint64[] primvars:usdGen:curveId = [101, 102] (
                            interpolation = "uniform"
                        )
                        token primvars:usdGen:role = "guide" (interpolation = "constant")
                    }
                }
            }

            # Generated hair is published under hair/__usdGenRender in Hydra.
            # That scope and its tiles are never authored into this file.
        }
    }
}
