#usda 1.0
(
    defaultPrim = "Groom"
)

def UsdGenGroom "Groom"
{
    def UsdGenDescription "Description"
    {
        def UsdGeomScope "Ops"
        {
            def UsdGenNoise "OpNoise"
            {
                float usdGen:magnitude = 0.1
            }

            def UsdGenLength "OpLength"
            {
                float usdGen:length = 1.0
                rel usdGen:input = </Description/Ops/OpNoise>
            }

            def UsdGenScatter "OpScatter"
            {
                int usdGen:seed = 42
                rel usdGen:input = </Description/Ops/OpLength>
            }
        }
    }
}
