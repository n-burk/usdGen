static void CheckLocatorIdentity(UsdPrim const &prim) {
  // Collect usdGen:* property names declared by this prim's schema.
  TfTokenVector const siblings = !prim.GetPrimTypeInfo().GetSchemaTypeName().GetString().empty()
      ? UsdSchemaRegistry::GetInstance().FindConcretePrimDefinition(
              prim.GetPrimTypeInfo().GetSchemaTypeName())->GetPropertyNames()
      : TfTokenVector();
  std::vector<TfToken> propNames;
  for (UsdAttribute attr : prim.GetAttributes()) {
      std::string n = attr.GetName().GetString();
      if (n.compare(0, 6, "usdGen:") == 0) propNames.push_back(TfToken(n));
  }
  // Also check inherited/defined properties via the schema.
  if (propNames.empty()) return;

  // Helper: extract token vector from HdDataSourceLocator.
  auto toks = [](HdDataSourceLocator const &l) -> std::vector<std::string> {
      std::vector<std::string> v;
      for (size_t i = 0; i < l.GetElementCount(); ++i) {
          v.push_back(l.GetElement(i).GetString());
      }
      return v;
  };

  // Contract asserts on ACTUAL locator outputs.
  // Ancestor: usdGen:length → final token must be length-value (relative locator, no usdGen prefix).
  HdDataSourceLocator a = UsdGenPrimAdapterBase::LocatorForProperty(
      TfToken("usdGen:length"), false, siblings);
  // Assert final token is length-value using toks helper
  auto t = toks(a);
  check(t.size() == 1 && t[0] == "length-value",
      "ancestor usdGen:length final token should be length-value");
  // Relationship variant per primAdapter.h:72-73; if prim has no rel pair: check(true,"no rel pair on prim"); else tokens end "length-rel"
  { HdDataSourceLocator r = UsdGenPrimAdapterBase::LocatorForProperty(
      TfToken("usdGen:length"), true, siblings);
    auto t2 = toks(r); check(t2.size() == 1 && t2[0] == "length-rel",
        "relationship variant length-rel"); }
  // Descendant: usdGen:length:source → must equal expected built independently
  // via captured-Appends (NOT using a.Append("source") which yields length-value/source — wrong).
  HdDataSourceLocator d = UsdGenPrimAdapterBase::LocatorForProperty(
      TfToken("usdGen:length:source"), false, siblings);
  HdDataSourceLocator exp;
  exp = exp.Append(TfToken("length"));
  exp = exp.Append(TfToken("source"));
  check(d==exp, "descendant unmoved");
  { HdDataSourceLocator s = UsdGenPrimAdapterBase::LocatorForProperty(TfToken("usdGen:seed"),false,siblings);
    HdDataSourceLocator exp2;
    exp2 = exp2.Append(TfToken("seed"));
    check(s==exp2, "non-collider unchanged"); }
  { HdDataSourceLocator m = UsdGenPrimAdapterBase::LocatorForProperty(TfToken("usdGen:length"),false,siblings); check(m==a, "dirty==mapped exact"); }
}

