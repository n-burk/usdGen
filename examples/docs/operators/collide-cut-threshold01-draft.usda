    def Xform "Groom" {
        def UsdGenDescription "Fur" (prepend apiSchemas = ["UsdGenLookAPI", "MaterialBindingAPI"]) {
            rel material:binding = </World/Looks/Fur>
            rel usdGen:surface = </World/Patch>
            token usdGen:curve:basis = "bspline"
            float usdGen:width:default = 0.0012
            int usdGen:look:jitterSeed = 113
            color3f usdGen:look:rootColor = (0.63, 0.40, 0.20)
            color3f usdGen:look:tipColor = (0.85, 0.65, 0.36)
            float usdGen:look:valueJitter = 0.055

            def Scope "Ops" {
            def UsdGenWidth "width" {
                float usdGen:width = 0.00125
                float2[] usdGen:width:knots = [(0, 1), (0.5, 0.62), (1, 0.018)]
            }
            def UsdGenCollide "collide" {
                rel usdGen:colliders = [</World/Shield>, </World/ScalpVolume>]
                float usdGen:pushAmount = 1
                float usdGen:offset = 0
                int usdGen:iterations = 128
                token usdGen:resolveType = "stiff"
                uniform token usdGen:deepPenetrationMode = "cutThenCollide"
                float usdGen:cutDepthThreshold = 0.01
                float usdGen:cutBlendDepth = 0.02
            }
            def UsdGenClump "clump" {
                float usdGen:clump:amount = 0.85
                float usdGen:clump:density = 36
                float usdGen:clump:size = 0.12
                float2[] usdGen:clump:profile:knots = [(0, 0), (0.3, 0.3), (1, 1)]
            }
            def UsdGenNoise "baseNoise" {
                int usdGen:seed = 37
                float usdGen:noise:magnitude = 0.0015
                float usdGen:noise:frequency = 3.5
                float2[] usdGen:noise:magnitude:knots = [(0, 0), (0.5, 0.24), (1, 1)]
            }
            def UsdGenBend "baseBend" {
                float usdGen:angle = 5
                float2[] usdGen:angle:knots = [(0, 0), (0.45, 0.35), (1, 1)]
                float2 usdGen:angleRandom = (0.68, 1.18)
            }
            def UsdGenGrow "grow" {
                int usdGen:seed = 19
                int usdGen:segments = 18
                float usdGen:length = 0.42
                float2 usdGen:lengthRandom = (0.88, 1.08)
                token usdGen:direction = "vector"
                vector3f usdGen:directionVector = (0.12, 0.99, 0.05)
            }
            def UsdGenScatter "scatter" {
                int usdGen:seed = 41
                float usdGen:density = 8000
            }
            }
        }
    }

