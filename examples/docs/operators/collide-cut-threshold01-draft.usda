def Xform "World" {
    def Camera "Cam" {
        matrix4d xformOp:transform = ( (0.73802881, 0.00000000, -0.67476920, 0.00000000), (-0.41784357, 0.78520237, -0.45701641, 0.00000000), (0.52983037, 0.61923925, 0.57950197, 0.00000000), (2.10000000, 1.95000000, 2.25000000, 1.00000000) )
