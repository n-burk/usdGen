    subLayers = [
        @./stoat-groom.usda@
    ]
)

over "World"
{
    over "Groom" (
        active = false
    )
    {
    }

    over "Guides"
    {
        over "BrownBody"
        {
            uniform token purpose = "default"
            float[] widths = [0.075]
        }

        over "CreamBody"
        {
            uniform token purpose = "default"
            float[] widths = [0.075]
        }

        over "BrownHead"
        {
            uniform token purpose = "default"
            float[] widths = [0.075]
        }

        over "CreamFace"
        {
            uniform token purpose = "default"
            float[] widths = [0.075]
        }

        over "Tail"
        {
            uniform token purpose = "default"
            float[] widths = [0.075]
        }

        over "DarkTip"
        {
            uniform token purpose = "default"
            float[] widths = [0.075]
        }
    }
}

