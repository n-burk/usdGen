    def Xform "Groom"
    {
        def UsdGenDescription "CreamFace" (
            prepend apiSchemas = ["UsdGenLookAPI", "MaterialBindingAPI"]
        )
        {
            rel material:binding = </World/FurLooks/CreamFace>
            uniform token usdGen:curve:basis = "bspline"
            color3f usdGen:look:rootColor = (0.72, 0.59, 0.43)
            color3f usdGen:look:tipColor = (1, 0.91, 0.75)
            rel usdGen:surface = </World/Character/body_M_hrc/GEO/body_M_geo/GroomCreamFace>
            float usdGen:width:default = 0.014

            def Scope "Ops"
            {
                def UsdGenWidth "width"
                {
                    bool usdGen:replace = 1
                    float usdGen:width = 0.014
                    uniform token usdGen:width:interpolation = "catmullRom"
                    float2[] usdGen:width:knots = [(0, 1), (0.62, 0.72), (1, 0.08)]
                }

                def UsdGenNoise "noise"
                {
                    float usdGen:noise:correlation = 0.7
                    float usdGen:noise:frequency = 2.5
                    float usdGen:noise:magnitude = 0.00875
                    float2[] usdGen:noise:magnitude:knots = [(0, 0), (0.55, 0.35), (1, 1)]
                    int usdGen:noise:octaves = 2
                    float usdGen:preserveLength = 1
                    uniform int usdGen:seed = 41
                }

                def UsdGenGuideInterpolate "interpolate"
                {
                    float usdGen:blendInSkinSpace = 1
                    uniform token usdGen:blendMethod = "extrudeAndBlend"
                    int usdGen:cvCount = 8
                    rel usdGen:guides = </World/Guides/CreamFace>
                    float usdGen:influenceDecay = 1.4
                    float usdGen:influenceRadius = 1.5
                    int usdGen:maxGuides = 3
                    float usdGen:randomizeGuide = 0.11
                    uniform int usdGen:seed = 21
                }

                def UsdGenScatter "scatter"
                {
                    float usdGen:density = 180
                    uniform int usdGen:seed = 11
                }
            }
        }

