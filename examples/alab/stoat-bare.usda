    subLayers = [
        @./stoat-groom.usda@
    ]
)

over "World"
{
    over "Groom" (
        active = false
    )
    {
    }

    over "Character"
    {
        over "body_M_hrc"
        {
            over "GEO"
            {
                over "tailHair_M_geo"
                {
                    token visibility = "inherited"
                }
            }
        }
    }

    over "TailTuftScalp"
    {
        token visibility = "invisible"
    }
}

