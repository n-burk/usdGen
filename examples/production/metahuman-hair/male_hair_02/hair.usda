#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 0.01
    subLayers = [
        @guides.usdc@,
        @strands.usdc@,
        @../skin.usdc@
    ]
    upAxis = "Z"
)

def Xform "World"
{
    matrix4d xformOp:transform = ( (100, 0, 0, 0), (0, -2.220446049250313e-14, 100.00000000000003, 0), (0, -100.00000000000003, -2.220446049250313e-14, 0), (0, 0, 0, 1) )

    def "Looks"
    {
        def Material "HairPreviewSurface"
        {
            token outputs:surface.connect = </World/Looks/HairPreviewSurface/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.12, 0.055, 0.022)
                float inputs:roughness = 0.35
                token outputs:surface
            }
        }

        def Material "SkinPreview"
        {
            token outputs:surface.connect = </World/Looks/SkinPreview/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.18, 0.1, 0.07)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }
    }

    over "Hair" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </World/Looks/HairPreviewSurface>
    }

    over "Scalp" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </World/Looks/SkinPreview>
    }

    def "Lights"
    {
        def DistantLight "Key"
        {
            float inputs:intensity = 3
            float3 xformOp:rotateXYZ = (-35, 25, 0)
            uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
        }

        def DistantLight "Rim"
        {
            float inputs:intensity = 4
            float3 xformOp:rotateXYZ = (-10, 200, 0)
            uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
        }
    }

    def Camera "Cam"
    {
        float2 clippingRange = (1, 10000)
        float focalLength = 50
        float horizontalAperture = 24
        float verticalAperture = 24
        double3 xformOp:translate = (0, 1.44, 1.1)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}
