#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Y"
    doc = "Root-to-tip strand width and a fading frizz envelope, both driven by SeExpr expressions on the CPU display lane."
)

# THE ROOT-TO-TIP WIDTH DEMO.
#
# Two connected parameters, both evaluated by the engine's expression lane:
#
#   usdGen:width on the Width operator  -> thick at the root, thin at the tip
#   usdGen:mask  on the Noise operator  -> the frizz fades across the plane
#
# WHAT AN EXPRESSION SEES
#   $value  the attribute's own authored literal. An expression REPLACES the
#           parameter, so it almost always multiplies or offsets $value rather
#           than ignoring it; that keeps the authored number meaningful.
#   $t      the root->tip parameter of the strand: 0 at the root, 1 at the tip.
#           Only defined at point granularity.
#   $u, $v  the strand root's surface coordinate, constant along one strand.
#   Also available: $P, $Pref, $rootP, $rootPref, $cLength, $cWidth, $id,
#   $primIndex, $primCount, $pointIndex, $pointCount, $frame, $time, $seed.
#
#   Functions: the SeExpr2 builtin library, which is what host-groomer expressions are
#   written against -- math (abs .. trunc, plus fit/mix/remap/bias/contrast and
#   the four step functions), noise (noise, snoise, fbm, turbulence, cellnoise,
#   voronoi and their v/c/p spellings, hash, rand), vector (dist, length, dot,
#   cross, norm, angle, ortho, rotate, up), colour (rgbtohsl, hsltorgb,
#   saturate, hsi, midhsi), curves (curve, ccurve, spline) and control (choose,
#   wchoose, pick). usdview's expression editor lists every one with its
#   signature, arity and category; the same list is plan/07's table, and both
#   come from Frontend::SupportedFunctions().
#
#   SeExpr argument orders are kept as SeExpr spells them, so an expression
#   pastes in and out of other SeExpr tools: smoothstep(x, a, b), not
#   smoothstep(a, b, x). External data is read through relationships on the
#   expression prim: geoSampler("<name>", ...) samples the geometry
#   input:<name> targets and ptex("<name>") the UsdGenPtexMap it targets (see
#   guide-interpolate-plane.usda and clump-ptex-plane.usda). printf,
#   map()/texture() and user-defined functions (def) are refused by name,
#   each with its own reason.
#
# THE LANGUAGE
#   An expression may be several statements separated by ";", with "#" comments
#   anywhere, local variables, and if/else blocks. The LAST expression is the
#   value:
#
#       $a = 0.5;            # a local
#       if ($u > 0.5) { $a = 0.8; } else { $a = 0.2; }
#       $value * $a
#
#   A local may not shadow a built-in ($t, $u, ... are read-only). Both arms of
#   an if are evaluated and the result selected, which is safe because every
#   function here is pure -- but it also means a branch is not a way to skip
#   expensive work.
#
#   A "# min, max" comment after a local is the convention SeExpr's UI reads to
#   attach a slider to it, which is why the width expression below is written
#   that way.
#
# GRANULARITY
#   Each consuming attribute carries
#       customData = { dictionary usdGen = { string evaluation = "point" } }
#   which chooses how often the expression runs: "groom" once, "primitive"
#   once per strand root, "point" once per CV. The schema ships a default per
#   attribute (usdGen:mask is "primitive"); override it on the attribute, as
#   usdGen:width does below. $t and $pointIndex need "point".
#
# CONNECTION SPELLINGS
#   A connection may name the expression PRIM or one of its outputs. Both
#   reach the engine as the same binding: a prim-path connection resolves to
#   outputs:result, or to the expression's single outputs:* attribute. Width
#   uses the explicit spelling below, Noise the prim spelling.
#
# IT RENDERS
#   The Description sits under a plain Xform, so it cooks on the CPU
#   reference lane -- the lane stock Storm can display. Expressions are
#   evaluated there by the same IR interpreter the CUDA kernels run
#   (libs/usdGen/usdGen/expressions/irExec.h), so the two lanes agree.
#   A UsdGenGroom parent would instead select the CUDA lane through its
#   usdGen:execution:backend fallback, which cooks but cannot yet hand its
#   device-resident result to stock Storm.
#
# EDITING
#   usdview -> menu "usdGen" -> "SeExpr Expression Editor" opens a dock that
#   follows the prim selection. Select /World/Groom/Fur/Expressions/
#   rootTipWidth (or the Width operator that consumes it) and edit the source;
#   the strands re-cook and re-publish.
#
# Execution order is the reverse of namespace order under Ops (bottom sibling
# first): scatter -> grow -> frizz -> width. No usdGen:input relationships
# are needed.
#
# View it:   .\bin\launch_usdview.ps1 examples\expression-width-plane.usda
# Record it: .\bin\record_usd.ps1 -Scene examples\expression-width-plane.usda `
#                -Output out.png -Camera /World/Cam -Complexity veryhigh

def Xform "World"
{
    # Eye (1.9, 1.3, 2.1) looking at (0.5, 0.12, 0.5), Y up.
    def Camera "Cam"
    {
        uniform token[] xformOpOrder = ["xformOp:transform"]
        matrix4d xformOp:transform = ( (0.752577, 0, -0.658505, 0), (-0.319565, 0.874354, -0.365217, 0), (0.575766, 0.485289, 0.658018, 0), (1.9, 1.3, 2.1, 1) )
        float2 clippingRange = (0.05, 50)
        float focalLength = 35
        float horizontalAperture = 24
        float verticalAperture = 18
    }

    # Key + a DomeLight fill so the physically based default hair material
    # (a UE port) doesn't render near-black under only usdrecord's camera
    # headlight. inputs:normalize = 1 is required on the DistantLight: HdSt
    # otherwise multiplies intensity by its (tiny, 0.53deg-default) solid
    # angle, so an un-normalized "intensity 3" comes out around 2e-4 and the
    # light is effectively invisible next to the headlight.
    def DistantLight "Key"
    {
        float inputs:intensity = 10
        bool inputs:normalize = 1
        color3f inputs:color = (1, 0.98, 0.94)
        float3 xformOp:rotateXYZ = (-10, 40, 0)
        uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
    }

    def DomeLight "Sky"
    {
        asset inputs:texture:file = @./maps/StinsonBeach.hdr@
        float inputs:intensity = 2
        color3f inputs:color = (1, 1, 1)
    }

    def Mesh "Plane" (
        prepend apiSchemas = ["UsdGenRestAPI"]
    )
    {
        uniform token subdivisionScheme = "none"
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 3, 2, 1]
        point3f[] points = [(0, 0, 0), (1, 0, 0), (1, 0, 1), (0, 0, 1)]
        texCoord2f[] primvars:st = [(0, 0), (1, 0), (1, 1), (0, 1)] (
            interpolation = "vertex"
        )
        point3f[] primvars:rest = [(0, 0, 0), (1, 0, 0), (1, 0, 1), (0, 0, 1)] (
            interpolation = "vertex"
        )
        color3f[] primvars:displayColor = [(0.25, 0.25, 0.28)]
    }

    def Xform "Groom"
    {
        def UsdGenDescription "Fur"
        {
            rel usdGen:surface = </World/Plane>
            uniform token usdGen:curve:basis = "bspline"
            float usdGen:width:default = 0.004

            def Scope "Ops"
            {
                # Terminal. usdGen:width is the literal the expression
                # receives as $value; the connection replaces it per CV, and
                # the evaluation override makes that per-CV run legal ($t is
                # undefined at the schema's default granularity).
                def UsdGenWidth "width"
                {
                    float usdGen:width = 0.012 (
                        customData = { dictionary usdGen = { string evaluation = "point" } }
                    )
                    float usdGen:width.connect = </World/Groom/Fur/Expressions/rootTipWidth.outputs:result>
                    bool usdGen:replace = true
                }

                # usdGen:mask is the per-operator effect weight declared on
                # UsdGenStyler and UsdGenDeformer: 1 applies the operator
                # fully, 0 leaves the upstream curves bit-for-bit untouched.
                # Connected here by PRIM path and evaluated once per curve
                # root (the schema default), so the frizz fades in across the
                # plane: $value is the literal 1 and $u is the root's surface
                # coordinate.
                def UsdGenNoise "frizz"
                {
                    int usdGen:seed = 7
                    float usdGen:noise:magnitude = 0.05
                    float usdGen:noise:frequency = 2.5
                    int usdGen:noise:octaves = 2
                    float usdGen:preserveLength = 1
                    float usdGen:mask = 1
                    float usdGen:mask.connect = </World/Groom/Fur/Expressions/strandMask>
                }

                def UsdGenGrow "grow"
                {
                    int usdGen:seed = 19
                    int usdGen:segments = 12
                    float usdGen:length = 0.3
                    float2 usdGen:lengthRandom = (0.8, 1.2)
                    uniform token usdGen:direction = "vector"
                    vector3f usdGen:directionVector = (0.35, 1, 0.2)
                }

                def UsdGenScatter "scatter"
                {
                    int usdGen:seed = 41
                    float usdGen:density = 800
                }
            }

            # Providers, never chain nodes. The output type is declared by the
            # typed custom outputs:* attribute and must match the consumer.
            def Scope "Expressions"
            {
                # Root-to-tip taper, written the way a SeExpr UI expects it:
                # two sliders and a curve control, then one line of arithmetic.
                #
                #   $rootWidth / $tipWidth  are the two ends of the taper. The
                #     "# min, max" comment is the slider range the editor reads.
                #   $profile  is a control curve over $t: 1 at the root, 0.7
                #     half way along, 0 at the tip, interpolated as a monotone
                #     spline (code 4), so the taper never bulges back out. Its
                #     knots are constants and are lowered into the instruction
                #     stream as immediates, so dragging a point in the UI
                #     rewrites numbers and nothing recompiles structurally.
                #   mix($tipWidth, $rootWidth, $profile) is then the multiplier
                #     on the authored $value.
                def UsdGenExpression "rootTipWidth"
                {
                    string usdGen:expr:source = """$rootWidth = 1.0;      # 0, 2
$tipWidth = 0.15;      # 0, 1
$profile = curve($t, 0, 1, 4, 0.5, 0.7, 4, 1, 0, 4);
$value * mix($tipWidth, $rootWidth, $profile)"""
                    custom float outputs:result
                }

                # Per-curve operator envelope, evaluated once per strand root.
                # Three things multiply together, all inside [0, 1] so the mask
                # stays a legal weight:
                #   $fade       no frizz at u = 0, full frizz at u = 1, so the
                #               effect ramps across the plane;
                #   $variation  rand(1234) is the host groomer's rand, not SeExpr's: it is
                #               hashed from the operator's $seed, the strand's
                #               $id and this call site, so it is a different
                #               number per strand and the SAME number on every
                #               cook and on either execution lane;
                #   $grain      three octaves of fbm over the root UV, so
                #               neighbouring strands frizz together in patches
                #               instead of independently.
                def UsdGenExpression "strandMask"
                {
                    string usdGen:expr:source = """$fade = $u;
$variation = 0.75 + 0.25 * rand(1234);
$grain = fbm([$u * 3, $v * 3, 0], 3);
$value * $fade * $variation * (0.7 + 0.3 * $grain)"""
                    custom float outputs:result
                }
            }
        }
    }
}
