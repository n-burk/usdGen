        def Scope "Groom"
        {
            def UsdGenDescription "Hair" (
                prepend apiSchemas = ["UsdGenLookAPI", "MaterialBindingAPI"]
            )
            {
                rel material:binding = </World/Looks/Fibre>
                color3f usdGen:look:rootColor = (0.72, 0.48, 0.08)
                color3f usdGen:look:tipColor = (0.8, 0.6, 0.13)
                rel usdGen:surface = </World/Motion/Scalp>

                def "Maps"
                {
                    def UsdGenPtexMap "Regions"
                    {
                        float usdGen:map:blur = 0
                        int usdGen:map:channelCount = 1
                        asset usdGen:map:file = @maps/two_regions.ptx@
                        token usdGen:map:filter = "nearest"
                        int usdGen:map:firstChannel = 0
                    }
                }

                def Scope "Ops"
                {
                    reorder nameChildren = ["regionAnimate", "width", "guideGrow", "roots"]
                    def UsdGenCurveSource "roots"
                    {
                        rel usdGen:curves = </World/Motion/RestInputs/RootSeeds>
                        uniform token usdGen:idSource = "primvar"
                        uniform token usdGen:rebind = "onError"
                        bool usdGen:useRest = 1
                    }

                    def UsdGenGuideInterpolate "guideGrow"
                    {
                        float usdGen:blendInSkinSpace = 0
                        int usdGen:cvCount = 64
                        rel usdGen:guides = </World/Motion/RestInputs/Guides>
                        float usdGen:influenceRadius = 1
                        int usdGen:maxGuides = 1
                        custom rel usdGen:regionMap = </World/Motion/Groom/Hair/Maps/Regions>
                        bool usdGen:useUniqueGuide = 1
                    }

                    def UsdGenWidth "width"
                    {
                        bool usdGen:replace = 1
                        float usdGen:width = 0.0032
                    }

                    def UsdGenDeform "regionAnimate"
                    {
                        int[] usdGen:guideRegions = [0, 1]
                        rel usdGen:guides = </World/Motion/Drivers>
                        bool usdGen:lockRoots = 0
                        uniform token usdGen:mode = "curveWrap"
                        rel usdGen:regionMap = </World/Motion/Groom/Hair/Maps/Regions>
                    }
                }
            }
        }
    }

    def "Looks"
    {
        def Material "Cloth"
        {
            token outputs:surface.connect = </World/Looks/Cloth/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.52, 0.31, 0.045)
                float inputs:roughness = 0.9
                token outputs:surface
            }
        }

        def Material "Fibre"
        {
            token outputs:surface.connect = </World/Looks/Fibre/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.72, 0.48, 0.08)
                float inputs:roughness = 0.9
                token outputs:surface
            }
        }

        def Material "Regions"
        {
            token outputs:surface.connect = </World/Looks/Regions/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </World/Looks/Regions/Tex.outputs:rgb>
                float inputs:roughness = 0.85
                token outputs:surface
            }

            def Shader "UV"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "Tex"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @maps/two_regions.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </World/Looks/Regions/UV.outputs:result>
                float3 outputs:rgb
            }
        }
    }

    def Camera "Camera"
    {
        float2 clippingRange = (0.01, 100)
        float focalLength = 55
        float horizontalAperture = 36
        float verticalAperture = 20.25
        matrix4d xformOp:transform = ( (1, 0, -0, 0), (0, 0.24253562503633305, 0.970142500145332, 0), (0, -0.970142500145332, 0.24253562503633305, 0), (0, -3.4000000000000004, 1.1000000000000003, 1) )
        uniform token[] xformOpOrder = ["xformOp:transform"]
    }

    def DistantLight "Key"
    {
        float inputs:angle = 15
        float inputs:intensity = 1
        bool inputs:normalize = 1
        matrix4d xformOp:transform = ( (0.894427190999916, -0.447213595499958, 0, 0), (0.3585685828003181, 0.7171371656006362, 0.5976143046671968, 0), (-0.26726124191242434, -0.5345224838248487, 0.8017837257372731, 0), (-0.9999999999999999, -1.9999999999999998, 2.9999999999999996, 0.9999999999999999) )
        uniform token[] xformOpOrder = ["xformOp:transform"]
    }

    def DomeLight "Fill"
    {
        float inputs:intensity = 0.6
        asset inputs:texture:file = @../felt/textures/studio.exr@
    }

    def Points "RegionSeedsReverse"
    {
        point3f[] points = [(0.25, 0, 0.5), (-0.25, 0, 0.5)]
        uniform token purpose = "guide"
        token visibility = "invisible"
        float[] widths = [0.003, 0.003]
    }
}

