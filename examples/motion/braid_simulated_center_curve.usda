        def Scope "Groom"
        {
            def UsdGenDescription "Hair" (
                prepend apiSchemas = ["UsdGenLookAPI", "MaterialBindingAPI"]
            )
            {
                rel material:binding = </World/Looks/Fibre>
                custom color3f usdGen:look:rootColor = (0.72, 0.48, 0.08)
                custom color3f usdGen:look:tipColor = (0.8, 0.6, 0.13)
                custom rel usdGen:surface = </World/Motion/Sphere>

                def Scope "Ops"
                {
                    reorder nameChildren = ["guideAnimate", "width", "guideGrow", "roots"]
                    def UsdGenCurveSource "roots"
                    {
                        custom rel usdGen:curves = </World/Motion/RestInputs/RootSeeds>
                        custom token usdGen:idSource = "primvar"
                        custom token usdGen:rebind = "onError"
                        custom bool usdGen:useRest = 1
                    }

                    def UsdGenGuideInterpolate "guideGrow"
                    {
                        custom float usdGen:blendInSkinSpace = 0
                        custom int usdGen:cvCount = 64
                        custom rel usdGen:guides = </World/Motion/RestInputs/Guides>
                        custom float usdGen:influenceRadius = 0.05
                        custom int usdGen:maxGuides = 1
                        custom bool usdGen:useUniqueGuide = 1
                    }

                    def UsdGenWidth "width"
                    {
                        custom bool usdGen:replace = 1
                        custom float usdGen:width = 0.0032
                        custom float2[] usdGen:width:knots = [(0, 1), (0.85, 1), (1, 0.35)]
                    }

                    def UsdGenDeform "guideAnimate" (
                        doc = "Wrap the rest-grown braid around one simulated centerline using rotation-minimizing frames. No RBF or hidden driver cage."
                    )
                    {
                        custom rel usdGen:guides = </World/Motion/SimulatedCenter>
                        custom bool usdGen:lockRoots = 0
                        custom token usdGen:mode = "curveWrap"
                    }
                }
            }
        }

