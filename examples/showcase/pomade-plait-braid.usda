    {
        uniform token[] xformOpOrder = ["xformOp:transform"]
        matrix4d xformOp:transform = ( (0.747409, 0, -0.664364, 0), (-0.147916, 0.9749, -0.166405, 0), (0.647688, 0.222643, 0.728649, 0), (1.6, 1.1, 2.2, 1) )
