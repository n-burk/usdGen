    def UsdGenPtexMap "RegionMap"
    {
        int usdGen:map:channelCount = 1
        float2 usdGen:map:clamp = (0, 0)
        token usdGen:map:filter = "nearest"
        int usdGen:map:firstChannel = 0
    }

    def UsdGenExpression "RegionExpr"
    {
        rel input:regionMap = </PomadeGroom/RegionMap>
        custom float outputs:result
        custom uniform string usdGen:expr:source = 'ptex("regionMap")'
    }

    def UsdGenPtexMap "RegionMapL2"
    {
        int usdGen:map:channelCount = 1
        float2 usdGen:map:clamp = (0, 0)
        token usdGen:map:filter = "nearest"
        int usdGen:map:firstChannel = 1
    }

    def UsdGenExpression "RegionExprL2"
    {
        rel input:regionMap = </PomadeGroom/RegionMapL2>
        custom float outputs:result
        custom uniform string usdGen:expr:source = 'ptex("regionMap")'
    }

    def UsdGenPtexMap "RegionMapL3"
    {
        int usdGen:map:channelCount = 1
        float2 usdGen:map:clamp = (0, 0)
        token usdGen:map:filter = "nearest"
        int usdGen:map:firstChannel = 2
    }

    def UsdGenExpression "RegionExprL3"
    {
        rel input:regionMap = </PomadeGroom/RegionMapL3>
        custom float outputs:result
        custom uniform string usdGen:expr:source = 'ptex("regionMap")'
    }
}

def Xform "World"
{
    def Camera "Cam"
    {
        matrix4d xformOp:transform = ( (0.749, 0, -0.663, 0), (-0.166, 0.968, -0.188, 0), (0.641, 0.251, 0.725, 0), (4.6, 3, 6, 1) )
        uniform token[] xformOpOrder = ["xformOp:transform"]
    }

    def Mesh "Scalp"
    {
        float3[] extent = [(0, 0, 0), (4, 0, 4)]
        int[] faceVertexCounts = [4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4]
        int[] faceVertexIndices = [0, 1, 6, 5, 1, 2, 7, 6, 2, 3, 8, 7, 3, 4, 9, 8, 5, 6, 11, 10, 6, 7, 12, 11, 7, 8, 13, 12, 8, 9, 14, 13, 10, 11, 16, 15, 11, 12, 17, 16, 12, 13, 18, 17, 13, 14, 19, 18, 15, 16, 21, 20, 16, 17, 22, 21, 17, 18, 23, 22, 18, 19, 24, 23]
