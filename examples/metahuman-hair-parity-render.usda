def Scope "Looks"
{
    def Material "Backdrop"
    {
        token outputs:surface.connect = </Looks/Backdrop/Surface.outputs:surface>

        def Shader "Surface"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0, 0, 0)
            color3f inputs:emissiveColor = (0.82, 0.82, 0.82)
            float inputs:roughness = 1
            token outputs:surface
        }
    }
}
