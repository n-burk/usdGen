#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Y"
    doc = "Head-hair close-up: a dense, dark, combed groom on a head-sized ellipsoid, fading to bare skin at a scalp-cap boundary -- a render-comparison scene for a character groom (renders/hair-parity)."
)

# Numbers are centimetres by convention (as in styled-fur-plane.usda: hair
# widths of 0.004-0.012, lengths of 0.25-0.4 there read as a small swatch;
# here the head itself is ~17 x 20 x 18 cm and strands are 3-6cm).
#
# FADE MECHANISM
#   Scatter roots the whole Head ellipsoid uniformly (usdGen:density is one
#   groom-wide scalar; binding usdGen:surface to a scalp GeomSubset would
#   restrict the roots, but with a hard edge, and a fade is graded:
#   see the Head mesh comment below). An expression
#   (Expressions/scalpFade, elevation -> [0, 1], elevation being the mesh's
#   own "v" -- 1 at the crown, 0 at the far pole) shrinks each strand toward
#   zero as its root drops from 0.66 to 0.3 elevation, connected to BOTH the
#   Length value and the Width base so short hairs thin out too. Length's
#   usdGen:cullThreshold then zero-lengthens (hides) whatever the fade has
#   shrunk past a visible length, so most of the head reads as bare skin even
#   though every strand was scattered.
#
# Two cameras: TempleCam frames the crown/fade transition like the
# reference photo, HeadCam is a medium shot of the whole head.
#
# View it:   .\bin\launch_usdview.ps1 examples\head-hair-closeup.usda
# Record it: .\bin\render_hair_parity.ps1 -Label current

def Xform "World"
{
    def Camera "TempleCam"
    {
        uniform token[] xformOpOrder = ["xformOp:transform"]
        matrix4d xformOp:transform = ( (0.578017, 0, 0.816024, 0), (0.37075, 0.89083, -0.262615, 0), (-0.726939, 0.454337, 0.514915, 0), (-19, 4, 9.5, 1) )
        float2 clippingRange = (0.05, 500)
        float focalLength = 42
        float horizontalAperture = 24
        float verticalAperture = 18
    }

    def Camera "HeadCam"
    {
        uniform token[] xformOpOrder = ["xformOp:transform"]
        matrix4d xformOp:transform = ( (0.780869, 0, -0.624695, 0), (-0.157358, 0.967754, -0.196698, 0), (0.604551, 0.251896, 0.755689, 0), (24, 9, 30, 1) )
        float2 clippingRange = (0.05, 500)
        float focalLength = 40
        float horizontalAperture = 24
        float verticalAperture = 18
    }

    def DistantLight "Key"
    {
        uniform token[] xformOpOrder = ["xformOp:transform"]
        matrix4d xformOp:transform = ( (-0.489554, 0, 0.871973, 0), (0.657574, 0.656734, 0.369183, 0), (-0.572655, 0.754122, -0.321507, 0), (-12, 14, 16, 1) )
        float inputs:intensity = 8.246
        bool inputs:normalize = 1
        color3f inputs:color = (1, 0.98, 0.94)
    }

    def DistantLight "Rim"
    {
        uniform token[] xformOpOrder = ["xformOp:transform"]
        matrix4d xformOp:transform = ( (-0.0477485, 0, -0.998859, 0), (0.0067171, 0.999977, -0.000321098, 0), (0.998837, -0.00672477, -0.0477475, 0), (4, 10, -14, 1) )
        float inputs:intensity = 2.604
        bool inputs:normalize = 1
        color3f inputs:color = (0.85, 0.9, 1)
    }

    # A DomeLight with no inputs:texture:file compiles Storm's whole indirect-
    # lighting block out, so the fill needs a real HDRI, not just a colour --
    # this one ships with the OpenUSD prefix itself (Hdx's own test asset).
    # Intensity is well under Key's (~1:3) so it reads as soft ambient fill.
    def DomeLight "Sky"
    {
        asset inputs:texture:file = @./maps/StinsonBeach.hdr@
        float inputs:intensity = 2.17
        color3f inputs:color = (1, 1, 1)
    }

    def Scope "Looks"
    {
        def Material "Skin"
        {
            token outputs:surface.connect = </World/Looks/Skin/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.80, 0.62, 0.52)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }
    }

    def Mesh "Head" (
        prepend apiSchemas = ["UsdGenRestAPI", "MaterialBindingAPI"]
    )
