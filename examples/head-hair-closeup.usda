            (0.4625, 0.0357143), (0.475, 0.0357143), (0.4875, 0.0357143), (0.5, 0.0357143), (0.5125, 0.0357143), (0.525, 0.0357143),
            (0.5375, 0.0357143), (0.55, 0.0357143), (0.5625, 0.0357143), (0.575, 0.0357143), (0.5875, 0.0357143), (0.6, 0.0357143),
            (0.6125, 0.0357143), (0.625, 0.0357143), (0.6375, 0.0357143), (0.65, 0.0357143), (0.6625, 0.0357143), (0.675, 0.0357143),
            (0.6875, 0.0357143), (0.7, 0.0357143), (0.7125, 0.0357143), (0.725, 0.0357143), (0.7375, 0.0357143), (0.75, 0.0357143),
            (0.7625, 0.0357143), (0.775, 0.0357143), (0.7875, 0.0357143), (0.8, 0.0357143), (0.8125, 0.0357143), (0.825, 0.0357143),
            (0.8375, 0.0357143), (0.85, 0.0357143), (0.8625, 0.0357143), (0.875, 0.0357143), (0.8875, 0.0357143), (0.9, 0.0357143),
            (0.9125, 0.0357143), (0.925, 0.0357143), (0.9375, 0.0357143), (0.95, 0.0357143), (0.9625, 0.0357143), (0.975, 0.0357143),
            (0.9875, 0.0357143), (0, 0.0178571), (0.0125, 0.0178571), (0.025, 0.0178571), (0.0375, 0.0178571), (0.05, 0.0178571),
            (0.0625, 0.0178571), (0.075, 0.0178571), (0.0875, 0.0178571), (0.1, 0.0178571), (0.1125, 0.0178571), (0.125, 0.0178571),
            (0.1375, 0.0178571), (0.15, 0.0178571), (0.1625, 0.0178571), (0.175, 0.0178571), (0.1875, 0.0178571), (0.2, 0.0178571),
            (0.2125, 0.0178571), (0.225, 0.0178571), (0.2375, 0.0178571), (0.25, 0.0178571), (0.2625, 0.0178571), (0.275, 0.0178571),
            (0.2875, 0.0178571), (0.3, 0.0178571), (0.3125, 0.0178571), (0.325, 0.0178571), (0.3375, 0.0178571), (0.35, 0.0178571),
            (0.3625, 0.0178571), (0.375, 0.0178571), (0.3875, 0.0178571), (0.4, 0.0178571), (0.4125, 0.0178571), (0.425, 0.0178571),
            (0.4375, 0.0178571), (0.45, 0.0178571), (0.4625, 0.0178571), (0.475, 0.0178571), (0.4875, 0.0178571), (0.5, 0.0178571),
            (0.5125, 0.0178571), (0.525, 0.0178571), (0.5375, 0.0178571), (0.55, 0.0178571), (0.5625, 0.0178571), (0.575, 0.0178571),
            (0.5875, 0.0178571), (0.6, 0.0178571), (0.6125, 0.0178571), (0.625, 0.0178571), (0.6375, 0.0178571), (0.65, 0.0178571),
            (0.6625, 0.0178571), (0.675, 0.0178571), (0.6875, 0.0178571), (0.7, 0.0178571), (0.7125, 0.0178571), (0.725, 0.0178571),
            (0.7375, 0.0178571), (0.75, 0.0178571), (0.7625, 0.0178571), (0.775, 0.0178571), (0.7875, 0.0178571), (0.8, 0.0178571),
            (0.8125, 0.0178571), (0.825, 0.0178571), (0.8375, 0.0178571), (0.85, 0.0178571), (0.8625, 0.0178571), (0.875, 0.0178571),
            (0.8875, 0.0178571), (0.9, 0.0178571), (0.9125, 0.0178571), (0.925, 0.0178571), (0.9375, 0.0178571), (0.95, 0.0178571),
            (0.9625, 0.0178571), (0.975, 0.0178571), (0.9875, 0.0178571), (0.5, 0)
        ] (
            interpolation = "vertex"
        )
        color3f[] primvars:displayColor = [(0.80, 0.62, 0.52)]
        rel material:binding = </World/Looks/Skin>
    }

    def Xform "Groom"
    {
        def UsdGenDescription "Hair" (
            prepend apiSchemas = ["UsdGenLookAPI"]
        )
        {
            rel usdGen:surface = </World/Head>
            uniform token usdGen:curve:basis = "bspline"
            float usdGen:width:default = 0.005

            # Dark brown root -> lighter brown tip (schema's own displayColor bake;
            # no material is bound here, matching the other examples -- the engine
            # binds a default hair material and this only supplies its colour).
            color3f usdGen:look:rootColor = (0.03, 0.02, 0.015)
            color3f usdGen:look:tipColor = (0.09, 0.06, 0.04)

            def Scope "Ops"
            {
                # Terminal. Root width ~0.01cm tapering to 30% (~0.003cm) at the
                # tip, then multiplied by the same elevation fade as Length so
                # strands thin out before they are culled away entirely.
                def UsdGenWidth "width"
                {
                    float usdGen:width = 0.01 (
                        customData = { dictionary usdGen = { string evaluation = "primitive" } }
                    )
                    float usdGen:width.connect = </World/Groom/Hair/Expressions/scalpFade.outputs:result>
                    float2[] usdGen:width:knots = [(0, 1), (0.55, 0.7), (1, 0.3)]
                    uniform token usdGen:width:interpolation = "catmullRom"
                    bool usdGen:replace = true
                }

                # The fade: scales the ~3-5cm top length down toward the scalp cap's
                # lower edge, passing through a 2-5mm "stubble" band on the way;
                # usdGen:cullThreshold then zero-lengthens (hides) whatever the fade
                # shrinks past 0.18cm, so only the very bottom reads as true bare skin.
                def UsdGenLength "fade"
                {
                    uniform token usdGen:length:mode = "scale"
                    float usdGen:length:value = 1.0
                    float usdGen:length:value.connect = </World/Groom/Hair/Expressions/scalpFade.outputs:result>
                    float2 usdGen:length:random = (0.8, 1.2)
                    uniform token usdGen:length:method = "scale"
                    uniform token usdGen:rebuild = "keepParam"
                    float usdGen:cullThreshold = 0.18
                }

                # Chunky clumps (reference photo's "soft, chunky clumps ... visible
                # tips along the silhouette"): linearBlend converges each clump's CVs
                # toward its centre strand at the same parameter, so TIPS bunch into
                # visible points rather than staying parallel. levels=2 splits every
                # clump into smaller sub-clumps for the layered, non-uniform chunking
                # real hair shows; clump centres are auto-scattered (usdGen:clump:map
                # left unconnected) so no clump map needs baking. A small root pull
                # (profile:knots start > 0) keeps roots from splaying at the scalp so
                # gaps between clumps do not show it through.
                def UsdGenClump "clump"
                {
                    int usdGen:seed = 71
                    float usdGen:clump:amount = 0.8
                    float2[] usdGen:clump:profile:knots = [(0, 0.25), (1, 1)]
                    float usdGen:clump:density = 3.5
                    float usdGen:clump:size = 2.2
                    int usdGen:clump:levels = 2
                    float usdGen:clump:sizeReduction = 0.45
                    float usdGen:clump:tightnessReduction = 0.65
                    uniform token usdGen:clump:method = "linearBlend"
                    float usdGen:clump:stray:rate = 0.05
                    float usdGen:clump:stray:amount = 0.75
                    float usdGen:clump:stray:falloff = 0.55
                    float usdGen:preserveLength = 1
                }

                # Gentle large-scale coil over the frizzed strands (runs right after
                # frizz): a small radius keeps the wave subtle on these 3-6cm strands
                # while the low frequency (turns per cm: ~one turn over a strand)
                # gives a loose combed wave rather than tight ringlets. Taper stays
                # at its schema default so roots stay planted.
                def UsdGenCurl "curl"
                {
                    float usdGen:radius = 0.08
                    float usdGen:frequency = 0.25
                }

                # Subtle frizz -- correlated fBm displacement along the still-radial
                # root normal. Correlation 0.55 keeps neighbouring strands waving
                # together instead of fraying independently. Grow leans strands off
                # the pure radial normal (below) so the displacement shows as gentle
                # waviness instead of sliding each strand along itself. A Curl op
                # downstream adds the broader combed wave on top of this fine detail.
                def UsdGenNoise "frizz"
                {
                    int usdGen:seed = 5
                    float usdGen:noise:magnitude = 0.08
                    float2[] usdGen:noise:magnitude:knots = [(0, 0), (0.4, 0.3), (1, 1)]
                    float usdGen:noise:frequency = 1.8
                    float usdGen:noise:correlation = 0.55
                    int usdGen:noise:octaves = 2
                    float usdGen:preserveLength = 1
                }

                # Strands out of the scalp, swept up/back toward the crown by rotating
                # the growth direction around the root binormal. usdGen:lift is driven
                # per elevation by Expressions/combLift (primitive evaluation): upright
                # ~11deg stubble at/below the fade band rising to the full swept 74deg
                # on top. The 74 literal stays as the $value fallback.
                def UsdGenGrow "grow"
                {
                    int usdGen:seed = 19
                    int usdGen:segments = 12
                    float usdGen:length = 3.8
                    float2 usdGen:lengthRandom = (0.75, 1.25)
                    uniform token usdGen:direction = "surfaceNormal"
                    float usdGen:lift = 74 (
                        customData = { dictionary usdGen = { string evaluation = "primitive" } }
                    )
                    float usdGen:lift.connect = </World/Groom/Hair/Expressions/combLift.outputs:result>
                }

                # Runs first: roots over the whole Head (see the mesh comment above
                # on why this is not restricted to a scalp subset).
                def UsdGenScatter "scatter"
                {
                    int usdGen:seed = 41
                    float usdGen:density = 450
                }
            }

            def Scope "Expressions"
            {
                # Elevation fade: 1 across the dense crown, ramping to 0 as the
                # strand root nears the scalp cap's lower (bald) edge. $v is the
                # root's primvars:st.t, which this mesh authored as elevation (1 at
                # the crown, 0 at the far pole), so no vector math is needed.
                def UsdGenExpression "scalpFade"
                {
                    string usdGen:expr:source = """$e = curve($v, 0.3, 0, 4, 0.48, 0.5, 4, 0.66, 1, 4);
$value * $e"""
                    custom float outputs:result
                }

                # Per-elevation comb lift: upright stubble low, full sweep on top.
                # $v is the root's primvars:st.t (1 at the crown, 0 at the far pole);
                # $value is Grow's authored 74deg lift, scaled from 0.15 (~11deg)
                # at/below the fade band to 1 (74deg) above it.
                def UsdGenExpression "combLift"
                {
                    string usdGen:expr:source = """$e = curve($v, 0.3, 0.15, 4, 0.48, 0.575, 4, 0.66, 1, 4);
$value * $e"""
                    custom float outputs:result
                }
            }
        }
    }
}
