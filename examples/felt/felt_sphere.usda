#usda 1.0
(
    defaultPrim = "FeltSphere"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "FeltSphere"
{
    def Scope "Looks"
    {
        def Material "Cloth"
        {
            token outputs:surface.connect = </FeltSphere/Looks/Cloth/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.75, 0.56, 0.075)
                color3f inputs:diffuseColor.connect = </FeltSphere/Looks/Cloth/diffuseColor.outputs:rgb>
                float inputs:metallic = 0
                float3 inputs:normal.connect = </FeltSphere/Looks/Cloth/normal.outputs:rgb>
                float inputs:roughness = 0.85
                float inputs:roughness.connect = </FeltSphere/Looks/Cloth/roughness.outputs:r>
                token outputs:surface
            }

            def Shader "UV"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "diffuseColor"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @textures/albedo.exr@
                token inputs:sourceColorSpace = "raw"
                float2 inputs:st.connect = </FeltSphere/Looks/Cloth/UV.outputs:result>
                float3 outputs:rgb
            }

            def Shader "roughness"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @textures/roughness.exr@
                token inputs:sourceColorSpace = "raw"
                float2 inputs:st.connect = </FeltSphere/Looks/Cloth/UV.outputs:result>
                float outputs:r
            }

            def Shader "normal"
            {
                uniform token info:id = "UsdUVTexture"
                float4 inputs:bias = (-1, -1, -1, 0)
                asset inputs:file = @textures/normal.exr@
                float4 inputs:scale = (2, 2, 2, 1)
                token inputs:sourceColorSpace = "raw"
                float2 inputs:st.connect = </FeltSphere/Looks/Cloth/UV.outputs:result>
                float3 outputs:rgb
            }
        }

        def Material "FeltFibres"
        {
            token outputs:surface.connect = </FeltSphere/Looks/FeltFibres/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.75, 0.56, 0.075)
                color3f inputs:diffuseColor.connect = </FeltSphere/Looks/FeltFibres/FibreColor.outputs:result>
                color3f inputs:emissiveColor = (0.01875, 0.014, 0.001875)
                float inputs:metallic = 0
                float inputs:roughness = 0.9
                token outputs:surface
            }

            def Shader "FibreColor"
            {
                uniform token info:id = "UsdPrimvarReader_float3"
                float3 inputs:fallback = (0.75, 0.56, 0.075)
                token inputs:varname = "displayColor"
                float3 outputs:result
            }
        }

        def Material "FeltCurlsFibres"
        {
            token outputs:surface.connect = </FeltSphere/Looks/FeltCurlsFibres/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.69, 0.5152, 0.069)
                color3f inputs:diffuseColor.connect = </FeltSphere/Looks/FeltCurlsFibres/FibreColor.outputs:result>
                color3f inputs:emissiveColor = (0.01725, 0.01288, 0.001725)
                float inputs:metallic = 0
                float inputs:roughness = 0.9
                token outputs:surface
            }

            def Shader "FibreColor"
            {
                uniform token info:id = "UsdPrimvarReader_float3"
                float3 inputs:fallback = (0.69, 0.5152, 0.069)
                token inputs:varname = "displayColor"
                float3 outputs:result
            }
        }

        def Material "FlyawaysFibres"
        {
            token outputs:surface.connect = </FeltSphere/Looks/FlyawaysFibres/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.75, 0.56, 0.075)
                color3f inputs:diffuseColor.connect = </FeltSphere/Looks/FlyawaysFibres/FibreColor.outputs:result>
                color3f inputs:emissiveColor = (0.01875, 0.014, 0.001875)
                float inputs:metallic = 0
                float inputs:roughness = 0.9
                token outputs:surface
            }

            def Shader "FibreColor"
            {
                uniform token info:id = "UsdPrimvarReader_float3"
                float3 inputs:fallback = (0.75, 0.56, 0.075)
                token inputs:varname = "displayColor"
                float3 outputs:result
            }
        }
    }

    def Xform "Groom"
    {
        def UsdGenDescription "Felt" (
            prepend apiSchemas = ["UsdGenLookAPI", "MaterialBindingAPI"]
        )
        {
            rel material:binding = </FeltSphere/Looks/FeltFibres>
            int usdGen:look:jitterSeed = 41
            color3f usdGen:look:rootColor = (0.75, 0.56, 0.075)
            color3f usdGen:look:tipColor = (0.765, 0.5712, 0.0765)
            float usdGen:look:valueJitter = 0.12
            custom rel usdGen:surface = </FeltSphere/Emitter>
            float usdGen:width:default = 0.00013

            def "Maps"
            {
                def UsdGenPtexMap "length"
                {
                    int usdGen:map:channelCount = 1
                    float2 usdGen:map:clamp = (0, 0)
                    asset usdGen:map:file = @textures/controls.ptx@
                    token usdGen:map:filter = "bilinear"
                    int usdGen:map:firstChannel = 8
                }

                def UsdGenPtexMap "curl"
                {
                    int usdGen:map:channelCount = 1
                    float2 usdGen:map:clamp = (0, 0)
                    asset usdGen:map:file = @textures/controls.ptx@
                    token usdGen:map:filter = "bilinear"
                    int usdGen:map:firstChannel = 2
                }

                def UsdGenPtexMap "regions"
                {
                    int usdGen:map:channelCount = 1
                    float2 usdGen:map:clamp = (0, 0)
                    asset usdGen:map:file = @textures/controls.ptx@
                    token usdGen:map:filter = "nearest"
                    int usdGen:map:firstChannel = 3
                }

                def UsdGenPtexMap "tightness"
                {
                    int usdGen:map:channelCount = 1
                    float2 usdGen:map:clamp = (0, 0)
                    asset usdGen:map:file = @textures/controls.ptx@
                    token usdGen:map:filter = "bilinear"
                    int usdGen:map:firstChannel = 4
                }

                def UsdGenPtexMap "width"
                {
                    int usdGen:map:channelCount = 1
                    float2 usdGen:map:clamp = (0, 0)
                    asset usdGen:map:file = @textures/controls.ptx@
                    token usdGen:map:filter = "bilinear"
                    int usdGen:map:firstChannel = 6
                }
            }

            def "Expressions"
            {
                def UsdGenExpression "length"
                {
                    custom rel input:map = </FeltSphere/Groom/Felt/Maps/length>
                    custom float outputs:result
                    string usdGen:expr:source = '1.35 * ptex("map")'
                }

                def UsdGenExpression "curl"
                {
                    custom rel input:map = </FeltSphere/Groom/Felt/Maps/curl>
                    custom float outputs:result
                    string usdGen:expr:source = '1.0 * ptex("map")'
                }

                def UsdGenExpression "regions"
                {
                    custom rel input:map = </FeltSphere/Groom/Felt/Maps/regions>
                    custom float outputs:result
                    string usdGen:expr:source = 'ptex("map")'
                }

                def UsdGenExpression "tightness"
                {
                    custom rel input:map = </FeltSphere/Groom/Felt/Maps/tightness>
                    custom float outputs:result
                    string usdGen:expr:source = '0.45 * ptex("map")'
                }

                def UsdGenExpression "width"
                {
                    custom rel input:map = </FeltSphere/Groom/Felt/Maps/width>
                    custom float outputs:result
                    string usdGen:expr:source = '0.00012 * ptex("map")'
                }
            }

            def Scope "Ops"
            {
                reorder nameChildren = ["width", "length", "microclump", "curl", "frizz", "grow", "scatter"]
                def UsdGenWidth "width"
                {
                    bool usdGen:replace = 1
                    float usdGen:width = 0.00013
                    float usdGen:width.connect = </FeltSphere/Groom/Felt/Expressions/width.outputs:result>
                    float2[] usdGen:width:knots = [(0, 0.75), (0.6, 1), (1, 0.08)]
                }

                def UsdGenLength "length"
                {
                    float usdGen:cullThreshold = 0.0001
                    token usdGen:length:mode = "set"
                    float2 usdGen:length:random = (0.65, 1.25)
                    float usdGen:length:value = 0.003
                    float usdGen:length:value.connect = </FeltSphere/Groom/Felt/Expressions/length.outputs:result>
                }

                def UsdGenClump "microclump"
                {
                    float usdGen:clump:amount = 0.7
                    float usdGen:clump:amount.connect = </FeltSphere/Groom/Felt/Expressions/tightness.outputs:result>
                    int usdGen:clump:levels = 1
                    float usdGen:clump:map = 0
                    float usdGen:clump:map.connect = </FeltSphere/Groom/Felt/Expressions/regions.outputs:result>
                    token usdGen:clump:method = "linearBlend"
                    float2[] usdGen:clump:profile:knots = [(0, 0), (0.25, 0.15), (0.7, 0.85), (1, 0.8)]
                    float usdGen:clump:size = 0.01
                    float usdGen:preserveLength = 0.5
                }

                def UsdGenCurl "curl"
                {
                    float usdGen:frequency = 240
                    float usdGen:phaseRandom = 1
                    float usdGen:radius = 0.0006
                    float usdGen:radius.connect = </FeltSphere/Groom/Felt/Expressions/curl.outputs:result>
                    int usdGen:seed = 41
                }

                def UsdGenNoise "frizz"
                {
                    float usdGen:noise:correlation = 0.5
                    float usdGen:noise:frequency = 1100
                    float usdGen:noise:magnitude = 0.0003
                    int usdGen:noise:octaves = 2
                    float usdGen:preserveLength = 1
                    int usdGen:seed = 44
                }

                def UsdGenGrow "grow"
                {
                    float usdGen:azimuth = 0
                    float usdGen:azimuthRandom = 1
                    token usdGen:direction = "surfaceNormal"
                    float usdGen:length = 0.0035
                    float usdGen:lift = 30
                    int usdGen:seed = 48
                    int usdGen:segments = 12
                }

                def UsdGenScatter "scatter"
                {
                    float usdGen:density = 1650000
                    int usdGen:seed = 41
                    int usdGen:subdivisionLevel = 3
                }
            }
        }

