    def Mesh "Sphere" (
        prepend apiSchemas = ["UsdGenRestAPI", "MaterialBindingAPI"]
    )
    {
        int[] cornerIndices = []
        float[] cornerSharpnesses = []
        int[] creaseIndices = []
        int[] creaseLengths = []
