@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# find_dependency() may include another package config generated by
# the package initialization macro. On CMake versions where PACKAGE_PREFIX_DIR
# is not scoped to that nested config, retain our install prefix for the paths
# below.
set(_noodles_package_prefix_dir "${PACKAGE_PREFIX_DIR}")

set(_noodles_gl_backend "@NOODLES_PACKAGE_GL_BACKEND@")
if(_noodles_gl_backend STREQUAL "OpenGL" OR
   _noodles_gl_backend STREQUAL "SystemGLEW" OR
   _noodles_gl_backend STREQUAL "BundledGLEW")
    find_dependency(OpenGL REQUIRED)
endif()
if(_noodles_gl_backend STREQUAL "SystemGLEW")
    find_dependency(GLEW REQUIRED)
endif()
if(@NOODLES_PACKAGE_WITH_USD@)
    find_dependency(pxr CONFIG)
endif()

set(PACKAGE_PREFIX_DIR "${_noodles_package_prefix_dir}")
unset(_noodles_package_prefix_dir)

include("${CMAKE_CURRENT_LIST_DIR}/noodlesTargets.cmake")

set_and_check(noodles_ASSET_DIR "@PACKAGE_NOODLES_INSTALL_ASSETDIR@")
set(NOODLES_ASSET_DIR "${noodles_ASSET_DIR}")
set_property(TARGET noodles::noodles PROPERTY NOODLES_ASSET_DIR "${noodles_ASSET_DIR}")

check_required_components(noodles)
