-- glslfx version 0.1

//
// tonicTube.glslfx   (plan/17 §4.4, plan/18 §2.4a; NOT part of the C5 freeze)
//
// The Storm (HdSt) surface shader for everything UsdGenTonicSceneIndex
// publishes under /__usdGenTonic: the per-level tube meshes and, through the
// overlay material, the center curves, section rings and CV dots.
//
// The look is the one the public Tonic stills show (WDAS technology page
// hero; Simmons/Whited EG 2014 Fig. 1 (c)(d)(e); Kaur/Simmons/Whited
// SIGGRAPH 2018 Figs. 1, 2, 4): opaque, smoothly shaded tube volumes, ONE
// saturated colour per clump, no wireframe and no level tint. So this shader
// reads a per-face `clumpColor` primvar and lights it; the level/region
// colouring that used to live here (levelColor1..3 + a tubeId hue shift)
// is gone, because the colour is now decided once, in C++, by
// TonicClumpColor — the same table the scalp region tint reads, which is
// what makes a region's patch on the head and the tube rooted in it match.
//
// Registration (UsdShade):
//   def Shader "UsdGenTonicTube" {
//       uniform token info:implementationSource = "sourceAsset"
//       uniform asset  info:glslfx:sourceAsset  = @tonicTube.glslfx@
//       ...
//       token outputs:surface
//   }
// Discovery is the usdGenShaders SdrDiscoveryPlugin over shaderDefs.usda,
// the way UsdGenValuePreview was registered. The `primvars` sdrMetadata
// there lists what this file reads, which is what makes HdSt bind them.
//
// DESIGN NOTES (all verified against OpenUSD v26.08):
//
//  1. surfaceShader() signature is fixed by Fragment.CommonTerminals:
//         vec4 surfaceShader(vec4 Peye, vec3 Neye, vec4 color, vec4 patchCoord)
//     (pxr/imaging/hdSt/shaders/terminals.glslfx:53-54, 91-95).
//
//  2. clumpColor / selected / xray arrive as PRIMVARS, not as material
//     parameters: one material serves every level and every selection
//     state, and a selection change dirties one primvar leaf instead of
//     rebinding materials. clumpColor and selected are uniform (per face),
//     xray is constant (per prim). All three are HD_HAS_-guarded with
//     neutral fallbacks, so the shader also compiles on a foreign mesh.
//
//  3. They are floats. The repo's glslfx attribute block only spells
//     float/vec2/vec3, and an HD_HAS_-guarded HdGet_ read has to match the
//     published type; the index publishes tubeId and hierarchyLevel as ints
//     precisely because nothing here reads them.
//
//  4. Lighting is a headlight Lambert plus a soft specular, not the old
//     facing-shade: the 2014/2018 tubes are clearly lit volumes. There is
//     no light loop — the tool must read the same in any lighting rig.
//
//  5. X-ray (plan/17 §5.4, see-through parents while editing children) is
//     alpha under the opaque materialTag, which resolves through
//     alpha-to-coverage — x-ray parents read as stippled ghosts rather
//     than as blended glass, and need no separate material or draw order.
//
//  6. `unlit` is the one material parameter: the overlay material sets it
//     so the center curves, rings and CV dots draw as flat displayColor
//     while the tube meshes stay shaded.
//

-- configuration
{
    "techniques": {
        "default": {
            "surfaceShader": {
                "source": [ "UsdGenTonicTube.Surface" ]
            }
        }
    },

    "parameters": {
        "selectedColor": {
            "default": [1.0, 0.85, 0.35],
            "documentation": "Fresnel rim colour for selected tubes."
        },
        "rimGain": {
            "default": 1.0,
            "documentation": "Rim strength multiplier."
        },
        "specGain": {
            "default": 0.25,
            "documentation": "Soft specular strength of the headlight."
        },
        "specPower": {
            "default": 24.0,
            "documentation": "Soft specular exponent."
        },
        "ambient": {
            "default": 0.28,
            "documentation": "Ambient floor, so a tube facing away is still readable."
        },
        "xrayOpacity": {
            "default": 0.25,
            "documentation": "Alpha under x-ray (alpha-to-coverage dither)."
        },
        "opacity": {
            "default": 1.0,
            "documentation": "Constant opacity multiplier."
        },
        "unlit": {
            "default": 0.0,
            "documentation": "1 = flat displayColor (the overlay material: center curves, rings, CV dots)."
        }
    },

    "metadata": {
        "materialTag": "defaultMaterialTag"
    }
}

--- --------------------------------------------------------------------------
-- glsl UsdGenTonicTube.Surface

vec4 surfaceShader(vec4 Peye, vec3 Neye, vec4 color, vec4 patchCoord)
{
    // The overlay: curves, rings and dots are identity, not surface. They
    // carry displayColor and nothing else, and must read at full strength
    // against a shaded tube behind them.
    if (HdGet_unlit() > 0.5) {
        return vec4(max(color.rgb, vec3(0.0)),
                    clamp(color.a * HdGet_opacity(), 0.0, 1.0));
    }

    vec3 albedo = vec3(0.6);
#ifdef HD_HAS_clumpColor
    albedo = HdGet_clumpColor();
#else
    albedo = color.rgb;
#endif
    float selected = 0.0;
#ifdef HD_HAS_selected
    selected = float(HdGet_selected());
#endif
    float xray = 0.0;
#ifdef HD_HAS_xray
    xray = float(HdGet_xray());
#endif

    vec3 N = normalize(Neye + vec3(1e-12));
    vec3 V = normalize(-Peye.xyz + vec3(1e-12));
    // Headlight: the light sits at the eye, so the tube is lit the same way
    // from every camera and the artist's read of the shape never depends on
    // the scene's lights.
    float NdotV = abs(dot(N, V));
    float diffuse = HdGet_ambient() + (1.0 - HdGet_ambient()) * NdotV;
    float spec = HdGet_specGain() * pow(NdotV, HdGet_specPower());

    // Selection: 1 = selected (rim + a lightness lift), 2 = hover (a
    // smaller lift, no rim) — the plan/18 §2.4a states.
    float isSelected = (selected > 0.5 && selected < 1.5) ? 1.0 : 0.0;
    float isHover = (selected > 1.5) ? 1.0 : 0.0;
    float lift = 0.15 * isSelected + 0.08 * isHover;
    albedo = mix(albedo, vec3(1.0), lift);

    float fres = pow(1.0 - NdotV, 3.0);
    vec3 rgb = albedo * diffuse + vec3(spec) +
               HdGet_selectedColor() * (fres * isSelected * HdGet_rimGain());

    float alpha = clamp(HdGet_opacity(), 0.0, 1.0);
    if (xray > 0.5) {
        alpha *= clamp(HdGet_xrayOpacity(), 0.0, 1.0);
    }
    return vec4(max(rgb, vec3(0.0)), alpha);
}
