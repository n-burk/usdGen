-- glslfx version 0.1

//
// usdGenHairPreviewPrimvar.glslfx   (variant B — hairTangent primvar; M1 keeps it, PW-2/S-8 default is variant A)
//
// A Storm (HdSt) surface shader for hair/fur on basisCurves prims.
// Kajiya-Kay diffuse + two Marschner-lite specular lobes (R and TRT), plus a
// cheap TT-style transmission term, root->tip colour ramp and optional
// per-curve colour / colour map.
//
// Registration (UsdShade):
//   def Shader "HairPreview" {
//       uniform token info:implementationSource = "sourceAsset"
//       uniform asset  info:glslfx:sourceAsset  = @usdGenHairPreview.glslfx@
//       color3f inputs:rootColor = (0.035, 0.018, 0.008)
//       ...
//       token outputs:surface
//   }
// Discovery:  UsdShadeShaderDefUtils::GetDiscoveryResults
//             (pxr/usd/usdShade/shaderDefUtils.cpp:46-119) takes the middle
//             token of info:<type>:sourceAsset as the Sdr source type.
// Parsing:    SdrGlslfxParserPlugin (discoveryType "glslfx",
//             pxr/usdImaging/plugin/sdrGlslfx/parserPlugin.cpp:29-31,174-295).
// Loading:    HdStMaterialNetwork looks the terminal up with
//             GetShaderNodeByIdentifierAndType(id, "glslfx")
//             (pxr/imaging/hdSt/materialNetwork.cpp:120-164).
//
// DESIGN CONSTRAINTS THIS FILE OBEYS (all verified against OpenUSD v26.08):
//
//  1. surfaceShader() signature is fixed by Fragment.CommonTerminals:
//         vec4 surfaceShader(vec4 Peye, vec3 Neye, vec4 color, vec4 patchCoord)
//     (pxr/imaging/hdSt/shaders/terminals.glslfx:53-54, 91-95).
//
//  2. On basisCurves, patchCoord is vec4(0, v, 0, 0) where v is the coordinate
//     ACROSS the strand width, not along the strand
//     (basisCurves.glslfx:1293 for the patch repr, :1244 for wire).
//     Root->tip therefore CANNOT come from patchCoord; it must come from a
//     primvar. We declare "hairT" (vertex float, 0 at root, 1 at tip) below.
//
//  3. We deliberately do NOT read the fragment in-block `inData.Neye` (which
//     holds the strand tangent for the HALFTUBE / ROUND / implicit-ribbon
//     styles, basisCurves.glslfx:866,889,1272-1274). It is in scope on HdStGL
//     (codeGen emits the geometric shader's stage-in block into `resDecl`,
//     which precedes the material source in the fragment translation unit:
//     pxr/imaging/hdSt/codeGen.cpp:1122-1155 emits "in <Block> {...} inData;",
//     :2895-2915 orders resDecl before _genAccessors + _genFS, and the
//     material's FS source is appended to _genFS at :2536-2537 BEFORE the
//     geometric shader's own FS source at :2577) -- BUT the WIRE repr's block
//     has only Peye (basisCurves.glslfx:1212-1218), and a mesh has no such
//     block at all, so referencing inData.Neye makes the material fail to
//     compile at refineLevel 0, when `widths` is missing, or on any mesh.
//     Instead the tangent comes from, in order of preference:
//        a) the "hairTangent" primvar (vertex vec3), if authored;
//        b) reconstruction from screen-space derivatives of Peye and
//           patchCoord.y (works for RIBBON/HALFTUBE because v varies across
//           the strip);
//        c) a view-aligned fallback (wire repr, where v is constant 0.5).
//
//  4. Array-valued glslfx parameters (float[2], float[4]) are NOT used.
//     SdrGlslfxParserPlugin maps them to SdrPropertyTypes->Float with
//     arraySize 2/4 (parserPlugin.cpp:100-147), but HdSt_ResourceBinder
//     types the fallback accessor with HdStGLConversions::GetGLSLTypename(),
//     which has no array notion (resourceBinder.cpp:686-699), and OpenUSD's
//     own sample shader comments out the HdGet_ call for such a parameter
//     (testUsdImagingGLSdr/surface_texture.glslfx:59). Use scalars/colors.
//
//  5. materialTag: this file declares "defaultMaterialTag", so hair is drawn
//     in the opaque pass with alpha-to-coverage enabled
//     (HdxTaskController::_SetBlendStateForMaterialTag,
//     pxr/imaging/hdx/taskController.cpp:392-398), which is what makes thin
//     sub-pixel strands antialias instead of popping. Note that a bound
//     material's tag OVERRIDES the displayOpacity->masked promotion in
//     HdSt (_ComputeMaterialTag, pxr/imaging/hdSt/primUtils.cpp:292-327):
//     with this material bound, a displayOpacity primvar alone does NOT make
//     hair translucent. Ship a second copy of this file whose metadata says
//     "translucent" when you want true OIT hair (that routes the prims to
//     HdxOitRenderTask, taskController.cpp:331-336).
//

#import ./usdGenFurScattering.glslfx

-- configuration
{
    "techniques": {
        "default": {
            "surfaceShader": {
                "source": [ "UsdGenHair.Structures",
                            "UsdGenHair.Tangent",
                            "UsdGenHair.Lobes",
                            "UsdGenHair.Surface" ]
            }
        }
    },

    "parameters": {
        "rootColor": {
            "default": [0.035, 0.018, 0.008],
            "documentation": "Linear albedo at the root of the strand. Used only when the prim carries no displayColor primvar; on a usdGen tile the baked per-curve displayColor takes this slot."
        },
        "tipColor": {
            "default": [0.210, 0.115, 0.045],
            "documentation": "Linear albedo at the tip of the strand."
        },
        "colorRamp": {
            "default": 1.0,
            "documentation": "Exponent applied to hairT before the root/tip lerp. >1 keeps the root colour longer."
        },
        "diffuseGain": {
            "default": 0.55,
            "documentation": "Reflectance of the Kajiya-Kay diffuse (sin(T,L)) lobe, as a fraction of the strand albedo. Also scales the dome-light irradiance, so the coat responds to a key light and an environment by the same amount."
        },
        "diffuseWrap": {
            "default": 0.35,
            "documentation": "0 = hard terminator, 1 = fully wrapped diffuse. Fakes multiple scattering in dense fur."
        },
        "specular1Gain": {
            "default": 0.09,
            "documentation": "PEAK reflectance of the primary (R) highlight, white/uncoloured. The lobe is a unit-peak Gaussian, so this value is the highlight's brightness against the light colour; keep the two specular gains plus diffuseGain at or below 1."
        },
        "specular1Color": {
            "default": [1.0, 1.0, 1.0],
            "documentation": "Tint of the primary (R) highlight."
        },
        "specular1Width": {
            "default": 0.120,
            "documentation": "Angular width of the R lobe, in longitudinal-angle units. Smaller = tighter."
        },
        "specular1Shift": {
            "default": -0.045,
            "documentation": "Longitudinal shift of the R lobe towards the root (radians-ish). Marschner alpha_R."
        },
        "specular2Gain": {
            "default": 0.05,
            "documentation": "PEAK reflectance of the secondary (TRT) highlight, tinted by the strand albedo. Same unit-peak convention as specular1Gain."
        },
        "specular2Color": {
            "default": [1.0, 1.0, 1.0],
            "documentation": "Extra tint on the TRT lobe. Multiplied by the strand albedo."
        },
        "specular2Width": {
            "default": 0.300,
            "documentation": "Angular width of the TRT lobe. Should be wider than specular1Width."
        },
        "specular2Shift": {
            "default": 0.090,
            "documentation": "Longitudinal shift of the TRT lobe towards the tip. Marschner alpha_TRT."
        },
        "transmissionGain": {
            "default": 0.25,
            "documentation": "Weight of the cheap forward-scattering (TT) rim term."
        },
        "transmissionColor": {
            "default": [1.0, 0.62, 0.38],
            "documentation": "Tint of the forward-scattering term."
        },
        "opacity": {
            "default": 1.0,
            "documentation": "Constant opacity multiplier. Multiplied by displayOpacity if that primvar exists."
        },
        "widthFalloff": {
            "default": 0.0,
            "documentation": "0 = flat across the strip. 1 = alpha falls to 0 at the silhouette of the strand (soft round edge, needs alpha-to-coverage or the translucent tag)."
        },
        "randomHue": {
            "default": 0.0,
            "documentation": "Per-curve hue jitter amount, driven by the hairId primvar."
        },
        "randomValue": {
            "default": 0.0,
            "documentation": "Per-curve brightness jitter amount, driven by the hairId primvar."
        },
        "selfOcclusion": {
            "default": 0.5,
            "documentation": "Optical-depth multiplier for geometry-derived fur self-shadowing: 0 disables, 0.5 uses the baked density, 1 doubles extinction. furTauP/furTauN hold world-axis depths; optional furTipTauP/furTipTauN enable instanced root/tip interpolation. Without density primvars, use the legacy hairT canopy approximation."
        }
    },

    "textures": {
        "rootColorMap": {
            "default": [1.0, 1.0, 1.0],
            "documentation": "Multiplied into the strand albedo. Wire this to a UsdUVTexture whose st input is a UsdPrimvarReader_float2 reading the per-curve root UV primvar. If left unconnected the fallback (white) is used."
        }
    },

    "attributes": {
        "furTauP": {"type": "vec3", "default": [0.0, 0.0, 0.0]},
        "furTauN": {"type": "vec3", "default": [0.0, 0.0, 0.0]},
        "furTipTauP": {"type": "vec3", "default": [0.0, 0.0, 0.0]},
        "furTipTauN": {"type": "vec3", "default": [0.0, 0.0, 0.0]},
        "hairT": {
            "type": "float",
            "default": 0.0,
            "documentation": "Root(0) to tip(1) parameter. Author as a VERTEX float primvar on the basisCurves prim; it is basis-blended in the TES (codeGen.cpp:5981-5985)."
        },
        "hairTangent": {
            "type": "vec3",
            "default": [0.0, 0.0, 1.0],
            "documentation": "Optional OBJECT-space strand tangent, VERTEX interpolation. When present it is preferred over derivative reconstruction."
        },
        "hairId": {
            "type": "float",
            "default": 0.0,
            "documentation": "Optional per-curve random seed in [0,1). Author as a UNIFORM float primvar (one per curve); Storm reads it via GetElementID() (codeGen.cpp:5564-5573)."
        },
        "st": {
            "type": "vec2",
            "default": [0.0, 0.0],
            "documentation": "Per-curve root UV on the emitting surface. UNIFORM (one per curve) is cheapest; vertex/varying also work."
        }
    },

    "metadata": {
        "materialTag": "defaultMaterialTag"
    }
}

--- --------------------------------------------------------------------------
-- glsl UsdGenHair.Structures

// We deliberately do NOT "#import $TOOLS/hdSt/shaders/surfaceHelpers.glslfx"
// (which is how previewSurface.glslfx gets PI); the import is resolved through
// HioGlslfx's plugin resource registry (pxr/imaging/hio/glslfx.cpp:120-149,
// 157-160) and adds a failure mode for no benefit here.
// Nothing below needs a PI constant, so nothing is imported and nothing can
// collide with hdSt's `#define PI` (surfaceHelpers.glslfx:15) or
// domeLight.glslfx's `const float PI`.
//
// LightSource, GetLightCount(), GetLightSource(i), lightDistanceAttenuation(),
// lightSpotAttenuation() and shadowing() come from
// pxr/imaging/glf/shaders/simpleLighting.glslfx, which HdSt emits into the
// fragment translation unit BEFORE the material source: the lighting shader
// and the render-pass shader are elements 0 and 1 of the shader vector
// (HdStRenderPassState::GetShaders, pxr/imaging/hdSt/renderPassState.cpp:543-550)
// and the material network shader is appended last
// (HdSt_DrawBatch::GetComposedShaders, pxr/imaging/hdSt/drawBatch.cpp:446);
// codeGen concatenates them in that order into _genFS (codeGen.cpp:2513-2538).

struct HairSample
{
    vec3  albedo;      // linear strand colour after ramp / map / jitter
    vec3  T;           // eye-space strand tangent, normalized
    vec3  N;           // eye-space shading normal (the tube/ribbon normal)
    float alpha;
};

#ifndef HD_HAS_hairT
#define UsdGenHair_GetHairT() (0.5)
#else
#define UsdGenHair_GetHairT() (clamp(HdGet_hairT(), 0.0, 1.0))
#endif

#ifndef HD_HAS_hairId
#define UsdGenHair_GetHairId() (0.0)
#else
#define UsdGenHair_GetHairId() (HdGet_hairId())
#endif

--- --------------------------------------------------------------------------
-- glsl UsdGenHair.Tangent

// Eye-space strand tangent.
//
// Priority 1: an authored "hairTangent" primvar (object space -> eye space via
//             the standard Storm accessors). GetWorldToViewMatrix() and
//             HdGet_transform() are emitted by codeGen for every draw item.
// Priority 2: reconstruct from screen-space derivatives. For the RIBBON and
//             HALFTUBE draw styles patchCoord.y == v varies ACROSS the strip
//             (basisCurves.glslfx:1293, TES sets v = gl_TessCoord.x at :746),
//             so the in-surface direction of increasing v is
//                 dPdv = (dPdx*dvdx + dPdy*dvdy) / (dvdx^2 + dvdy^2)
//             and the tangent is perpendicular to it inside the strip plane.
// Priority 3: WIRE repr (patchCoord is the constant vec4(0,0.5,0,0),
//             basisCurves.glslfx:1244) -> derivatives of v vanish; fall back
//             to the longer of the two screen derivatives of P, which for a
//             1px-wide line is the along-strand direction.

vec3 UsdGenHairTangent(vec3 P, vec3 N, float v)
{
#ifdef HD_HAS_hairT
    // The gradient of root-to-tip coordinates follows transformed instances.
    // Unlike an object-space tangent, this is valid on rotated prototypes.
    float tx = dFdx(HdGet_hairT()), ty = dFdy(HdGet_hairT());
    vec3 dt = dFdx(P)*tx + dFdy(P)*ty;
    if (dot(dt,dt) > 1e-12) return normalize(dt);
#endif
#ifdef HD_HAS_hairTangent
    // HdGet_transform() is a CONSTANT primvar accessor; codeGen emits constant
    // primvar accessors into _genAccessors (codeGen.cpp:5243-5300, written to
    // _genAccessors at the end of _GenerateConstantPrimvar), and _genAccessors
    // is prepended to EVERY stage including the fragment stage
    // (codeGen.cpp:2914-2916). GetWorldToViewMatrix() likewise.
    // NOTE: ApplyInstanceTransform() is NOT available in the fragment stage
    // (the Instancing.Transform mixin is only added to VS/TES/PTVS for curves,
    // basisCurvesShaderKey.cpp:202,284,319,367,395,435), so for point-instanced
    // curve prototypes with a rotating instance transform the primvar tangent
    // is wrong; fall back to the derivative path in that case by not authoring
    // hairTangent. MAT4 is #defined by codeGen (codeGen.cpp:2085-2088).
    vec3 To = HdGet_hairTangent().xyz;
    if (dot(To, To) > 1e-12) {
        vec4 Te = vec4(GetWorldToViewMatrix() * HdGet_transform() *
                       vec4(To, 0.0));
        if (dot(Te.xyz, Te.xyz) > 1e-12) {
            return normalize(Te.xyz);
        }
    }
#endif

    vec3 dPdx = dFdx(P);
    vec3 dPdy = dFdy(P);
    float dvdx = dFdx(v);
    float dvdy = dFdy(v);
    float dv2 = dvdx * dvdx + dvdy * dvdy;

    if (dv2 > 1e-12) {
        vec3 dPdv = (dPdx * dvdx + dPdy * dvdy) / dv2;
        vec3 t = cross(N, dPdv);
        if (dot(t, t) > 1e-12) {
            return normalize(t);
        }
    }

    // Wire / degenerate fallback: the longer screen derivative of P runs along
    // the rasterized line.
    vec3 t = (dot(dPdx, dPdx) >= dot(dPdy, dPdy)) ? dPdx : dPdy;
    if (dot(t, t) > 1e-12) {
        return normalize(t);
    }
    // Last resort: any direction perpendicular to N.
    vec3 up = (abs(N.z) > 0.99) ? vec3(1.0, 0.0, 0.0) : vec3(0.0, 0.0, 1.0);
    return normalize(cross(N, up));
}
