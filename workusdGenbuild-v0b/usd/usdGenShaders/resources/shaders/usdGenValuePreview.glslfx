-- glslfx version 0.1

//
// usdGenValuePreview.glslfx
//
// The Storm surface shader of the usdGen value preview (usdGen:preview:* on a
// UsdGenDescription). The engine bakes the previewed value into the tiles'
// displayColor through a colour map; this shader shows that colour and
// nothing else, so no root/tip ramp, jitter or specular lobe hides it.
//
// UsdGenGroomSceneIndex synthesizes the material
// (<description>/__usdGenRender/material_preview and material_preview_flat)
// and binds it by identifier (UsdGenValuePreview, see shaderDefs.usda).
//
// Unlike usdGenHairPreview.glslfx this file reads no inData member, so it
// compiles against every basisCurves repr; below refineLevel 1 the groom scene
// index still drops the binding and Storm draws the same displayColor unlit.
//
// `shading` 0 returns displayColor exactly, so a value can be read off the
// screen. 1 darkens a strand where it turns away from the camera (ROUND
// normals from refineLevel 2), which keeps the groom's shape readable.
//

-- configuration
{
    "techniques": {
        "default": {
            "surfaceShader": {
                "source": [ "UsdGenValuePreview.Surface" ]
            }
        }
    },

    "parameters": {
        "shading": {
            "default": 1.0,
            "documentation": "0 = the previewed colour exactly (flat). 1 = darkened where the strand turns away from the camera (lit)."
        },
        "fallbackColor": {
            "default": [0.02, 0.02, 0.02],
            "documentation": "Shown when the prim carries no displayColor primvar."
        }
    },

    "metadata": {
        "materialTag": "defaultMaterialTag"
    }
}

--- --------------------------------------------------------------------------
-- glsl UsdGenValuePreview.Surface

vec4 surfaceShader(vec4 Peye, vec3 Neye, vec4 color, vec4 patchCoord)
{
    vec3 albedo = HdGet_fallbackColor().rgb;
#ifdef HD_HAS_displayColor
    albedo = color.rgb;
#endif
    float facing = 1.0;
    if (dot(Neye, Neye) > 1e-12) {
        facing = abs(normalize(Neye).z);
    }
    float shade = mix(1.0, 0.35 + 0.65 * facing, clamp(HdGet_shading(), 0.0, 1.0));
    return vec4(max(albedo * shade, vec3(0.0)), 1.0);
}
