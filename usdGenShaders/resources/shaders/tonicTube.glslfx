-- glslfx version 0.1

//
// tonicTube.glslfx   (plan/17 §4.4, plan/18 §2.4a; NOT part of the C5 freeze)
//
// The Storm (HdSt) surface shader for everything UsdGenTonicSceneIndex
// publishes under /__usdGenTonic: the per-level tube meshes and, through the
// overlay material, the center curves, section rings and CV dots.
//
// The look is the one the public Tonic stills show (WDAS technology page
// hero; Simmons/Whited EG 2014 Fig. 1 (c)(d)(e); Kaur/Simmons/Whited
// SIGGRAPH 2018 Figs. 1, 2, 4): opaque, smoothly shaded tube volumes, ONE
// saturated colour per clump, no wireframe and no level tint. So this shader
// reads a per-face `clumpColor` primvar and lights it; the level/region
// colouring that used to live here (levelColor1..3 + a tubeId hue shift)
// is gone, because the colour is now decided once, in C++, by
// TonicClumpColor — the same table the scalp region tint reads, which is
// what makes a region's patch on the head and the tube rooted in it match.
//
// Registration (UsdShade):
//   def Shader "UsdGenTonicTube" {
//       uniform token info:implementationSource = "sourceAsset"
//       uniform asset  info:glslfx:sourceAsset  = @tonicTube.glslfx@
//       ...
//       token outputs:surface
//   }
// Discovery is the usdGenShaders SdrDiscoveryPlugin over shaderDefs.usda,
// the way UsdGenValuePreview was registered. The `primvars` sdrMetadata
// there lists what this file reads, which is what makes HdSt bind them.
//
// DESIGN NOTES (all verified against OpenUSD v26.08):
//
//  1. surfaceShader() signature is fixed by Fragment.CommonTerminals:
//         vec4 surfaceShader(vec4 Peye, vec3 Neye, vec4 color, vec4 patchCoord)
//     (pxr/imaging/hdSt/shaders/terminals.glslfx:53-54, 91-95).
//
//  2. clumpColor / selected / xray arrive as PRIMVARS, not as material
//     parameters: one material serves every level and every selection
//     state, and a selection change dirties one primvar leaf instead of
//     rebinding materials. clumpColor and selected are uniform (per face),
//     xray is constant (per prim). All three are HD_HAS_-guarded with
//     neutral fallbacks, so the shader also compiles on a foreign mesh.
//
//  3. They are floats. The repo's glslfx attribute block only spells
//     float/vec2/vec3, and an HD_HAS_-guarded HdGet_ read has to match the
//     published type; the index publishes tubeId and hierarchyLevel as ints
//     precisely because nothing here reads them.
//
//  4. Lighting is a fixed two-light rig in EYE space — a three-quarter key
//     above and left of the camera, a weaker fill below and right — plus an
//     ambient floor and a Blinn specular on the key. There is no light loop:
//     the tool must read the same in any lighting rig, which is why the rig
//     travels with the camera.
//     It is deliberately NOT a headlight (V0..V7 shaded with `abs(dot(N,V))`
//     alone). A headlight on a cylinder is symmetric about the screen centre
//     and peaks where the surface faces the eye, so a tube reads as a flat
//     disc of colour with a dark halo instead of a lit volume, and a tight
//     specular on the same axis never fires at all on an off-axis surface
//     (the 2026-09-19 workspace shot measured a peak N·V of 0.861 on a
//     vertical tube, which pow(·, 24) turns into 2.8 % of the gain). An
//     off-axis key puts the bright band off-centre, keeps a terminator on
//     the far side, and lets the highlight land — which is what the 2014 and
//     2018 stills show.
//
//  5. X-ray (plan/17 §5.4, see-through parents while editing children) is
//     the `xray` primvar, read as the ABSOLUTE alpha the level draws with
//     (0 = opaque). It is a primvar and not a material parameter because
//     plan/18 §2.4a puts the focused level at 25 % and the levels behind
//     it at 10 % in the same frame.
//
//     This file authors NO `materialTag` metadata, deliberately. HdSt
//     takes a hardcoded tag as the strongest opinion and falls back to the
//     terminal's authored `opacity` (hdSt/materialNetwork.cpp
//     _GetMaterialTag), so the scene index can bind the same shader twice:
//     once with opacity 1 for the opaque pass, once with opacity < 1 so
//     Storm draws the x-rayed levels through HdxOitRenderTask. That pass
//     writes no depth, which is the whole reason the center curves, CV
//     dots and guides INSIDE a ghosted tube are visible at all — Storm
//     has no per-prim "draw on top" that usdview's task controller
//     actually renders (see the comment on _kXrayMaterialOpacity in
//     tonicSceneIndex.cpp). Through V8 the tag was hardcoded opaque and
//     x-ray was alpha-to-coverage stipple, which dithered the ghost and
//     still wrote depth at every covered sample.
//
//  6. `unlit` is the one material parameter: the overlay material sets it
//     so the center curves, rings and CV dots draw as flat displayColor
//     while the tube meshes stay shaded.
//

-- configuration
{
    "techniques": {
        "default": {
            "surfaceShader": {
                "source": [ "UsdGenTonicTube.Surface" ]
            }
        }
    },

    "parameters": {
        "selectedColor": {
            "default": [1.0, 0.85, 0.35],
            "documentation": "Fresnel rim colour for selected tubes."
        },
        "rimGain": {
            "default": 1.0,
            "documentation": "Rim strength multiplier."
        },
        "specGain": {
            "default": 0.25,
            "documentation": "Soft specular strength of the key light."
        },
        "specPower": {
            "default": 8.0,
            "documentation": "Soft specular exponent (Blinn, half-vector against the key). Low on purpose: a tube seen from a three-quarter camera never turns a normal squarely at the half-vector -- the 2026-09-19 workspace shot peaks at N.H = 0.78 -- so an exponent in the twenties leaves the lobe permanently dark."
        },
        "ambient": {
            "default": 0.14,
            "documentation": "Ambient floor, so a tube facing away is still readable."
        },
        "keyGain": {
            "default": 0.80,
            "documentation": "Diffuse weight of the eye-space three-quarter key light."
        },
        "fillGain": {
            "default": 0.22,
            "documentation": "Diffuse weight of the opposing fill, which keeps the shadow side coloured rather than black."
        },
        "opacity": {
            "default": 1.0,
            "documentation": "The material's own alpha, and — because HdSt reads an authored terminal opacity below 1 as the translucent material tag — what decides whether the bound prims are drawn in the opaque pass or in Storm's OIT pass. The index binds 1.0 for opaque levels and 0.25 for x-rayed ones; the alpha actually drawn comes from the per-level `xray` primvar."
        },
        "unlit": {
            "default": 0.0,
            "documentation": "1 = flat displayColor (the overlay material: center curves, rings, CV dots)."
        }
    }
}

--- --------------------------------------------------------------------------
-- glsl UsdGenTonicTube.Surface

vec4 surfaceShader(vec4 Peye, vec3 Neye, vec4 color, vec4 patchCoord)
{
    // The overlay: curves, rings and dots are identity, not surface. They
    // carry displayColor and nothing else, and must read at full strength
    // against a shaded tube behind them.
    if (HdGet_unlit() > 0.5) {
        return vec4(max(color.rgb, vec3(0.0)),
                    clamp(color.a * HdGet_opacity(), 0.0, 1.0));
    }

    vec3 albedo = vec3(0.6);
#ifdef HD_HAS_clumpColor
    albedo = HdGet_clumpColor();
#else
    albedo = color.rgb;
#endif
    float selected = 0.0;
#ifdef HD_HAS_selected
    selected = float(HdGet_selected());
#endif
    // The absolute alpha this level draws with; 0 means "not x-ray" and
    // the material's own opacity stands.
    float xray = 0.0;
#ifdef HD_HAS_xray
    xray = clamp(float(HdGet_xray()), 0.0, 1.0);
#endif

    vec3 N = normalize(Neye + vec3(1e-12));
    vec3 V = normalize(-Peye.xyz + vec3(1e-12));
    // Face the normal at the eye first. The tube meshes are double-sided
    // and a locked import can arrive wound either way; flipping here is
    // what lets the rig below use a real dot(N, L) instead of the
    // orientation-proof abs(dot(N, V)) the headlight needed.
    vec3 Nf = (dot(N, V) < 0.0) ? -N : N;
    // The rig, in eye space: it travels with the camera, so the artist's
    // read of the shape never depends on the scene's lights.
    // Mostly SIDEWAYS, not mostly forward. A tube is a cylinder, so its
    // normals sweep across the screen horizontally and only the key's
    // horizontal component separates one side from the other: a key that
    // leans towards the eye (say 0.8 of z against 0.4 of x) moves the
    // bright band by about 25 degrees, which on an eight-sided tube is
    // less than one facet and reads as the headlight it replaced.
    const vec3 kKey = normalize(vec3(-0.80, 0.40, 0.62));
    const vec3 kFill = normalize(vec3(0.75, -0.25, 0.55));
    float NdotL = max(dot(Nf, kKey), 0.0);
    float NdotF = max(dot(Nf, kFill), 0.0);
    float diffuse = min(HdGet_ambient() + HdGet_keyGain() * NdotL +
                            HdGet_fillGain() * NdotF,
                        1.0);
    vec3 H = normalize(kKey + V);
    float spec = HdGet_specGain() *
                 pow(max(dot(Nf, H), 0.0), HdGet_specPower());
    // The Fresnel the selection rim rides on is a view term, not a light
    // term, so it keeps using the eye-facing normal.
    float NdotV = abs(dot(Nf, V));

    // Selection: 1 = selected (rim + a lightness lift), 2 = hover (a
    // smaller lift, no rim) — the plan/18 §2.4a states.
    float isSelected = (selected > 0.5 && selected < 1.5) ? 1.0 : 0.0;
    float isHover = (selected > 1.5) ? 1.0 : 0.0;
    float lift = 0.15 * isSelected + 0.08 * isHover;
    albedo = mix(albedo, vec3(1.0), lift);

    float fres = pow(1.0 - NdotV, 3.0);
    vec3 rgb = albedo * diffuse + vec3(spec) +
               HdGet_selectedColor() * (fres * isSelected * HdGet_rimGain());

    float alpha = (xray > 0.0) ? xray : clamp(HdGet_opacity(), 0.0, 1.0);
    // The OIT pass expects pre-multiplied alpha, and the opaque pass
    // ignores it, so one spelling serves both.
    return vec4(max(rgb, vec3(0.0)) * alpha, alpha);
}
