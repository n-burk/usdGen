    string usdGen:label = ""
    uniform token usdGen:map:channel = "r" (
        allowedTokens = ["r", "g", "b", "a", "rgb", "luminance"]
    )
    float2 usdGen:map:clamp = (0, 1) (
        customData = {
            dictionary usdGen = {
                string evaluation = "groom"
            }
        }
    )
    float usdGen:map:default = 0 (
        customData = {
            dictionary usdGen = {
                string evaluation = "groom"
            }
        }
    )
    uniform token usdGen:map:domain = "root" (
        allowedTokens = ["root", "cv"]
    )
    float usdGen:map:offset = 0 (
        customData = {
            dictionary usdGen = {
                string evaluation = "primitive"
            }
        }
    )
    float usdGen:map:scale = 1 (
        customData = {
            dictionary usdGen = {
                string evaluation = "primitive"
            }
        }
    )
}

class UsdGenImageMap "UsdGenImageMap"
{
    string usdGen:label = ""
    uniform token usdGen:map:channel = "r" (
        allowedTokens = ["r", "g", "b", "a", "rgb", "luminance"]
    )
    float2 usdGen:map:clamp = (0, 1)
    token usdGen:map:colorSpace = "raw" (
        allowedTokens = ["auto", "raw", "sRGB"]
    )
    float usdGen:map:default = 0
    uniform token usdGen:map:domain = "root" (
        allowedTokens = ["root", "cv"]
    )
    asset usdGen:map:file
    token usdGen:map:filter = "bilinear" (
        allowedTokens = ["nearest", "bilinear"]
    )
    float usdGen:map:offset = 0
    float usdGen:map:scale = 1
    token usdGen:map:uvSet = "st"
    token usdGen:map:wrap = "clamp" (
        allowedTokens = ["clamp", "repeat", "mirror", "black"]
    )
}

class UsdGenPtexMap "UsdGenPtexMap"
{
    string usdGen:label = ""
    float usdGen:map:blur = 0 (
        customData = {
            dictionary usdGen = {
                string evaluation = "groom"
            }
        }
    )
    token usdGen:map:borderMode = "clamp" (
        allowedTokens = ["clamp", "black", "periodic"]
    )
    uniform token usdGen:map:channel = "r" (
        allowedTokens = ["r", "g", "b", "a", "rgb", "luminance"]
    )
    int usdGen:map:channelCount = 1 (
        customData = {
            dictionary usdGen = {
                string evaluation = "groom"
            }
        }
    )
    float2 usdGen:map:clamp = (0, 1)
    float usdGen:map:default = 0
    uniform token usdGen:map:domain = "root" (
        allowedTokens = ["root", "cv"]
    )
    asset usdGen:map:file
    token usdGen:map:filter = "bilinear" (
        allowedTokens = ["nearest", "bilinear", "box", "gaussian", "bicubic", "bspline", "catmullrom", "mitchell"]
    )
    int usdGen:map:firstChannel = 0 (
        customData = {
            dictionary usdGen = {
                string evaluation = "groom"
            }
        }
    )
    float usdGen:map:offset = 0
    float usdGen:map:scale = 1
}

class UsdGenExprMap "UsdGenExprMap"
{
    rel usdGen:expr:maps
    uniform token usdGen:expr:returnType = "float" (
        allowedTokens = ["float", "color"]
    )
    uniform int usdGen:expr:seed = 0 (
        customData = {
            dictionary usdGen = {
                string evaluation = "groom"
            }
        }
    )
    string usdGen:expr:source = ""
    string usdGen:label = ""
    uniform token usdGen:map:channel = "r" (
        allowedTokens = ["r", "g", "b", "a", "rgb", "luminance"]
    )
    float2 usdGen:map:clamp = (0, 1)
    float usdGen:map:default = 0
    uniform token usdGen:map:domain = "root" (
        allowedTokens = ["root", "cv"]
    )
    float usdGen:map:offset = 0
    float usdGen:map:scale = 1
}

class UsdGenPaintMap "UsdGenPaintMap"
{
    string usdGen:label = ""
    uniform token usdGen:map:channel = "r" (
        allowedTokens = ["r", "g", "b", "a", "rgb", "luminance"]
    )
    float2 usdGen:map:clamp = (0, 1)
    float usdGen:map:default = 0
    uniform token usdGen:map:domain = "root" (
        allowedTokens = ["root", "cv"]
    )
    float usdGen:map:offset = 0
    float usdGen:map:scale = 1
    asset usdGen:paint:bakedFile
    token usdGen:paint:interpolation = "faceVarying"
    token usdGen:paint:primvar = "usdGen:paint:density"
    int usdGen:paint:resolution = 256 (
        customData = {
            dictionary usdGen = {
                string evaluation = "groom"
            }
        }
    )
    token usdGen:paint:storage = "primvar" (
        allowedTokens = ["primvar", "file"]
    )
    rel usdGen:paint:surface
}

class UsdGenNoiseMap "UsdGenNoiseMap"
{
    string usdGen:label = ""
    uniform token usdGen:map:channel = "r" (
        allowedTokens = ["r", "g", "b", "a", "rgb", "luminance"]
    )
    float2 usdGen:map:clamp = (0, 1)
    float usdGen:map:default = 0
    uniform token usdGen:map:domain = "root" (
        allowedTokens = ["root", "cv"]
    )
    float usdGen:map:offset = 0
    float usdGen:map:scale = 1
    float usdGen:noise:frequency = 1 (
        customData = {
            dictionary usdGen = {
                string evaluation = "point"
            }
        }
    )
    float usdGen:noise:gain = 0.5 (
        customData = {
            dictionary usdGen = {
                string evaluation = "point"
            }
        }
    )
    float usdGen:noise:lacunarity = 2 (
        customData = {
            dictionary usdGen = {
                string evaluation = "point"
            }
        }
    )
    int usdGen:noise:octaves = 3 (
        customData = {
            dictionary usdGen = {
                string evaluation = "point"
            }
        }
    )
    uniform int usdGen:noise:seed = 0 (
        customData = {
            dictionary usdGen = {
                string evaluation = "point"
            }
        }
    )
    token usdGen:noise:space = "rest" (
        allowedTokens = ["rest", "deformed"]
    )
    token usdGen:noise:type = "fbm" (
        allowedTokens = ["perlin", "snoise", "fbm", "turbulence", "cellnoise", "voronoi"]
    )
}

class UsdGenCombineMap "UsdGenCombineMap"
{
    rel usdGen:combine:inputs
    token usdGen:combine:mode = "multiply" (
        allowedTokens = ["multiply", "add", "subtract", "max", "min", "average", "overlay"]
    )
    string usdGen:label = ""
    uniform token usdGen:map:channel = "r" (
        allowedTokens = ["r", "g", "b", "a", "rgb", "luminance"]
    )
    float2 usdGen:map:clamp = (0, 1)
    float usdGen:map:default = 0
    uniform token usdGen:map:domain = "root" (
        allowedTokens = ["root", "cv"]
    )
    float usdGen:map:offset = 0
    float usdGen:map:scale = 1
}

