<?xml version="1.0" encoding="UTF-8"?>
<!-- usdGenHair.mtlx — M1 minimal-legal MaterialX skeleton.
     The full four-node chain (ND_deon_hair_absorption_from_melanin ->
     ND_chiang_hair_roughness -> ND_chiang_hair_bsdf -> ND_surface, plus the
     ND_geompropvalue_vector3 / ND_transformvector_vector3 tangent bridge,
     07-look-maps-expressions.md §4.1) is authored by the shaders lane at M1.
     This skeleton keeps the surface terminal resolvable so the
     three-terminal Material in hairLook.usda can connect to it.
     Per L-1/PW-4 the glslfx terminal wins under Storm; this terminal serves
     a render-delegate context only. -->
<mtlx:shader id="usdGenHair" xmlns:mtlx="urn:mpeg:mpegX:metal:1.0">
  <mtlx:surface id="surface" outColor="mix.out">
    <mtlx:parameter id="rootColor" type="color" default="0.035 0.018 0.008"/>
    <mtlx:parameter id="tipColor" type="color" default="0.21 0.115 0.045"/>
    <mtlx:parameter id="mixFactor" type="float" default="0.5"/>
    <mtlx:node node="mtlx:mix" out="mix" in="rootColor" in2="tipColor" f="mixFactor"/>
  </mtlx:surface>
</mtlx:shader>
