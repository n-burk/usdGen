    float inputs:specular2Shift = 0.09
    float inputs:transmissionGain = 0.25
    color3f inputs:transmissionColor = (1, 0.62, 0.38)
    float inputs:opacity = 1
    float inputs:widthFalloff = 0
    float inputs:randomHue = 0
    float inputs:randomValue = 0
    float inputs:selfOcclusion = 0.5
    color3f inputs:rootColorMap = (1, 1, 1)
    token outputs:surface (
