#usda 1.0
(
    defaultPrim = "Groom"
)

def Scope "Groom"
{
    def UsdGenDescription "Description"
    {
        def Scope "Ops"
        {
            def UsdGenLength "Length"
            {
                rel usdGen:mask:source = </Groom/Mask>
                rel usdGen:length:source = </Groom/Mask>
            }
        }
    }

    def UsdGenImageMap "Mask"
    {
        asset usdGen:map:file = @./maps/mask.exr@
    }
}
