docs/prework/probes/*/__pycache__/
docs/prework/probes/*/*.so
docs/prework/probes/*/*.o

# Regenerable large PW-egl probe stages: the .usdc scenes and the generated
# pw4_*.usda are produced by make_pw_scenes.py / make_pw4_scenes.py (kept
# tracked, with the .txt results, .png evidence, .md docs). Re-generate instead
# of committing (sol X-7).
docs/prework/probes/PW-egl/scene_*.usdc
docs/prework/probes/PW-egl/pw4_*.usda
docs/prework/probes/m0-usdcat-extent/probe_usdcat_extent
# Probe binaries (extensionless ELF outputs; recompile from the .cpp beside them)
docs/prework/probes/PW-1/bench_knn
docs/prework/probes/PW-1/compile_probe
docs/prework/probes/PW-1/pw1_bench
docs/prework/probes/PW-1/pw1_bench_O1
docs/prework/probes/PW-1/pw1_bench_O3
docs/prework/probes/PW-1/pw1_compile
docs/prework/probes/PW-5/probe
docs/prework/probes/PW-6/probeReorder
docs/prework/probes/PW-6/probeFinalOrder
