#version 450
#extension GL_GOOGLE_include_directive : require
#include "../../libs/usdGen/usdGen/vulkan/shaders/float32Envelope.glsl"
layout(local_size_x=256) in;
layout(set=0,binding=0,std430) readonly buffer P { uint v[]; } inputBits;
layout(set=0,binding=2,std430) writeonly buffer R { uint v[]; } outputBits;
layout(push_constant) uniform C { uint curves; uint points; uint phase; float value;
    uint hasHairT; float minimum; uint method; uint rebuild; float randomLo;
    float randomHi; uint seedBits; uint hasStableIds; float resolvedEnvelope;
    uint zeroEnvelope; } c;
void main() {
    uint i=gl_GlobalInvocationID.x;
    if(c.phase==0u||i>=c.points) return;
    uint a=inputBits.v[3u*i],b=inputBits.v[3u*i+1u],e=inputBits.v[3u*i+2u];
    outputBits.v[3u*i]=addBits(a,b);
    outputBits.v[3u*i+1u]=multiplyBits(a,b);
    outputBits.v[3u*i+2u]=addBits(a,multiplyBits(addBits(b,a^0x80000000u),e));
}
